---
import { withBase } from '../lib/paths';

interface Props {
  /** Kleiner Bodoni-Kicker über der Überschrift */
  kicker: string;
  /** Seitenname als Überschrift */
  heading: string;
  /**
   * Marginalie ganz oben. Ohne Angabe steht dort die Wortmarke — auf den
   * Projektseiten ist "Arbeiten" die nützlichere Ortsangabe, weil der
   * Kunde schon im Kicker steht.
   */
  label?: string;
}

const { kicker, heading, label } = Astro.props;

// Seiten mit Slot-Inhalt bekommen ihren Einleitungstext statt des
// "Inhalt folgt" — der Hinweis erscheint nur, wo wirklich nichts steht.
const hatEinleitung = Astro.slots.has('default');
---

<section class="ph">
  <div class="container">
    <p class="label label--accent">{label ?? <span class="brand">Le Werk</span>}</p>

    <h1 class="ph__title">
      <span class="editorial editorial--kicker">{kicker}</span>{' '}
      <span class="headline headline--xl">{heading}</span>
    </h1>

    {hatEinleitung
      ? <div class="ph__intro"><slot /></div>
      : <p class="ph__note">Inhalt folgt.</p>}

    <div class="ph__actions">
      <a class="btn" href={withBase("/kontakt")}>
        Projekt anfragen <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost" href={withBase("/")}>Zurück zur Startseite</a>
    </div>
  </div>
</section>

<style>
  .ph {
    display: flex;
    align-items: center;
    min-height: 78vh;
    padding-block: clamp(9rem, 20vh, 13rem) var(--section-y);
  }

  .ph .label { margin-bottom: var(--space-3); }

  .ph__title { margin-bottom: var(--space-3); }
  .ph__title .headline { display: block; }

  .ph__note {
    font-size: var(--fs-lead);
    color: var(--ink-muted);
    margin-bottom: var(--space-4);
  }

  .ph__intro { max-width: 46rem; margin-bottom: var(--space-4); }
  .ph__intro :global(p) { color: var(--ink-muted); }
  .ph__intro :global(p + p) { margin-top: var(--space-2); }

  /* Erster Absatz als Lead — der Rest bleibt Fließtext */
  .ph__intro :global(p:first-child) {
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink);
  }

  .ph__intro :global(strong) { font-weight: 600; color: var(--ink); }

  .ph__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); }
</style>
