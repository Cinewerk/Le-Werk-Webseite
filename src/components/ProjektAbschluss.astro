---
import { withBase } from '../lib/paths';

interface Props {
  /** Bodoni-Auftakt der Überschrift */
  kicker?: string;
  /** Rest der Überschrift, in Versalien gesetzt */
  heading?: string;
}

const { kicker = 'Sowas', heading = 'für eure Marke?' } = Astro.props;
---

<section class="section section--dark abschluss" aria-labelledby="abschluss-titel">
  <div class="container abschluss__inner" data-reveal>
    <h2 class="headline headline--xl abschluss__titel" id="abschluss-titel">
      <span class="editorial editorial--kicker">{kicker}</span>{' '}
      {heading}
    </h2>
    <div class="abschluss__aktionen">
      <a class="btn btn--on-dark" href={withBase('/kontakt')}>
        Projekt anfragen <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost" href={withBase('/#arbeiten')}>Weitere Arbeiten</a>
    </div>
  </div>
</section>

<style>
  .abschluss__inner { text-align: center; }
  .abschluss__titel { margin-bottom: var(--space-4); }
  .abschluss__titel .editorial { display: block; }

  .abschluss__aktionen {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
</style>
