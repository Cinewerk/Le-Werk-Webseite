---
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** true, wenn die Seite mit einer dunklen Bühne startet (Header startet transparent/hell) */
  heroDark?: boolean;
}

const { title, description, heroDark = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

// Exakter Treffer: aria-current="page" darf pro Seite nur einmal vorkommen.
// Auf /services/foto ist "Foto" die aktuelle Seite, nicht zusätzlich "Services".
const isCurrent = (href: string) => path === href;

const services = [
  { href: '/services/foto', label: 'Foto' },
  { href: '/services/video', label: 'Video' },
  { href: '/services/konzept', label: 'Konzept' },
  { href: '/services/workshops', label: 'Workshops' },
];

const overlayNav = [
  { href: '/', label: 'Start' },
  { href: '/services', label: 'Services' },
  ...services,
  { href: '/kontakt', label: 'Kontakt' },
];

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Le Werk" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#006377" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Schriften liegen lokal unter /fonts — keine Anfrage an Google.
         Vorgeladen wird nur, was über der Falz sofort gebraucht wird. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/poppins-800-normal-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/poppins-400-normal-latin.woff2" />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <header class="header" id="site-header" data-over-dark={heroDark ? 'true' : 'false'}>
      <div class="container header__inner">
        <a class="logo" href="/" aria-label="Le Werk — zur Startseite">
          Le Werk
        </a>

        <div class="header__actions">
          <a class="btn header__cta" href="/kontakt">
            Projekt anfragen
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>

          <button
            class="burger"
            id="nav-toggle"
            type="button"
            aria-label="Menü öffnen"
            aria-expanded="false"
            aria-controls="nav-overlay"
          >
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <div class="overlay" id="nav-overlay" data-open="false" hidden>
      <div class="overlay__top">
        <a class="logo" href="/">Le Werk</a>
        <button class="overlay__close" id="nav-close" type="button" aria-label="Menü schließen">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M1 1 17 17M17 1 1 17" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <nav aria-label="Seitennavigation">
        <ul class="overlay__list">
          {overlayNav.map((item, i) => (
            <li class="overlay__item">
              <span class="overlay__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <a
                class="overlay__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="overlay__foot">
        <span>Le Werk — Visual Content Studio</span>
        <a class="link-underline" href="mailto:contact@lewerk.de">contact@lewerk.de</a>
      </div>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer__grid">
          <div class="footer__col">
            <h2>Navigation</h2>
            <ul>
              <li><a href="/">Start</a></li>
              <li><a href="/services">Services</a></li>
              <li><a href="/kontakt">Kontakt</a></li>
            </ul>
          </div>

          <div class="footer__col">
            <h2>Services</h2>
            <ul>
              {services.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
            </ul>
          </div>

          <div class="footer__col">
            <h2>Kontakt</h2>
            <ul>
              <li><a href="mailto:contact@lewerk.de">contact@lewerk.de</a></li>
              <li><a href="tel:+4917656774494">+49 176 5677 4494</a></li>
            </ul>
            <address class="footer__address">
              Anna-Schneider-Steig 2 | Rheinauhafen<br />
              50678 Cologne
            </address>
          </div>

          <div class="footer__col">
            <h2>Rechtliches</h2>
            <ul>
              <li><a href="/impressum">Impressum</a></li>
              <li><a href="/datenschutz">Datenschutz</a></li>
            </ul>
          </div>

          <div class="footer__col" aria-hidden="true">
            <p class="footer__brand">Le Werk</p>
          </div>
        </div>

        <div class="footer__legal">
          <span>
            © {year} Le Werk (by <a href="https://cinewerk.de/">Cinewerk GmbH</a>).
            Alle Rechte vorbehalten.
          </span>
          <span>Visual Content Studio</span>
        </div>
      </div>
    </footer>

    <script>
      // --- Header: fest, wird beim Scrollen zur soliden Fläche ---------------
      const header = document.getElementById('site-header');
      const onScroll = () => header?.classList.toggle('is-solid', window.scrollY > 40);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // --- Overlay-Navigation ------------------------------------------------
      const toggle = document.getElementById('nav-toggle');
      const overlay = document.getElementById('nav-overlay');
      const closeBtn = document.getElementById('nav-close');

      // Alles außerhalb des Overlays wird bei geöffnetem Menü inert —
      // sonst wandert der Tab-Fokus hinter die Ebene.
      const behind = [
        document.getElementById('site-header'),
        document.getElementById('main'),
        document.querySelector('.footer'),
      ];

      const setOverlay = (open: boolean) => {
        if (!overlay || !toggle) return;
        if (open) overlay.hidden = false;
        overlay.dataset.open = String(open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
        document.body.classList.toggle('is-locked', open);

        behind.forEach((el) => {
          if (!el) return;
          if (open) el.setAttribute('inert', '');
          else el.removeAttribute('inert');
        });

        if (open) {
          // Style-Recalc erzwingen, damit das Overlay sichtbar ist,
          // bevor der Fokus hineinwandert.
          void overlay.offsetHeight;
          closeBtn?.focus();
        } else {
          toggle.focus();
          window.setTimeout(() => {
            if (overlay.dataset.open === 'false') overlay.hidden = true;
          }, 420);
        }
      };

      toggle?.addEventListener('click', () => setOverlay(overlay?.dataset.open !== 'true'));
      closeBtn?.addEventListener('click', () => setOverlay(false));
      overlay?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOverlay(false)));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay?.dataset.open === 'true') setOverlay(false);
      });

      // --- Scroll-Reveal ------------------------------------------------------
      const reveals = document.querySelectorAll('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              const delay = Number(el.dataset.revealDelay ?? 0);
              window.setTimeout(() => el.classList.add('is-in'), delay);
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
