---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout
  title="Kontakt — Le Werk"
  description="Le Werk erreicht ihr unter contact@lewerk.de oder +49 176 5677 4494. Studio im Rheinauhafen, Anna-Schneider-Steig 2, 50678 Köln."
>
  <section class="contact">
    <div class="container contact__grid">
      <header class="contact__head">
        <p class="label label--accent">Kontakt</p>
        <h1 class="contact__title">
          <span class="editorial editorial--kicker">Erzählt uns</span>
          <span class="headline headline--xl">von eurem Projekt</span>
        </h1>
        <p class="lead contact__lead">
          Ein Anruf, zwanzig Minuten, danach wisst ihr, ob wir passen — und in
          welchem Rahmen sich euer Vorhaben bewegt. Schreibt uns gern vorab,
          worum es geht.
        </p>
      </header>

      <div class="contact__body">
        <div class="contact__direct">
          <a class="contact__big" href="mailto:contact@lewerk.de">
            contact@lewerk.de
            <span class="contact__arrow" aria-hidden="true">→</span>
          </a>
          <a class="contact__big" href="tel:+4917656774494">
            +49 176 5677 4494
            <span class="contact__arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="contact__meta">
          <section class="contact__block">
            <h2>Studio</h2>
            <address>
              Anna-Schneider-Steig 2<br />
              Rheinauhafen<br />
              50678 Köln
            </address>
          </section>

          <!-- Anbieterangaben stehen laut Markenarchitektur nur im Impressum -->
          <section class="contact__block">
            <h2>Ansprechpartner</h2>
            <p>Philipp Maxhofer</p>
            <p class="contact__legal-link">
              <a href={withBase("/impressum")}>Vollständiges Impressum</a>
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { padding-block: clamp(8rem, 18vh, 12rem) var(--section-y); }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: start;
  }

  .contact__head .label { margin-bottom: var(--space-3); }
  .contact__title { margin-bottom: var(--space-3); }
  .contact__title .headline { display: block; }
  .contact__lead { max-width: 42ch; }

  /* Direkte Kontaktwege als große, klickbare Zeilen */
  .contact__direct {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .contact__big {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 72px;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
    overflow-wrap: anywhere;
    transition: color var(--dur) var(--ease-out);
  }

  .contact__big:hover { color: var(--petrol); }

  .contact__arrow {
    flex-shrink: 0;
    color: var(--petrol);
    transition: transform var(--dur) var(--ease-out);
  }

  .contact__big:hover .contact__arrow { transform: translateX(4px); }

  .contact__meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .contact__block h2 {
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }

  .contact__block address,
  .contact__block p {
    font-style: normal;
    line-height: var(--lh-body);
  }

  .contact__block a {
    color: var(--petrol);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .contact__block a:hover { color: var(--petrol-dark); }

  .contact__legal-link { margin-top: var(--space-2); font-size: var(--fs-small); }

  @media (min-width: 40rem) {
    .contact__meta { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 64rem) {
    .contact__grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
    .contact__head { position: sticky; top: 7rem; }
  }
</style>
