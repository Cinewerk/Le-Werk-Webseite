---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/paths';
import Videowand from '../../components/Videowand.astro';
import { clips, galerie } from '../../data/street-one';

// Diese Seite hat eine eigene Datei statt der Sammelroute /arbeiten/[slug].
// Damit es die Adresse nicht zweimal gibt, trägt der Eintrag in
// src/data/arbeiten.ts das Kennzeichen eigeneSeite und wird dort
// übersprungen.

const etappen = [
  {
    nr: '01',
    titel: 'Work',
    bild: '/images/street-one/action-01.jpg',
    alt: 'Team am Set: mehrere Personen stehen um Monitor und Kamera und stimmen die nächste Einstellung ab',
    text: 'In einem kollaborativen Workshop erarbeiteten wir eine neue Social Media Strategie: Ein moderner Look und die Entwicklung reichweitenstarker Content-Ideen und Formate standen im Mittelpunkt. Ein besonderer Fokus lag dabei auf Kurzvideos.',
  },
  {
    nr: '02',
    titel: 'Kreation',
    bild: '/images/street-one/action-02.jpg',
    alt: 'Aufgebautes Studioset mit Hohlkehle, Lichtstativen und Reflektor, das Team bereitet die nächste Szene vor',
    text: 'Darauf folgend startete die Content Konzept Kreation, in welcher die Format Ideen in produktionsgenaue Konzepte ausdetailliert wurden. Dabei entstanden unter anderem Storyboards, Skripte und Videotexte, Foto Moodboards, Animations- und Designvorlagen, und alles weitere was für eine optimierte Content Kreation notwendig wird. Daraus entstand dann der Produktionsplan.',
  },
  {
    nr: '03',
    titel: 'Produce',
    bild: '/images/street-one/action-03.jpg',
    alt: 'Gruppenbild des Produktionsteams vor der Studiohohlkehle, rund fünfzehn Personen',
    text: 'Für die Contenterstellung wurde die Videoproduktion mit der Fotoproduktion zu zwei Media Days zusammengeführt. Ein 15-köpfiges Team bestehend aus Regisseur, Kamerafrau, Fotograf, Maskenbildner, Models und vielen anderen arbeitete an diesen Tagen an einer möglichst effizienten Content Produktion. In der Postproduktion wurden dann aus den verschiedenen Inhalten die zuvor geplanten Content-Formate erstellt.',
  },
];
---

<BaseLayout
  title="Street One — Social Media Content & Kampagnen | Le Werk"
  description="Social Media Content und Kampagnen für STREET ONE: Strategie, Content-Formate, Konzeption sowie Foto- und Filmproduktion an zwei Media Days. Über 100 Content Assets."
>
  <!-- ═══ 1 · KOPF ═══════════════════════════════════════════════════════ -->
  <section class="fall-kopf">
    <div class="container fall-kopf__grid">
      <div class="fall-kopf__text" data-reveal>
        <p class="label label--accent">Arbeiten</p>
        <h1 class="fall-kopf__titel">
          <span class="editorial editorial--kicker">Street One</span>{' '}
          <span class="headline headline--xl">Social Media Content &amp; Kampagnen</span>
        </h1>
        <p class="fall-kopf__leistungen">
          Strategie · Ideen · Content Formate · Konzeption · Foto &amp; Filmproduktion
        </p>
      </div>

      <figure class="fall-kopf__bild" data-reveal data-reveal-delay="120">
        <img
          src={withBase('/images/street-one/buehne.jpg')}
          alt="Model im hellen Sweatkleid tanzt im Sonnenlicht einer Industriehalle"
          width="1125" height="1500" fetchpriority="high" decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- ═══ 2 · BRAND & CHALLENGE ══════════════════════════════════════════ -->
  <section class="section section--dark ausgang" aria-labelledby="ausgang-titel">
    <h2 class="visually-hidden" id="ausgang-titel">Ausgangslage</h2>
    <div class="container ausgang__grid">
      <figure class="ausgang__bild ausgang__bild--1" data-reveal>
        <img
          src={withBase('/images/street-one/brand-01.jpg')}
          alt="Model in weißer Jeansjacke und gestreiftem Shirt vor einer verputzten Wand"
          width="900" height="1200" loading="lazy" decoding="async"
        />
      </figure>

      <div class="ausgang__block ausgang__block--1" data-reveal data-reveal-delay="80">
        <p class="editorial ausgang__marke">Brand</p>
        <p class="ausgang__text">
          STREET ONE ist eine international bekannte Modemarke mit norddeutschen
          Wurzeln. Eine breite Stammkundschaft hält der Kette die Treue. Über
          Social Media sollen nun aber auch jüngere und digitale Zielgruppen
          erschlossen werden.
        </p>
      </div>

      <div class="ausgang__block ausgang__block--2" data-reveal>
        <p class="editorial ausgang__marke">Challenge</p>
        <p class="ausgang__text">
          Natürlich ist Social Media für Street One schon lange kein Fremdwort
          mehr. Wir sollten dem Auftritt aber einen modernen Anstrich verpassen —
          mit erfrischendem Content, der auf Instagram und Facebook
          „funktioniert". Und dabei der Zielgruppe und den Markenwerten treu
          bleiben.
        </p>
      </div>

      <figure class="ausgang__bild ausgang__bild--2" data-reveal data-reveal-delay="80">
        <img
          src={withBase('/images/street-one/brand-02.jpg')}
          alt="Model in Jeanshemd am Fenster einer Industriehalle, über die Schulter blickend"
          width="900" height="1200" loading="lazy" decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- ═══ 3 · ACTION ═════════════════════════════════════════════════════ -->
  <section class="section section--sand etappen" aria-labelledby="etappen-titel">
    <div class="container">
      <header class="sec-head" data-reveal>
        <p class="label">Vorgehen</p>
        <h2 class="headline" id="etappen-titel">
          <span class="editorial editorial--kicker">Von der Strategie</span>{' '}
          in die Produktion
        </h2>
      </header>

      <ol class="etappen__liste">
        {etappen.map((e, i) => (
          <li class={`etappe etappe--${i + 1}`}>
            <figure class="etappe__bild" data-reveal>
              <img src={withBase(e.bild)} alt={e.alt} loading="lazy" decoding="async" />
            </figure>
            <div class="etappe__text" data-reveal data-reveal-delay="80">
              <p class="etappe__nr" aria-hidden="true">{e.nr}</p>
              <h3 class="etappe__titel">{e.titel}</h3>
              <p>{e.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ 4 · DIE FORMATE (Videos) ═══════════════════════════════════════ -->
  <section class="section section--dark formate" aria-labelledby="formate-titel">
    <div class="container">
      <header class="sec-head" data-reveal>
        <p class="label">Zwölf von über hundert</p>
        <h2 class="headline" id="formate-titel">
          <span class="editorial editorial--kicker">Die</span>{' '}
          Formate
        </h2>
        <p class="lead">
          Kein Content am Stück, sondern wiederholbare Formate: Magic Rotation,
          Fashion Wiki, Dress-Up, Tips &amp; Tricks. Einmal entwickelt, immer
          wieder bespielbar.
        </p>
      </header>

      <!-- Datenschutz: Vor dem Klick steht nur ein Standbild von unserem
           eigenen Server, es geht keine Anfrage an Vimeo raus. Erst der
           Klick lädt den Player — mit dnt=1 und ohne Titel, Byline und
           Profilbild. Der Hinweis dazu stand hier mal als sichtbare Zeile
           und ist bewusst raus; am Verhalten ändert das nichts. -->
      <Videowand clips={clips} poster="/images/street-one/poster" />
    </div>
  </section>

  <!-- ═══ 5 · RESULT ═════════════════════════════════════════════════════ -->
  <section class="section ergebnis" aria-labelledby="ergebnis-titel">
    <div class="container ergebnis__grid">
      <div class="ergebnis__text">
        <p class="label label--accent" data-reveal>Result</p>
        <p class="ergebnis__zahl" id="ergebnis-titel" data-reveal>
          <span class="ergebnis__wert">100+</span>{' '}
          <span class="ergebnis__einheit">Content Assets</span>
        </p>
        <p class="ergebnis__absatz" data-reveal data-reveal-delay="80">
          Es entstanden über 100 Content Assets, mit denen STREET ONE alle
          relevanten Metriken — und auch die Sales — messbar verbessern konnte.
          Dies betraf sowohl die Gewinnung von Neukundinnen als auch die
          Conversion bei Bestandskundinnen.
        </p>
        <p class="ergebnis__absatz" data-reveal data-reveal-delay="120">
          Vor allem aber wurde der Markenauftritt auf Social Media auf ein
          zeitgemäßes Level gebracht. Mit Content Formaten, die einerseits
          fashionable sind und andererseits informative Inhalte bieten.
        </p>
      </div>

      <figure class="ergebnis__bild" data-reveal data-reveal-delay="80">
        <img
          src={withBase('/images/street-one/ergebnis.jpg')}
          alt="Model von hinten vor einer großen Fensterfront, daneben Lautsprecher und Vase mit Pampasgras"
          width="1100" height="1390" loading="lazy" decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- ═══ 6 · FOTOSTRECKE ════════════════════════════════════════════════ -->
  <section class="section section--sand strecke" aria-labelledby="strecke-titel">
    <div class="container">
      <header class="sec-head sec-head--nur-marke" data-reveal>
        <h2 class="label" id="strecke-titel">Aus derselben Produktion</h2>
      </header>

      <ul class="strecke__raster">
        {galerie.map((g, i) => (
          <li class="strecke__feld" data-reveal data-reveal-delay={(i % 3) * 70}>
            <img src={withBase(g.bild)} alt={g.alt} loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ 7 · ABSCHLUSS ══════════════════════════════════════════════════ -->
  <section class="section section--dark cta" aria-labelledby="cta-titel">
    <div class="container cta__inner" data-reveal>
      <h2 class="headline headline--xl cta__titel" id="cta-titel">
        <span class="editorial editorial--kicker">Sowas</span>{' '}
        für eure Marke?
      </h2>
      <div class="cta__aktionen">
        <a class="btn btn--on-dark" href={withBase('/kontakt')}>
          Projekt anfragen <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={withBase('/#arbeiten')}>Weitere Arbeiten</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══ 1 · Kopf ═══════════════════════════════════════════════════════ */
  .fall-kopf {
    padding-block: clamp(9rem, 20vh, 13rem) var(--section-y);
  }

  .fall-kopf__grid { display: grid; gap: clamp(2.5rem, 6vw, 4rem); }
  .fall-kopf__text .label { margin-bottom: var(--space-3); }
  .fall-kopf__titel { margin-bottom: var(--space-4); }
  .fall-kopf__titel .headline { display: block; }

  /* Versalzeile als Gegengewicht zur großen Headline — dasselbe Muster wie
     die Meta-Zeile im Positionierungsabsatz auf der Startseite. */
  .fall-kopf__leistungen {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    line-height: 1.9;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .fall-kopf__bild { margin: 0; overflow: hidden; border-radius: var(--radius-lg); }
  .fall-kopf__bild img { display: block; width: 100%; height: auto; }

  /* ═══ 2 · Brand & Challenge ══════════════════════════════════════════ */
  .ausgang__grid { display: grid; gap: clamp(2.5rem, 6vw, 4rem); }

  .ausgang__bild { margin: 0; overflow: hidden; border-radius: var(--radius-lg); }
  .ausgang__bild img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* Bodoni-Marginalie statt Überschrift: "Brand" und "Challenge" sind
     Etiketten des Textes, keine eigene Gliederungsebene — deshalb stehen
     sie als Absatz und die Sektion trägt eine unsichtbare Überschrift. */
  .ausgang__marke {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.1;
    margin-bottom: var(--space-2);
    color: var(--petrol-light);
  }

  .ausgang__text {
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--on-dark-muted);
    max-width: 34rem;
  }

  /* ═══ 3 · Etappen ════════════════════════════════════════════════════ */
  .etappen__liste {
    display: grid;
    gap: clamp(3rem, 8vw, 6rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .etappe { display: grid; gap: clamp(1.5rem, 4vw, 2.5rem); }

  .etappe__bild { margin: 0; overflow: hidden; border-radius: var(--radius-lg); }
  .etappe__bild img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* Das Teamfoto liegt quer und würde im 3:4-Beschnitt die Ränder
     verlieren — an dem Bild hängt aber genau die Aussage "15-köpfiges
     Team". Deshalb behält es sein Format. */
  .etappe--3 .etappe__bild img { aspect-ratio: 5 / 4; }

  .etappe__nr {
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--petrol);
    margin-bottom: var(--space-1);
  }

  .etappe__titel {
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .etappe__text p { color: var(--ink-muted); line-height: 1.65; max-width: 38rem; }

  /* ═══ 5 · Ergebnis ═══════════════════════════════════════════════════ */
  .ergebnis__grid { display: grid; gap: clamp(2.5rem, 6vw, 4rem); }
  .ergebnis__text .label { margin-bottom: var(--space-2); }

  .ergebnis__zahl { margin-bottom: var(--space-3); }

  .ergebnis__wert {
    display: block;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: clamp(4rem, 13vw, 9rem);
    line-height: 0.9;
    letter-spacing: var(--track-display);
    color: var(--petrol);
  }

  .ergebnis__einheit {
    display: block;
    margin-top: var(--space-2);
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: clamp(1.25rem, 3vw, 2rem);
  }

  .ergebnis__absatz { color: var(--ink-muted); line-height: 1.65; max-width: 34rem; }
  .ergebnis__absatz + .ergebnis__absatz { margin-top: var(--space-2); }

  .ergebnis__bild { margin: 0; overflow: hidden; border-radius: var(--radius-lg); }
  .ergebnis__bild img { display: block; width: 100%; height: auto; }

  /* ═══ 6 · Fotostrecke ════════════════════════════════════════════════ */
  .strecke__raster {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Neun Bilder auf zwei Spalten lassen eines allein übrig — es läuft
     deshalb über beide, wie im Raster hinter den Kulissen auf der
     Startseite. Ab drei Spalten geht die Rechnung von selbst auf.
     Das Format bleibt dabei 4:5: Auf 3:2 beschnitten hat der Zuschnitt
     den beiden Models die Köpfe genommen. */
  .strecke__feld:last-child { grid-column: 1 / -1; }

  .strecke__feld { overflow: hidden; border-radius: var(--radius); }
  .strecke__feld img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .strecke__feld:hover img { transform: scale(1.04); }

  /* ═══ 7 · Abschluss ══════════════════════════════════════════════════ */
  .cta__inner { text-align: center; }
  .cta__titel { margin-bottom: var(--space-4); }
  .cta__titel .editorial { display: block; }

  .cta__aktionen {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  /* ═══ Breakpoints ════════════════════════════════════════════════════ */
  @media (min-width: 768px) {
    .clips { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    .strecke__raster { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .strecke__feld:last-child { grid-column: auto; }
  }

  @media (min-width: 1024px) {
    .fall-kopf__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      align-items: end;
    }
    .fall-kopf__text { grid-column: 1 / span 6; }
    .fall-kopf__bild { grid-column: 8 / span 5; }

    .ausgang__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: clamp(4rem, 9vw, 7rem);
      align-items: center;
    }
    .ausgang__bild--1 { grid-column: 1 / span 4; grid-row: 1; }
    .ausgang__block--1 { grid-column: 6 / span 6; grid-row: 1; }
    .ausgang__block--2 { grid-column: 2 / span 6; grid-row: 2; }
    .ausgang__bild--2 { grid-column: 9 / span 4; grid-row: 2; }

    /* Bild und Text wechseln die Seite, damit die drei Etappen nicht als
       Liste durchlaufen, sondern als Abfolge gelesen werden. */
    .etappe {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      align-items: center;
    }
    .etappe__bild { grid-column: 1 / span 5; grid-row: 1; }
    .etappe__text { grid-column: 7 / span 5; grid-row: 1; }

    .etappe--2 .etappe__bild { grid-column: 8 / span 5; }
    .etappe--2 .etappe__text { grid-column: 1 / span 5; }

    .etappe--3 .etappe__bild { grid-column: 1 / span 7; }
    .etappe--3 .etappe__text { grid-column: 9 / span 4; }

    .ergebnis__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      align-items: center;
    }
    .ergebnis__text { grid-column: 1 / span 6; }
    .ergebnis__bild { grid-column: 8 / span 5; }

    /* Die mittlere Spalte sitzt tiefer — dadurch läuft die Strecke nicht
       als sauberes Raster durch, sondern versetzt wie ein Kontaktbogen. */
    .strecke__feld:nth-child(3n + 2) { transform: translateY(clamp(1.5rem, 4vw, 3.5rem)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .strecke__feld:nth-child(3n + 2) { transform: none; }
  }
</style>
