---
import BaseLayout from '../layouts/BaseLayout.astro';
import Streublock from '../components/Streublock.astro';
import { services } from '../data/services';
import { arbeiten } from '../data/arbeiten';
import { withBase } from '../lib/paths';

// Der Dateiname des Bühnenvideos ist bewusst neutral gehalten: Er steht im
// Quelltext jeder Seite, und laut Markenarchitektur wird die Schwestermarke
// ausschließlich im Impressum genannt. Details in docs/bildmaterial.md.

// Die Kundenlogos liegen als ein durchgehender Streifen vor. Für die
// Endlosschleife läuft er zweimal hintereinander; der Track wandert um
// exakt eine Streifenbreite, dadurch ist der Übergang nahtlos.
const kundenlogos =
  'Henkell Freixenet, ServiceNow, Douglas, Seven.One Entertainment Group, ' +
  'Hugo Boss, Deutsche Welle, Shop Apotheke Europe, Street One, Siemens, ' +
  'Zehnder Group, North Kiteboarding';

// Die fünf Projekte liegen in src/data/arbeiten.ts, weil die Unterseiten
// unter /arbeiten/<slug> dieselben Angaben brauchen.

// Auf der Startseite erscheinen nur die drei Produktionsdisziplinen.
// Workshops bleiben über Menü, Footer und /services erreichbar.
//
// Eigene Reihenfolge, weil die Kästen hier anders liegen: Video groß links,
// Idee & Konzept rechts oben, Foto rechts unten. Sie steht über die Adresse
// und nicht über den Listenplatz — sonst würde eine Umsortierung in
// services.ts das Layout still verschieben.
const reihenfolge = ['/services/video', '/services/konzept', '/services/foto'];
const disziplinen = services
  .filter((s) => s.disziplin)
  .sort((a, b) => reihenfolge.indexOf(a.href) - reihenfolge.indexOf(b.href));

// Echte Aufnahmen vom Set, ausgewählt aus dem gelieferten Ordner. Neun von
// zwanzig — die Auswahl erzählt eine Produktion von vorn bis hinten: Team,
// Set, Dreh, Detail, Schnitt. Aussortiert wurde alles, was keine
// Produktion zeigt (Reise- und Straßenmotive) sowie doppelte Situationen.
//
// Die Reihenfolge steuert das Raster: Reihe 1 und 3 liegen quer, Reihe 2
// steht hoch. Die Originale liegen unter quellbilder/bts und sind nicht
// Teil des Repos; hier stehen auf Webmaß gerechnete Fassungen.
//
// x und w sind Prozente der Haufenbreite, y ist Prozent der Haufenhöhe.
// Wie weit ein Stück beim Scrollen wandert, steht hier bewusst nicht: Das
// rechnet Streublock.astro aus der Lage aus — der Weg zeigt von der Mitte
// der Fläche weg, ein mittiges Stück wandert kaum, ein äußeres am weitesten.
//
// Die Anordnung ist an der Referenz nachgemessen und nicht geschätzt: Dort
// überlappen sich sechs Bilder kräftig, die Größen reichen von 30 bis 45
// Prozent der Breite, und die Fläche steht hochkant. Genau das macht den
// Haufen aus — meine erste Fassung lag zu weit auseinander und las sich
// als Collage statt als Stapel.
//
// Beim Umsortieren gilt: y (in Höhenprozent) mal Höhe plus die aus w und
// ar folgende Höhe muss unter 100 bleiben, sonst hängt ein Stück heraus.
const bts = [
  { img: '/images/bts/bts-01.jpg', alt: 'Fünf Personen aus dem Team nebeneinander, jede mit einer Kamera',                     x: 17, y: 6,  w: 43, ar: '3 / 2', z: 2 },
  { img: '/images/bts/bts-04.jpg', alt: 'Aufgebautes Interviewset mit Softboxen, das Team sitzt davor',                        x: 62, y: 6,  w: 36, ar: '1 / 1',  z: 3 },
  { img: '/images/bts/bts-06.jpg', alt: 'Zwei Personen richten im Studio eine Kamera ein',                                     x: 39, y: 16, w: 33, ar: '2 / 3', z: 5 },
  { img: '/images/bts/bts-02.jpg', alt: 'Interviewsituation: ein Mann auf einem Hocker, Tonangel und Monitore im Vordergrund', x: 4,  y: 35, w: 44, ar: '2 / 3',  z: 4 },
  { img: '/images/bts/bts-08.jpg', alt: 'Kamera mit zwei Monitoren, Hände am Stativkopf',                                      x: 70, y: 36, w: 30, ar: '3 / 4', z: 1 },
  { img: '/images/bts/bts-03.jpg', alt: 'Kameramann mit Easyrig in einem hellen Wohnraum',                                     x: 46, y: 56, w: 33, ar: '1 / 1',  z: 6 },
];

// Das Krafthaus am Rheinauhafen. Aus 26 gelieferten Aufnahmen sechs
// ausgewählt: das Haus im Abendlicht mit dem Kranhaus dahinter, der Blick
// aus der Drohne, die Fassade, das Schild am Fenster und der Arbeitsplatz.
// Nicht dabei ist die Aufnahme mit dem Kübel vor dem Eingang — darauf
// steht das Schild der Schwestermarke, und die wird laut
// Markenarchitektur nur im Impressum genannt.
const krafthaus = [
  { img: '/images/krafthaus/haus-01.jpg', alt: 'Das Krafthaus im Abendlicht, dahinter das Kranhaus am Rheinauhafen',            x: 8,  y: 5,  w: 45, ar: '3 / 2', z: 2 },
  { img: '/images/krafthaus/haus-02.jpg', alt: 'Arbeitsplatz am Rundbogenfenster: Monitor, Laptop und Schreibtischlampe im Gegenlicht', x: 57, y: 0, w: 34, ar: '3 / 4', z: 3 },
  // Ganz oben im Stapel, obwohl es mittig liegt: Der Schriftzug sitzt im
  // unteren Drittel dieser Aufnahme, und genau dort deckte das Luftbild
  // ihn zu. Es ist das einzige Bild mit unserem Namen am Haus.
  { img: '/images/krafthaus/haus-03.jpg', alt: 'Schild mit dem Schriftzug Le Werk unter einem Sprossenfenster im Backstein',    x: 34, y: 26, w: 30, ar: '2 / 3', z: 7 },
  { img: '/images/krafthaus/haus-04.jpg', alt: 'Die Backsteinfassade des Krafthauses unter bewölktem Himmel',                   x: 66, y: 40, w: 34, ar: '3 / 2',  z: 1 },
  // 3:4 statt 1:1 und schmaler: Die Aufnahme liegt hochkant vor, der
  // quadratische Beschnitt hat sie in die Breite gezogen und dem Giebel
  // oben wie unten etwas weggenommen. In ihrem eigenen Format steht sie
  // aufrecht — dafür ist sie von 40 auf 36 Prozent Breite zurückgesetzt,
  // sonst liefe sie unten aus der Fläche.
  { img: '/images/krafthaus/haus-05.jpg', alt: 'Giebel aus gelbem Backstein mit Sprossenfenstern vor blauem Himmel mit Wolken', x: 5,  y: 42, w: 36, ar: '3 / 4', z: 4 },
  { img: '/images/krafthaus/haus-06.jpg', alt: 'Luftaufnahme des Krafthauses und der umliegenden Dächer im Rheinauhafen',       x: 38, y: 61, w: 36, ar: '16 / 9', z: 6 },
];

// Vier Plätze, alle vier echt. Sie liegen als fertiges Quadrat vor
// (700 × 700): Der Zuschnitt steckt in der Datei und nicht im CSS, weil
// die Aufnahmen quer oder hoch sind und die Personen klein im Raum
// zeigen — ein Beschnitt per object-fit hätte sie nur verschoben, nicht
// näher herangeholt. Die Originale liegen unter quellbilder/team.
// OFFEN: die Rollen. Die Namen stehen, die Zeile darunter ist noch leer.
const team = [
  { img: '/images/team/philipp-maxhofer.jpg', name: 'Philipp Maxhofer', role: 'Rolle folgt', alt: 'Porträt von Philipp Maxhofer im Rollkragenpullover, Studio im Hintergrund' },
  { img: '/images/team/cem-schuch.jpg', name: 'Cem Schuch', role: 'Rolle folgt', alt: 'Porträt von Cem Schuch, sitzend auf einem Sofa im Studio' },
  { img: '/images/team/joscha-ortmeier.jpg', name: 'Joscha Ortmeier', role: 'Rolle folgt', alt: 'Porträt von Joscha Ortmeier mit Brille, im Hintergrund ein Bücherregal' },
  { img: '/images/team/tom-beckers.jpg', name: 'Tom Beckers', role: 'Rolle folgt', alt: 'Porträt von Tom Beckers, sitzend auf demselben Sofa im Studio' },
];

// q darf Markup enthalten (Wortmarke), wird unten mit set:html gerendert.
// Die Fragen 2, 6 und 7 tragen die drei Punkte aus "Was wir nicht machen" —
// im FAQ statt in einer eigenen Sektion, weil eine Abgrenzung als Antwort
// auf eine echte Frage überzeugt und als Aufzählung nur abweist.
const faqs = [
  { q: 'Was kostet eine Produktion bei <span class="brand">Le Werk</span>?', a: 'Das hängt an Drehtagen, Team und Formatumfang. Kompakte Social-Produktionen starten im mittleren vierstelligen Bereich, größere Kampagnen liegen fünfstellig. Nach einem 20-minütigen Gespräch bekommt ihr eine belastbare Spanne — kein Zahlenraten.' },
  { q: 'Macht ihr auch UGC- oder Handy-Content?', a: 'Nein. Das ist ein anderer Markt mit anderen Preisen und anderem Anspruch. Bei uns entstehen Visuals auf Kampagnenniveau — auch dann, wenn sie am Ende vertikal im Feed laufen. Wer schnellen, günstigen Durchsatz sucht, ist bei uns falsch.' },
  { q: 'Bekommen wir Foto und Video aus einer Produktion?', a: 'Ja, das ist der Kern unserer Arbeitsweise. Wir planen Sets so, dass bewegte und stehende Bilder parallel entstehen. Das spart einen kompletten Produktionstag und sorgt dafür, dass Foto und Video wie eine Kampagne aussehen — nicht wie zwei.' },
  { q: 'Warum denkt ihr vom vertikalen Format aus?', a: 'Weil dort die Aufmerksamkeit liegt. Ein Bildaufbau, der als 16:9 entsteht und später hochkant beschnitten wird, verliert immer — Blickführung, Text und Rhythmus stimmen dann nicht mehr. Wir planen umgekehrt: vertikal als Kern, Landscape und Stills als Ableitung derselben Produktion.' },
  { q: 'Wie lange dauert es von der Anfrage bis zum fertigen Material?', a: 'Für eine kompakte Produktion rechnet mit drei bis vier Wochen: eine Woche Konzept, ein bis zwei Drehtage, ein bis zwei Wochen Post. Bei laufenden Content-Paketen verkürzt sich das deutlich, weil Setup und Look bereits stehen.' },
  { q: 'Produziert ihr auch klassische Werbefilm-Kampagnen in 16:9?', a: 'Als Hauptformat nicht — die cinematische 16:9-Kampagne ist nicht unsere Disziplin, und wir tun nicht so, als wäre sie es. Landscape bekommt ihr bei uns als Ableitung aus einer Content-Produktion. Wenn euer Vorhaben in Wahrheit ein Werbefilm ist, sagen wir das offen und nennen euch die passende Adresse.' },
  { q: 'Übernehmt ihr Mediaplanung, SEO oder SEA?', a: 'Nein, wir sind kein Full-Service-Betrieb. Keine Media-Buchung, kein Suchmaschinen-Marketing, keine Account-Ebene zwischen euch und der Produktion. Wir liefern die Visuals und arbeiten dabei problemlos mit eurer Agentur oder eurem Marketing-Team zusammen.' },
  { q: 'Arbeitet ihr nur in Köln?', a: 'Das Studio liegt im Rheinauhafen, der Verkaufsschwerpunkt ist Köln und NRW — gedreht wird da, wo euer Thema ist. Based in Köln, booked worldwide: bundesweite Produktionen sind Alltag, internationale Drehs gehen ebenfalls.' },
  { q: 'Wie ist das mit den Nutzungsrechten?', a: 'Ihr erhaltet standardmäßig zeitlich und räumlich unbegrenzte Nutzungsrechte für alle eigenen Kanäle. Für Paid Media, Out-of-Home oder TV klären wir Buyouts vorab transparent im Angebot — keine Nachforderungen.' },
  { q: 'Was bieten eure Workshops?', a: 'Drei Formate: Auftreten und Sprechen vor der Kamera, ein Social-Media-Basistraining zu Formatlogik und Bildsprache sowie Teambuilding und interne Kommunikation über Improtheater-Training. Umfang, Dauer und Teilnehmerzahl stimmen wir auf euer Team ab.' },
];
---

<BaseLayout
  title="Le Werk — Visual Content Studio für Video und Fotografie"
  description="Le Werk ist ein Visual Content Studio in Köln: Video und Fotografie auf Kampagnenniveau, vom vertikalen Format aus gedacht. Handwerk mit redaktioneller Substanz — kein UGC, kein Full-Service-Overhead."
  heroDark={true}
>
  <!-- ═══ 1 · HERO ═══════════════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <!-- muted und playsinline sind Bedingung dafür, dass mobile Browser
           überhaupt selbst starten. Die Datei hat keine Tonspur.
           Bei prefers-reduced-motion hält ein Skript das Video an. -->
      <video
        id="hero-video"
        autoplay muted loop playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={withBase('/videos/lewerk-hero.mp4')} type="video/mp4" />
      </video>
    </div>

    <!-- Text sitzt in der unteren linken Ecke und läuft bewusst nicht über
         die ganze Breite. Randabstand = --edge, damit er mit dem Logo im
         Header auf einer Achse liegt. -->
    <div class="hero__inner">
      <h1 class="hero__statement" id="hero-title" lang="en">
        <span class="brand">Le Werk</span> is a visual content studio crafting
        brand content <em>worth watching.</em>
      </h1>
    </div>

    <a class="hero__cue" href="#positionierung" aria-label="Weiter zum Inhalt scrollen">
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- ═══ 2 · POSITIONIERUNG ═════════════════════════════════════════════ -->
  <section class="section statement" id="positionierung" aria-labelledby="statement-title">
    <div class="container statement__inner">
      <!-- Bewusst kein deutscher Claim: Laut Positionierung trägt der
           englische Positions-Satz im Hero diese Rolle, ein Manifest-Satz
           auf Deutsch steht noch aus. Dieser Absatz erklärt die Position,
           er behauptet sie nicht als Slogan. -->
      <!-- Ein durchlaufender Absatz: Der Auftakt stand vorher auf eigener
           Zeile, dadurch begann der Satz sichtbar mit "Le Werk ist ein
           Visual Content Studio" — dieselbe Aussage wie im Hero darüber.
           Inline gesetzt trägt er den Satzanfang und der Doppelklang ist weg.
           Die Eleganz kommt jetzt aus drei Stimmen in einer Zeile: kursiver
           Einstieg, Roman als Körper, kursiver Schluss. -->
      <p class="statement__text" id="statement-title" data-reveal>
        <em>Gegründet von Filmemachern.</em>{' '}
        <span class="brand">Le Werk</span> ist ein Visual Content Studio im
        Kölner Rheinauhafen, spezialisiert auf Storytelling, Film und Foto
        für <em>Social und Branded Content.</em>
      </p>
      <p class="statement__meta" data-reveal data-reveal-delay="80">
        Konzept · Produktion · Postproduktion · Based in Köln, Booked Worldwide
      </p>
    </div>
  </section>

  <!-- ═══ 3 · ARBEITEN ═══════════════════════════════════════════════════ -->
  <section class="section section--dark work" id="arbeiten" aria-labelledby="work-title">
    <div class="container">
      <!-- Englisch wie der Positions-Satz im Hero, deshalb lang="en": Ohne
           die Angabe liest eine Sprachausgabe "Featured Work" deutsch vor. -->
      <header class="work__head" data-reveal>
        <h2 class="headline headline--xl" id="work-title" lang="en">
          <span class="editorial editorial--kicker">Featured</span>{' '}
          Work
        </h2>
        <!-- Der frühere Einleitungstext ist entfallen. Er erklärte die
             Formatlogik ("vom vertikalen Format aus") — die steht jetzt in
             den Format-Zeilen der Kacheln und im FAQ. -->
      </header>

      <!-- Der Kundenname steht groß im Bild, das Projekt in der Zeile
           darunter. Vorher trug das Bild eine Gattung ("Social Video") —
           bei echten Arbeiten ist der Kunde die stärkere Angabe. -->
      <div class="work__grid">
        {arbeiten.map((a, i) => (
          <article class={`work__item work__item--${i + 1}`} data-reveal data-reveal-delay={(i % 2) * 80}>
            <a class="work__link" href={withBase(`/arbeiten/${a.slug}`)}>
              <figure class="work__figure" data-format={a.ratio}>
                <img src={withBase(a.bild)} alt={a.alt} width={a.breite} height={a.hoehe} loading="lazy" decoding="async" />
                <figcaption class="work__tag">{a.kunde}</figcaption>
              </figure>
              <p class="work__caption">
                <span class="work__titel">{a.titel}</span>
                <span class="work__format">
                  <span class="visually-hidden">Format </span>{a.format}
                </span>
              </p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 4 · TRUSTBAR (Logo-Marquee) ════════════════════════════════════ -->
  <section class="section section--tight trust" id="trust" aria-label="Auswahl unserer Kunden">
    <div class="container">
      <!-- Vorher "Vertrauen auf Le Werk" — als Imperativ lesbar und
           werblich. Die Zeile benennt jetzt nur noch, was zu sehen ist. -->
      <p class="label trust__label">Ausgewählte Kunden</p>
    </div>

    <div class="marquee">
      <div class="marquee__track">
        <img
          class="marquee__strip"
          src={withBase('/images/kunden/logostreifen.png')}
          alt={`Kundenlogos: ${kundenlogos}`}
          width="5000" height="400" loading="lazy" decoding="async"
        />
        <!-- zweite Kopie nur für die Schleife, für Screenreader unsichtbar -->
        <img
          class="marquee__strip"
          src={withBase('/images/kunden/logostreifen.png')}
          alt="" aria-hidden="true"
          width="5000" height="400" loading="lazy" decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ═══ 5 · LEISTUNGEN ═════════════════════════════════════════════════ -->
  <section class="section section--sand services" aria-labelledby="services-title">
    <div class="container">
      <header class="sec-head" data-reveal>
        <p class="label">Was wir machen</p>
        <h2 class="headline" id="services-title">
          <span class="editorial editorial--kicker">Content,</span>{' '}
          holistisch gedacht
        </h2>
        <!-- Der frühere Fließtext ist entfallen. Er stufte die Disziplinen
             ab ("Hauptdisziplin", "klare Zweite", "vorgeschaltet") und stand
             damit gegen die neue Überschrift, die sie zusammendenkt. -->
      </header>

      <!-- Nur die drei Produktionsdisziplinen. Workshops sind bewusst nicht
           auf der Startseite und ausschließlich über das Menü erreichbar.

           Bewusst keine Karten: Gleich große Kästen mit Rahmen und Schatten
           sehen nach Baukasten aus. Hier trägt die Anordnung — Video groß
           über die volle Höhe links, Idee & Konzept und Foto rechts
           gestapelt. -->
      <ol class="disziplinen">
        {disziplinen.map((s, i) => (
          <li class={`disziplin disziplin--${i + 1}`} data-reveal data-reveal-delay={i * 90}>
            <a class="disziplin__link" href={withBase(s.href)}>
              <figure class="disziplin__bild" style={`--ratio:${s.ratio ?? '4 / 3'}`}>
                <img src={withBase(s.img)} alt="" width="1200" height="900" loading="lazy" decoding="async" />
                <figcaption class="disziplin__marke">{s.titel ?? s.label}</figcaption>
              </figure>

              <p class="disziplin__zeile">
                <span class="disziplin__text">{s.text}</span>
                <span class="disziplin__mehr">
                  Mehr erfahren <span class="disziplin__pfeil" aria-hidden="true">→</span>
                </span>
              </p>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ 6 · UNSER TEAM ═════════════════════════════════════════════════ -->
  <section class="section section--dark team" aria-labelledby="team-title">
    <div class="container">
      <header class="sec-head sec-head--knapp" data-reveal>
        <p class="label">Wer dahintersteht</p>
        <h2 class="headline" id="team-title">
          <span class="editorial editorial--kicker">Unser</span>{' '}
          Team
        </h2>
      </header>

      <!-- Erst die Gesichter … -->
      <ul class="team__grid">
        {team.map((m, i) => (
          <li class="team__member" data-reveal data-reveal-delay={i * 70}>
            <img
              class="team__portrait"
              src={withBase(m.img)} alt={m.alt}
              width="700" height="700" loading="lazy" decoding="async"
            />
            <p class="team__name">{m.name}</p>
            <p class="team__role">{m.role}</p>
          </li>
        ))}
      </ul>

      <!-- … dann zwei Blöcke, in denen der Text von seiner Seite
           hereinkommt und die Bilder beim Scrollen mitwandern. Der Text
           von 01 stand vorher als breiter Absatz über die volle Breite;
           in der schmalen Spalte neben dem Haufen trägt er besser. -->
      <div class="team__bloecke">
        <Streublock nr="01" seite="rechts" bilder={bts} label="Blick hinter die Kulissen">
          <p>
            Ein Team, das produziert — keine Account-Ebene, keine Weitergabe an
            Dritte. Die Leute, mit denen ihr das Konzept besprecht, stehen
            später auch am Set und sitzen im Schnitt. Vom Studio im
            Rheinauhafen aus drehen wir in Köln, bundesweit und auf Anfrage
            international.
          </p>
        </Streublock>

        <!-- ENTWURF: Zu den Räumen lagen keine Angaben vor. Der Text sagt
             deshalb nur, was auf den Bildern zu sehen ist — kein Baujahr,
             keine Quadratmeter. -->
        <Streublock nr="02" seite="links" bilder={krafthaus} label="Unsere Räume im Krafthaus" hoehe={0.95}>
          <p>
            Unsere Räume liegen im <strong>Krafthaus am Rheinauhafen</strong>:
            gelber Backstein, Rundbogenfenster, hohe Decken. Hier entstehen
            Konzept und Schnitt — und wenn ein Set klein genug ist, wird auch
            hier gedreht.
          </p>
          <p>
            Vor der Tür liegt die Stadt, dahinter der Rhein. Kurze Wege zum
            nächsten Dreh und kurze Wege zueinander.
          </p>
        </Streublock>
      </div>
    </div>
  </section>

  <!-- ═══ 7 · DREI GRÜNDE ════════════════════════════════════════════════ -->
  <section class="section benefits" aria-labelledby="benefits-title">
    <div class="container">
      <!-- Ohne große Überschrift: "Drei Gründe, uns anzurufen" ist
           verworfen, der Abschnitt trägt jetzt nur noch die Marginalie.
           Sie steht als h2 und nicht als p — die drei Punkte darunter sind
           h3, ohne h2 dazwischen bliebe eine Lücke in der Gliederung, und
           aria-labelledby des Abschnitts braucht ein Ziel. Aussehen
           unverändert, das trägt die Klasse .label. -->
      <header class="sec-head sec-head--nur-marke" data-reveal>
        <h2 class="label" id="benefits-title">Warum <span class="brand">Le Werk</span></h2>
      </header>

      <ol class="benefits__list">
        <li class="benefit" data-reveal>
          <span class="benefit__num" aria-hidden="true">01</span>
          <h3 class="benefit__title">Content darf gut aussehen</h3>
          <p class="benefit__text">
            Hochwertig produzierte Visuals in Bild und Bewegtbild — mit den
            Maßstäben an Licht, Bildgestaltung und Postproduktion, die eine
            Kampagne verlangt.
          </p>
        </li>
        <li class="benefit" data-reveal data-reveal-delay="80">
          <span class="benefit__num" aria-hidden="true">02</span>
          <h3 class="benefit__title">Inhaltlicher Impact</h3>
          <p class="benefit__text">
            Redaktionelle Tiefe, ehrlich erzählte Geschichten, menschliche
            Momente — interviewbasiert und dokumentarisch, mit Blick für
            Charaktere.
          </p>
        </li>
        <li class="benefit" data-reveal data-reveal-delay="160">
          <span class="benefit__num" aria-hidden="true">03</span>
          <h3 class="benefit__title">Social First</h3>
          <p class="benefit__text">
            Social ist bei uns der Anfang der Planung und nicht der letzte
            Schritt der Verwertung. Was im Feed läuft, ist dafür gemacht —
            nicht dafür übriggeblieben.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══ 8 · FAQ ═══════════════════════════════════════════════════════ -->
  <!-- Beige statt Weiß: Vorher grenzten zwei weiße Flächen aneinander und
       der Abschnittswechsel war nicht zu erkennen. -->
  <section class="section section--sand faq" aria-labelledby="faq-title">
    <div class="container faq__grid">
      <header class="faq__head" data-reveal>
        <p class="label">Häufige Fragen</p>
        <h2 class="headline" id="faq-title">Kurz beantwortet</h2>
      </header>

      <div class="faq__list" data-reveal data-reveal-delay="80">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span set:html={f.q} />
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq__a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 9 · BOTTOM-CTA ════════════════════════════════════════════════ -->
  <section class="section section--dark cta" aria-labelledby="cta-title">
    <div class="container cta__inner" data-reveal>
      <h2 class="headline headline--xl cta__title" id="cta-title">
        <span class="editorial editorial--kicker">Erzählt uns</span>{' '}
        von eurem Projekt
      </h2>
      <div class="cta__actions">
        <a class="btn btn--on-dark" href={withBase("/kontakt")}>
          Projekt anfragen <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="mailto:contact@lewerk.de">contact@lewerk.de</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Der gemeinsame Sektionskopf .sec-head steht in global.css — er wird
     inzwischen auch von den Projektseiten gebraucht, und Astro-Styles
     gelten nur in der Datei, in der sie stehen. */

  /* ── 1 · Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    /* Der untere Wert setzt den Text über der Unterkante. Er ist zweimal
       gewachsen: 10vh ließen ihn 80px über dem Rand sitzen und damit fast
       auf dem Scroll-Pfeil, 13.5vh gaben 108px. Jetzt 17vh — der Satz
       steht deutlich über der Mitte der unteren Hälfte und lässt mehr
       Video frei. */
    padding-block: clamp(8rem, 18vh, 12rem) clamp(6.5rem, 17vh, 11.5rem);
    background: var(--petrol-deep);
    color: var(--on-dark);
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: 0; z-index: 0; }

  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ohne jeden Filter. Er lag zuletzt bei brightness(0.92), davor bei
       0.82 — beides nahm dem Material Licht, das es nicht hergeben muss.
       Die Lesbarkeit trägt allein der Verlauf darunter, und der sitzt da,
       wo die Schrift steht, statt über dem ganzen Bild. Nebenbei fällt
       damit eine Filterebene über einem formatfüllenden Video weg. */
  }

  .hero__media::after { content: ''; position: absolute; inset: 0; }

  /* Lesbarkeitsverlauf in neutralem Schwarz statt in Petrol: Ein farbiger
     Verlauf legt sich als Stich über das ganze Material und verfälscht die
     Farben der Aufnahme. Schwarz dunkelt ab, ohne einzufärben.
     Die Werte sind über mehrere Videoframes gemessen, nicht geschätzt.

     Zweimal zurückgenommen, damit mehr vom Video zu sehen ist. Der Fuß
     lief 0.90 → 0.82 → 0.72, die obere Kante 0.40 → 0.24 → 0.14, die
     Mitte ist inzwischen ganz offen. Der Verlauf sitzt nur noch dort, wo
     die Schrift steht. */
  .hero__media::after {
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.32) 24%, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.14) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.48) 0%, rgba(0, 0, 0, 0.1) 42%, rgba(0, 0, 0, 0) 64%);
  }

  /* Auf schmalen Schirmen steht der Satz sechszeilig statt zweizeilig und
     reicht damit bis auf 35 % der Höhe hinauf — dort war der Verlauf schon
     fast offen und der Kontrast fiel auf 2.8:1. Der Verlauf greift hier
     deshalb höher. Der seitliche fällt weg: Der Satz nimmt die volle
     Breite ein, eine linke Kante gibt es nicht mehr abzudunkeln. */
  @media (max-width: 63.999rem) {
    .hero__media::after {
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.46) 30%, rgba(0, 0, 0, 0.1) 55%, rgba(0, 0, 0, 0) 72%, rgba(0, 0, 0, 0.12) 100%);
    }
  }

  /* Randabstand wie im Header, damit Text und Logo auf einer Achse sitzen */
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: var(--edge);
  }

  /* Rollentrennung wie im Rest der Seite: Die Wortmarke bleibt Poppins
     ExtraBold (Klasse .brand, unverändert), der Satz selbst ist Redaktion
     und damit Bodoni. Der kursive Schluss trägt die Behauptung. */
  .hero__statement {
    max-width: 30ch;
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: clamp(1.625rem, 3.4vw, 3.125rem);
    line-height: 1.14;
    letter-spacing: -0.005em;
    color: var(--on-dark);
    text-wrap: pretty;
  }

  .hero__statement em { font-style: italic; }


  .hero__cue {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 6vh, 3.5rem);
    z-index: 1;
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    animation: cue 2.4s var(--ease-out) infinite;
  }

  @keyframes cue {
    0%, 100% { transform: translateY(0); opacity: 0.75; }
    50%      { transform: translateY(6px); opacity: 1; }
  }

  /* ── 2 · Trustbar ─────────────────────────────────────────────────────── */
  /* Der Logostreifen hat oben und unten eigenen Rand — deshalb hier
     weniger Abstand, sonst reißt die Sektion auseinander. */
  .trust__label { margin-bottom: 0; }
  .trust .marquee { margin-block: calc(var(--space-2) * -1); }

  .marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    align-items: center;
    /* muss 0 bleiben: Der Track wandert um 50 % seiner Breite. Ein Abstand
       zwischen den beiden Kopien würde diese Rechnung verschieben und die
       Schleife sichtbar springen lassen. Der Streifen bringt seinen
       Randabstand selbst mit. */
    gap: 0;
    width: max-content;
    animation: marquee 40s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track { animation-play-state: paused; }

  @keyframes marquee {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  /* Höhe steuert die Größe, die Breite folgt dem Seitenverhältnis 12,5:1.
     Die Logos sitzen mit Luft im Streifen, deshalb ist er höher als die
     Logos selbst wirken. */
  .marquee__strip {
    height: clamp(80px, 9vw, 128px);
    width: auto;
    max-width: none;
    opacity: 0.72;
    transition: opacity var(--dur) var(--ease-out);
  }

  .marquee:hover .marquee__strip { opacity: 1; }

  /* ── 2 · Positionierung ───────────────────────────────────────────────── */
  .statement { padding-block: clamp(4.5rem, 10vw, 8.5rem); }

  .statement__inner { text-align: center; }

  /* Rollentrennung wie im Hero: Wortmarke Poppins ExtraBold (.brand),
     der Satz selbst Bodoni, der kursive Schluss trägt die Behauptung.
     Der Text ist länger als der Satz davor, deshalb etwas kleiner und
     breiter gesetzt — die Wirkung kommt hier aus der Staffelung. */
  .statement__text {
    margin-inline: auto;
    max-width: 34ch;
    font-family: var(--font-editorial);
    font-weight: 400;
    /* Die Untergrenze ist auf 1.5rem gesetzt, damit "Filmemachern. Le Werk"
       als unteilbarer Block auf schmalen Schirmen Luft in der Spalte hat.
       Bei 1.625rem waren es gemessen 2px — ein Gerät mit etwas breiterer
       Schriftwiedergabe hätte den Block aus der Spalte laufen lassen. */
    font-size: clamp(1.5rem, 4.2vw, 3.25rem);
    /* 1.1 war der Display-Durchschuss des alten Kurzsatzes. Auf dem Handy
       stehen hier mehr Zeilen — das braucht etwas mehr Luft. */
    line-height: 1.16;
    letter-spacing: -0.005em;
    /* Auf schmalen Schirmen sind es acht Zeilen. Dort greift balance nicht
       mehr — Chrome wendet es nur bis etwa sechs Zeilen an, gemessen blieb
       "Content." als Schusterjunge mit 28% Zeilenbreite allein stehen.
       pretty kennt diese Grenze nicht und füllt die Schlusszeile auf 58%.
       Ab 48rem übernimmt balance, weil es die vier Zeilen gleichmäßig
       ausgleicht. */
    text-wrap: pretty;
    /* In dieser Größe ist eine Silbentrennung deutlich sichtbar und wirkt
       wie ein Fehler — der Satz darf lieber eine Zeile länger werden. */
    hyphens: none;
  }

  .statement__text em { font-style: italic; }

  /* AUSNAHME von der Wortmarken-Regel, ausdrücklich so gewünscht: In
     diesem einen Absatz läuft "Le Werk" komplett in der Schrift des
     Absatzes mit — Bodoni Moda, aufrecht, im selben Schnitt und derselben
     Laufweite wie der Text drumherum. Der Hero direkt darüber trägt die
     Marke bereits in Poppins ExtraBold; hier soll der Satz ohne Bruch
     durchlaufen. Der Weg war Poppins 800 → 600 → 400 → Absatzschrift.
     Gilt nur in diesem Absatz — überall sonst bleibt .brand die Wortmarke
     in Poppins ExtraBold, siehe die Regel in global.css.
     Was aus .brand bleibt: white-space: nowrap, damit "Le" und "Werk"
     nie auf zwei Zeilen fallen. */
  .statement__text .brand {
    font-family: inherit;
    font-weight: inherit;
    font-style: inherit;
    letter-spacing: inherit;
  }

  /* Gesperrte Versalzeile als Gegengewicht zur großen Serifenschrift */
  .statement__meta {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* ── 4 · Arbeiten ─────────────────────────────────────────────────────── */
  /* Nur noch die Überschrift im Kopf: Der Kasten war zweispaltig angelegt
     (Überschrift links, Einleitung rechts). Ohne die Einleitung hätte die
     Überschrift in einer 1,35fr-Spalte gesessen und rechts wäre eine leere
     Spalte offen geblieben. */
  .work__head { margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }

  /* Eine Spalte. Zwischenzeitlich standen die beiden Hochformate hier zu
     zweit nebeneinander, weil sie über die volle Breite je 690px hoch
     sind und direkt hintereinander lagen. Seit Video und Foto abwechseln,
     liegt zwischen ihnen ein Querformat — der Scrollweg ist damit
     gebrochen und jedes Reel darf voll stehen. */
  .work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .work__link { display: block; text-decoration: none; color: inherit; }

  .work__figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.06);
  }

  .work__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 9;
    transition: transform 600ms var(--ease-out);
  }

  .work__figure[data-format='4:3'] img { aspect-ratio: 4 / 3; }
  .work__figure[data-format='4:5'] img { aspect-ratio: 4 / 5; }
  .work__figure[data-format='9:16'] img { aspect-ratio: 9 / 16; }
  .work__figure[data-format='3:2'] img { aspect-ratio: 3 / 2; }

  .work__link:hover .work__figure img { transform: scale(1.035); }

  /* Lesbarkeitsverlauf unter den Tags. Vorher trug der Schatten allein, und
     der zählt für den Kontrast nicht — er ist weich, keine deckende Fläche.
     Nachgemessen auf den Zeilenkästen der Schrift lagen drei von vier Tags
     unter der Grenze: Kampagne 1.11:1, Vertikal 1.36:1, Social Video 2.05:1
     bei 3.0 als Minimum für große fette Schrift.
     Mit diesem Verlauf: Kampagne 4.51, Social Video 10.34, Vertikal 10.75,
     Fotografie 16.39 — auch über der strengeren Schwelle von 4.5 und mit
     Reserve für echte Projektbilder, die noch kommen. */
  .work__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      0deg,
      rgba(4, 37, 44, 0.95) 0%,
      rgba(4, 37, 44, 0.66) 32%,
      rgba(4, 37, 44, 0) 60%
    );
  }

  .work__tag { z-index: 1; }

  .work__tag {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: clamp(1.25rem, 3vw, 2.25rem);
    line-height: 1;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }

  /* Projektname links, Format rechts. Der Kunde steht groß im Bild darüber.
     baseline statt center: Die Pille ist kleiner gesetzt als der Titel,
     an der Mittelachse ausgerichtet stünde sie sichtbar zu hoch. */
  .work__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: var(--space-2);
    font-size: var(--fs-small);
  }

  .work__titel { font-weight: 600; }

  /* margin-left: auto drückt die Pille an die rechte Kante der Kachel —
     dadurch steht sie über alle fünf Kacheln hinweg bündig, obwohl die
     Titel unterschiedlich lang sind. */
  .work__format {
    margin-left: auto;
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    line-height: 1.6;
    white-space: nowrap;
    color: var(--on-dark-muted);
  }

  /* ── 5 · Disziplinen ──────────────────────────────────────────────────── */
  /* Bewusst dieselbe Sprache wie die Arbeiten darüber: Bild als Hauptfigur,
     der Name groß im Bild, eine schmale Zeile darunter, versetztes Raster.
     Ein Unterschied ist nötig — die Arbeiten liegen auf dunklem Grund und
     ihre Motive sind dunkel, hier stehen helle Motive auf Sand. Weiße
     Schrift braucht deshalb einen Verlauf unter sich. */
  .disziplinen {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .disziplin__link { display: block; text-decoration: none; color: inherit; }

  .disziplin__bild {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: rgba(4, 37, 44, 0.06);
  }

  .disziplin__bild img {
    display: block;
    width: 100%;
    /* Jede Disziplin in ihrem eigenen Format — kommt aus den Daten */
    aspect-ratio: var(--ratio);
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: transform 600ms var(--ease-out), filter var(--dur-slow) var(--ease-out);
  }

  .disziplin__link:hover .disziplin__bild img,
  .disziplin__link:focus-visible .disziplin__bild img {
    transform: scale(1.035);
    filter: grayscale(0) contrast(1);
  }

  /* Lesbarkeitsverlauf, auf den echten Motiven gemessen statt geschätzt:
     Bild im Cover-Zuschnitt samt Graustufenfilter im Canvas nachgebaut,
     Verlauf darüber, dann der schlechteste Wert auf den Zeilenkästen der
     Schrift. Nach dem Umbau auf zwei Spalten sind die rechten Kästen
     kleiner, die Schrift liegt über anderen Bildstellen und der Fuß von
     0.88 reichte nur noch für 4.36:1 bei Foto. Mit 0.92 sind es
     Foto 5.54, Idee & Konzept 7.87, Video 11.20 — wieder über der
     strengeren Schwelle von 4.5 und mit Reserve für andere Motive. */
  .disziplin__bild::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      0deg,
      rgba(4, 37, 44, 0.92) 0%,
      rgba(4, 37, 44, 0.58) 30%,
      rgba(4, 37, 44, 0) 55%
    );
  }

  .disziplin__marke {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    bottom: clamp(0.875rem, 2.5vw, 1.75rem);
    z-index: 1;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: clamp(1.75rem, 4.4vw, 3.25rem);
    line-height: 1;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
  }

  /* Bildunterschrift im Zuschnitt der Arbeiten: Text links, Hinweis rechts */
  .disziplin__zeile {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem var(--space-3);
    margin-top: var(--space-2);
    font-size: var(--fs-small);
  }

  .disziplin__text { color: var(--ink-muted); max-width: 46ch; }

  .disziplin__mehr {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 700;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--petrol);
  }

  .disziplin__pfeil { transition: transform var(--dur) var(--ease-out); }
  .disziplin__link:hover .disziplin__pfeil { transform: translateX(5px); }


  /* ── 6 · Vorteile ─────────────────────────────────────────────────────── */
  .benefits__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .benefit { border-top: 1px solid var(--line); padding-top: var(--space-3); }

  .benefit__num {
    display: block;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--petrol);
    margin-bottom: var(--space-2);
  }

  .benefit__title {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-1);
    text-wrap: balance;
  }

  .benefit__text { color: var(--ink-muted); }

  /* ── 6 · Unser Team ───────────────────────────────────────────────────── */
  /* Kopf ohne Fließtext — der steht jetzt als breiter Absatz unter den
     Porträts, deshalb hier weniger Abstand nach unten. */
  /* Der Team-Kopf steht enger, weil "UNSER TEAM" kurz ist und die
     Porträts direkt darunter die Fläche übernehmen. */
  .sec-head--knapp { margin-bottom: clamp(1.75rem, 4vw, 3rem); }

  /* Vier Porträts: zwei Spalten auf dem Handy, vier ab 48rem. */
  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team__member { margin: 0; }

  /* Quadratisch statt 2:3. Vier hohe Porträts über die volle Breite waren
     rund 450px hoch und nahmen dem Abschnitt die Ruhe — die Gesichter
     sollen den Text und das Raster darunter einleiten, nicht mit ihnen
     konkurrieren. Im Quadrat sind es 220px.

     Graustufen, Farbe erst bei Hover. Die vier Aufnahmen stammen aus
     verschiedenen Situationen — Studio, Sofa, Loft — und haben jede einen
     eigenen Farbstich. Grau bindet sie zu einer Reihe; die Farbe kommt
     zurück, sobald jemand hinsieht. */
  .team__portrait {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-2);
    filter: grayscale(1);
    transition: filter var(--dur) var(--ease-out);
  }

  .team__member:hover .team__portrait,
  .team__member:focus-within .team__portrait { filter: grayscale(0); }

  /* Ohne Zeigegerät gäbe es die Farbe nie zu sehen — auf dem Handy stehen
     die Porträts deshalb von vornherein farbig. */
  @media (hover: none) {
    .team__portrait { filter: none; }
  }

  .team__name {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--on-dark);
  }

  .team__role {
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
  }

  /* Die beiden Streublöcke stehen mit Abstand untereinander und mit
     Abstand zu den Porträts darüber. Der Rest steckt in
     src/components/Streublock.astro. */
  .team__bloecke {
    display: grid;
    gap: clamp(4rem, 10vw, 8rem);
    margin-top: clamp(3.5rem, 8vw, 6rem);
  }

  /* ── 10 · FAQ ─────────────────────────────────────────────────────────── */
  .faq__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .faq__head .label { margin-bottom: var(--space-2); }

  .faq__item { border-top: 1px solid var(--line); }
  .faq__item:last-child { border-bottom: 1px solid var(--line); }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 56px;
    padding-block: var(--space-2);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker { display: none; }

  .faq__icon { position: relative; flex-shrink: 0; width: 20px; height: 20px; }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    background: var(--petrol);
    transition: transform var(--dur) var(--ease-out);
  }

  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }

  .faq__a {
    padding-bottom: var(--space-3);
    color: var(--ink-muted);
    max-width: 58ch;
  }

  /* ── 11 · Bottom-CTA ──────────────────────────────────────────────────── */
  .cta { text-align: center; }
  .cta__inner { display: grid; justify-items: center; gap: var(--space-3); }
  .cta__title { max-width: 16ch; }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  /* ── Breakpoints ──────────────────────────────────────────────────────── */
  @media (min-width: 48rem) {
    .statement__text { text-wrap: balance; }
    .benefits__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    /* Vier Quadrate über die volle Breite.

       Hier stand eine Deckelung auf 62rem, damit die Porträts rund 220px
       statt 300px groß blieben — eine Reihe Gesichter, keine Wand. Die
       Rechnung ging nicht auf: 62rem sind ein fester Wert, der Container
       wächst mit dem Fenster. Bei 1100px Fensterbreite fehlten der Reihe
       49px zur rechten Kante, bei 1457px schon 390. Auf schmalen Schirmen
       unsichtbar, auf breiten ein Versatz, der wie ein Fehler aussieht —
       zumal der Bildhaufen direkt darunter voll durchläuft.

       Lieber vier größere Gesichter als eine Reihe, die je nach Bildschirm
       woanders aufhört. */
    .team__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .hero__cue { display: inline-flex; }
  }

  @media (min-width: 64rem) {
    .work__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: clamp(3rem, 6vw, 5rem);
    }

    /* Sechs Kacheln in drei Reihen, versetzt. Die Plätze sind auf die
       Bildformate der Projekte in src/data/arbeiten.ts zugeschnitten — beim
       Umsortieren mitdenken: ein 9:16 auf Platz 4 wäre über 800px hoch, ein
       3:2 auf Platz 6 nur 167px.

       Die Reihen entstehen von selbst. Astro setzt die Kacheln der Reihe
       nach, und weil sich die Spalten von 1 und 3 überschneiden, rutscht 3
       in die zweite Reihe, 5 in die dritte. Es braucht also keine
       grid-row-Angaben — sie würden nur brechen, sobald ein Projekt
       dazukommt.

       Der Abschnitt ist in drei Teile gebaut und nicht in drei Reihen zu
       zwei. Zwei Fassungen davor waren Paarraster, und beide lasen sich
       als Tabelle — erst mit wilden Größen, dann mit angeglichenen. Das
       Problem war nie die Größe, sondern der gleichbleibende Takt.

       ANFANG (2 Kacheln, schwer)
       Siemens auf fünf Spalten trägt die Sektion an, Revitive auf sechs
       antwortet rechts unten. Ungleich im Format, gleich weit unten — sie
       enden auf derselben Linie.

       MITTE (3 Kacheln)
       Ein Fries: hoch, breit, mittelhoch. Vier, fünf und drei Spalten —
       in jedem Schritt wechseln Format, Breite und Höhe, keine zwei
       Kacheln haben dasselbe Maß (408×725, 521×347, 295×525).

       Ein erster Versuch gab dem Fries 3/5/3 Spalten. Dann waren die
       beiden Hochformate links und rechts gleich groß und rahmten die
       Mitte — ein Altarbild. Mit 4/5/3 fällt die Symmetrie weg, und
       Street One nimmt oben die Breite auf, die BVB unten hat.

       Formel D hängt an der Unterkante, Allianz steht etwas tiefer als
       Street One. Damit liegt keine Ober- und keine Unterkante im Fries
       auf einer Linie.

       SCHLUSS (1 Kachel)
       BVB allein auf vier Spalten, auf Spalte 8 gesetzt — links wie
       rechts mit nichts bündig. Eine einzelne Kachel, die sich an keine
       Kante hängt, liest sich als Schlusspunkt und nicht als angefangene
       Reihe. Dass es eine Nahaufnahme ist, die in die Kamera sieht,
       trägt den Schluss zusätzlich.

       Die Reihen entstehen dabei von selbst: Astro setzt die Kacheln der
       Reihe nach, und wo sich Spalten überschneiden, rutscht die nächste
       eine Reihe tiefer. Es braucht kein grid-row — das würde nur brechen,
       sobald ein Projekt dazukommt. */
    .work__item--1 { grid-column: 1 / span 5; }                   /* Siemens 4:5 */
    .work__item--2 { grid-column: 7 / span 6; align-self: end; }  /* Revitive 3:2 */

    .work__item--3 { grid-column: 1 / span 4; }                   /* Street One 9:16 */
    .work__item--4 { grid-column: 5 / span 5; align-self: end; }  /* Formel D 3:2 */
    .work__item--5 { grid-column: 10 / span 3; }                  /* Allianz 9:16 */

    .work__item--6 { grid-column: 8 / span 4; }                   /* BVB 9:16 */

    /* Der Versatz im Fries. margin-top und nicht transform: Die Kachel
       soll den Platz, den sie einnimmt, auch beanspruchen — sonst liefe
       der Schlussteil in sie hinein. */
    .work__item--5 { margin-top: clamp(2rem, 4vw, 4rem); }

    /* Zwei Spalten: Video links über beide Zeilen, Idee & Konzept rechts
       oben, Foto rechts unten. */
    .disziplinen {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: clamp(2rem, 4vw, 3rem);
    }

    .disziplin--1 { grid-column: 1 / span 6; grid-row: 1 / span 2; }
    .disziplin--2 { grid-column: 8 / span 5; grid-row: 1; }
    .disziplin--3 { grid-column: 8 / span 5; grid-row: 2; }

    /* Der linke Kasten bekommt keine feste Bildhöhe, sondern füllt exakt
       das, was die beiden rechten zusammen hoch sind. Mit einem festen
       Seitenverhältnis bliebe sonst je nach Textlänge unten ein Rest übrig
       oder das Bild stünde über. */
    .disziplin--1 .disziplin__link {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .disziplin--1 .disziplin__bild { flex: 1; min-height: 0; }

    .disziplin--1 .disziplin__bild img {
      height: 100%;
      aspect-ratio: auto;
    }

    /* Ab hier drei Spalten wie in der Referenz. Darunter zwei, damit die
       Bilder auf dem Handy nicht zu Briefmarken werden. */

    .faq__grid { grid-template-columns: 0.8fr 1.2fr; gap: clamp(3rem, 6vw, 6rem); }
    .faq__head { position: sticky; top: 7rem; }
  }

  /* ── Reduced Motion ───────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    /* Ohne Laufband bliebe ein Großteil der Logos unsichtbar. Statt den
       Streifen zu stauchen, wird er von Hand scrollbar. */
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__track { animation-name: none; }
    .marquee__track img[aria-hidden='true'] { display: none; }
    .hero__cue { animation-name: none; }
  }
</style>

<script>
  // Ein Video lässt sich per CSS nicht anhalten. Wer reduzierte Bewegung
  // angefordert hat, bekommt deshalb ein Standbild statt der Schleife.
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;

  if (heroVideo) {
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');

    const anwenden = () => {
      if (ruhig.matches) {
        heroVideo.removeAttribute('autoplay');
        heroVideo.loop = false;
        heroVideo.pause();
      } else {
        heroVideo.loop = true;
        // play() kann abgelehnt werden, etwa im Energiesparmodus —
        // dann bleibt schlicht das erste Bild stehen.
        void heroVideo.play().catch(() => {});
      }
    };

    anwenden();
    ruhig.addEventListener('change', anwenden);
  }
</script>
