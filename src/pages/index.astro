---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { arbeiten } from '../data/arbeiten';
import { withBase } from '../lib/paths';

// Der Dateiname des Bühnenvideos ist bewusst neutral gehalten: Er steht im
// Quelltext jeder Seite, und laut Markenarchitektur wird die Schwestermarke
// ausschließlich im Impressum genannt. Details in docs/bildmaterial.md.

// Die Kundenlogos, einzeln statt als ein Streifenbild. Für die
// Endlosschleife läuft die Liste zweimal hintereinander; der Track wandert
// um exakt eine Listenbreite, dadurch ist der Übergang nahtlos. Das setzt
// voraus, dass der Abstand zwischen den Logos im Logo selbst steckt — als
// padding an .marquee__logo und nicht als gap am Track. Ein gap läge auch
// zwischen den beiden Kopien und würde die Rechnung um genau einen Abstand
// verschieben; die Schleife spränge sichtbar.
//
// Die Größe steckt nicht in diesen Daten, sondern in einem Kasten im CSS:
// Jedes Logo bekommt dieselbe Höchstbreite und dieselbe Höchsthöhe und
// wächst darin so weit, wie es sein Seitenverhältnis zulässt. Breite
// Wortmarken stoßen an die Breite, hohe Bildmarken an die Höhe.
//
// Das ist die Ordnung, die der frühere Streifen hatte — nachgemessen an
// dessen Bilddatei: Siemens, Douglas, Street One und Seven.One standen
// dort alle zwischen 80 und 120px breit, Zehnder als einzige hohe Marke
// bei 63 x 54. Auf gleiche Höhe gebracht wären die Wortmarken dreimal so
// schwer wie die Bildmarken.
//
// b und h sind die Maße der freigestellten Dateien und stehen nur wegen
// des width/height-Attributs hier — sie verhindern, dass die Zeile beim
// Laden springt. Freigestellt heißt: auf den Kasten beschnitten, in dem
// überhaupt Farbe steht. Die Lieferung hatte sehr unterschiedlich viel
// durchsichtigen Rand — Siemens stand in einem 2400er Quadrat, in dem die
// Wortmarke nur 364px hoch war.
//
// url führt auf die Seite des Unternehmens. Jede Adresse ist per Abruf
// geprüft; zwei Anmerkungen dazu:
//
//   douglas.de   antwortet einem Abruf ohne Browser mit 400. Das ist ein
//                Bot-Schutz, keine tote Adresse — DNS, TLS und die
//                Umleitung auf www greifen. douglas.com wäre falsch, die
//                Adresse führt zu einer gleichnamigen Firma in Kanada.
//   olympics.com bricht denselben Abruf ab, ist aber belegt: olympic.org
//                leitet mit 301 genau dorthin.
//
// Wo es eine deutsche Fassung gibt, steht sie hier — siemens.de leitet
// sauber auf siemens.com/de-de.
// Bezugskasten für die Leiste. Der Wert steht hier und in .marquee als
// --logo-breite; das Verhältnis 2.35 verbindet beide.
const LOGO_VERHAELTNIS = 94 / 40;

// Wie breit ein Logo im Verhältnis zur vollen Kastenbreite läuft. Breite
// Wortmarken bekommen die ganze Breite, hohe Bildmarken so viel, wie ihre
// Höhe zulässt.
//
// Gerechnet statt eingetragen, damit der Wert beim Austausch einer Datei
// nicht veraltet — er hängt nur an b und h.
//
// Warum überhaupt je Logo: Eine feste Kastenbreite für alle sah aus wie
// unterschiedliche Abstände. Ein schmales Logo saß mittig in einem 94px
// breiten Kasten und brachte bis zu 55px Leerraum mit, der sich zur Lücke
// addierte — gemessen zwischen 38px und 87px. Und der naheliegende Weg
// über max-width geht nicht: Bindet max-width, rechnet der Browser die
// Höhe nicht zurück, die Wortmarken werden auf volle Kastenhöhe gezogen.
//
// weite ist die Ausnahme von der Regel und steht deshalb je Logo in den
// Daten, nicht hier: Sie lässt eine Marke breiter laufen als den Kasten.
// Gebraucht wird das von den beiden längsten Wortmarken, Johnson &
// Johnson und HUGO BOSS — jenseits von etwa 7 : 1 fällt ein Logo im
// Kasten unter 12px Höhe und damit unter die übrigen Wortmarken.
const logoBreite = (k) =>
  (Math.min(1, k.b / k.h / LOGO_VERHAELTNIS) * (k.weite ?? 1)).toFixed(4);

const kunden = [
  { datei: 'siemens',     name: 'Siemens',                      url: 'https://www.siemens.de/',          b: 330, h:  51 },
  { datei: 'street-one',  name: 'Street One',                   url: 'https://www.street-one.de/',       b: 330, h:  48 },
  { datei: 'douglas',     name: 'Douglas',                      url: 'https://www.douglas.de/',          b: 330, h:  61 },
  { datei: 'allianz',     name: 'Allianz',                      url: 'https://www.allianz.de/',          b: 330, h:  86 },
  { datei: 'olympia',     name: 'Olympische Spiele',            url: 'https://www.olympics.com/',        b: 252, h: 118 },
  { datei: 'paralympics', name: 'Paralympisches Komitee',       url: 'https://www.paralympic.org/',      b: 192, h: 141 },
  { datei: 'ea',          name: 'EA',                           url: 'https://www.ea.com/de-de',         b: 159, h: 160 },
  { datei: 'formel-d',    name: 'Formel D',                     url: 'https://www.formeld.com/de/',      b: 189, h: 143 },
  { datei: 'sevenone',    name: 'Seven.One Entertainment Group', url: 'https://www.seven.one/',           b: 330, h:  74 },
  { datei: 'zehnder',     name: 'Zehnder Group',                url: 'https://www.zehndergroup.com/',    b: 171, h: 152 },
  // Zweite Marke mit weite: 8,3 : 1, im Kasten 10px hoch und damit die
  // kleinste Schrift der Leiste — kleiner als Johnson & Johnson nach
  // deren Korrektur, was die Reihenfolge der Ausnahmen auf den Kopf
  // stellen würde. 1.19 hebt sie auf dieselben 12px, sie läuft dafür
  // 100px breit statt 84.
  { datei: 'hugo-boss',   name: 'HUGO BOSS',                    url: 'https://www.hugoboss.com/de/',     b: 200, h:  24, weite: 1.19 },
  // Mit 10,7 : 1 die mit Abstand breiteste Marke; im Kasten käme sie auf
  // 8px Höhe — halb so hoch wie Douglas und kaum noch lesbar. Der Faktor
  // 1.52 hebt sie auf 12px und damit auf dieselbe Höhe wie Street One.
  // Sie läuft dafür 128px breit statt 84; das ist der Preis und bei einer
  // so langen Wortmarke vertretbar.
  { datei: 'johnson-johnson', name: 'Johnson & Johnson',        url: 'https://www.jnj.com/de-de',        b: 330, h:  31, weite: 1.52 },
];

// Die fünf Projekte liegen in src/data/arbeiten.ts, weil die Unterseiten
// unter /arbeiten/<slug> dieselben Angaben brauchen.

// Auf der Startseite erscheinen nur die drei Produktionsdisziplinen.
// Workshops bleiben über Menü, Footer und /services erreichbar.
//
// Eigene Reihenfolge, weil die Kästen hier anders liegen: Video groß links,
// Idee & Konzept rechts oben, Foto rechts unten. Sie steht über die Adresse
// und nicht über den Listenplatz — sonst würde eine Umsortierung in
// services.ts das Layout still verschieben.
const reihenfolge = ['/services/video', '/services/konzept', '/services/foto'];
const disziplinen = services
  .filter((s) => s.disziplin)
  .sort((a, b) => reihenfolge.indexOf(a.href) - reihenfolge.indexOf(b.href));

// Die Kulisse unter den Porträts: zwölf Aufnahmen aus dem Studio und vom
// Set, dazwischen die beiden Sätze, die den Abschnitt tragen.
//
// AUFBAU. Vier Spalten, die Reihen versetzt. Die beiden Textfelder stehen
// dort, wo sonst ein Bild stünde, und laufen über zwei Spalten — nicht
// neben dem Bilderfeld, sondern darin. Jeder Satz sitzt zwischen den
// Aufnahmen, die zu ihm gehören:
//
//   Satz 01 (Team)      zwischen den Set-Aufnahmen, Reihe 1
//   Satz 02 (Köln)      zwischen den Haus-Aufnahmen, Reihe 4
//
// Der Platz jedes Stücks entsteht von selbst — der Browser setzt sie der
// Reihe nach, ein Textfeld belegt zwei Plätze. Die Spalte wird im
// Frontmatter mitgezählt (siehe kulisse weiter unten), weil der Versatz
// je Spalte daran hängt. Wer umsortiert, muss nichts nachziehen.
//
// FORMATE. Zwei statt sechs, wie bei Featured Work: Was quer aufgenommen
// ist, steht als 4:3, was hoch aufgenommen ist, als 3:4. Die wahren
// Seitenverhältnisse (3:2, 2:3, 5:4, 3:4) ließen die Reihen so ungleich
// laufen, dass der Versatz nicht mehr als Muster lesbar wäre.
//
// Die frühere Fassung — zwei Streublöcke mit je einem Haufen aus sechs
// überlappenden Stücken und dem Text daneben, jedes Stück mit x/y/w/z und
// einem aus der Lage gerechneten Streuweg — ist damit abgelöst. Ihre
// Maße stehen in der Git-Historie.
//
// DIE BESCHRIFTUNGEN SIND MEINE FORMULIERUNG und benennen nur, was zu
// sehen ist. Sie stehen hier an einer Stelle und lassen sich austauschen,
// ohne das Layout anzufassen. Eine Jahreszahl steht bewusst nicht dabei —
// die ist zu keiner der Aufnahmen bekannt; die laufende Nummer nimmt
// ihren Platz ein.
//
// Von den zwölf gelieferten BTS-Dateien sind sechs nicht verwendet: vier
// sind private Aufnahmen, zwei zeigen dasselbe Studio wie bts-studio, nur
// enger. Die sechs Haus-Aufnahmen kommen unverändert vom Kunden.
const kulisseRoh = [
  { img: '/images/bts/bts-halle.jpg',       hoch: false, pille: 'Dreh',      titel: 'Werkhalle',            alt: 'Dreiköpfiges Team in einer Werkhalle: einer beugt sich über die Kamera auf dem Stativ, dahinter ein Monitorplatz und eine Softbox' },
  { img: '/images/bts/bts-transporter.jpg', hoch: true,  pille: 'Unterwegs', titel: 'Zwischen zwei Sets',   alt: 'Zwei Frauen sitzen mit einem Laptop im Transporter, die Schiebetür steht offen, dahinter eine Tankstelle' },
  {
    // Satz 01 — steht zwischen den Set-Aufnahmen, weil er von der
    // Zusammensetzung des Teams spricht.
    text: 'team',
    vorspann: 'Erfahrung aus hunderten Produktionen:',
    laenge: 21.7,
    satz: 'Wir kombinieren ein schlagkräftiges Kernteam mit kreativen Spezialisten aus verschiedenen Feldern.',
  },
  { img: '/images/bts/bts-loft.jpg',        hoch: false, pille: 'Dreh',      titel: 'Körperstativ im Loft', alt: 'Zwei Personen an einer Kamera auf dem Körperstativ in einem hellen Studio' },
  { img: '/images/bts/bts-schnitt.jpg',     hoch: true,  pille: 'Post',      titel: 'Schnittplatz',         alt: 'Zwei Personen am Schnittplatz vor mehreren Monitoren, daneben ein Fenster mit Zimmerpflanzen' },
  { img: '/images/bts/bts-studio.jpg',      hoch: false, pille: 'Dreh',      titel: 'Aufbau vor Blau',      alt: 'Studioaufbau vor blauer Wand: ein weißer Hocker, zwei Kameras auf Stativen, Softboxen und eine Tonangel über orangem Bodenband' },
  { img: '/images/bts/bts-buero.jpg',       hoch: false, pille: 'Haus',      titel: 'Petrolwand',           alt: 'Zwei Männer vor einer petrolfarbenen Bürowand, davor ein schwarz abgedecktes Gerät' },

  { img: '/images/krafthaus/haus-01.jpg',     hoch: false, pille: 'Haus',      titel: 'Krafthaus am Abend', alt: 'Das Krafthaus im Abendlicht, dahinter das Kranhaus am Rheinauhafen' },
  { img: '/images/krafthaus/haus-03.jpg',     hoch: true,  pille: 'Haus',      titel: 'Empfang',            alt: 'Grüner Sessel vor weißer Wand, daneben ein Sideboard mit Lampe und ein Alukoffer' },
  { img: '/images/krafthaus/haus-02.jpg',     hoch: false, pille: 'Unterwegs', titel: 'Auf dem Weg',        alt: 'Schwarzweiß: leere Autobahn mit Leitplanke und Waldrand' },
  { img: '/images/krafthaus/haus-05.jpg',     hoch: false, pille: 'Unterwegs', titel: 'Raststätte',         alt: 'Sattelzug an einer Raststätte unter blauem Himmel' },
  {
    // Satz 02 — steht zwischen den Haus-Aufnahmen, weil er vom Ort
    // spricht.
    text: 'ort',
    vorspann: 'Based in Köln, booked worldwide:',
    laenge: 18.3,
    satz: 'Unsere Räumlichkeiten liegen im Krafthaus, im Rheinauhafen. Gedreht wird in Köln, bundesweit oder auch international.',
  },
  { img: '/images/krafthaus/haus-06.jpg',     hoch: true,  pille: 'Haus',      titel: 'Feierabend',         alt: 'Mehrere Personen an Biertischen vor einem Lokal, eine Person lacht in die Kamera' },
  { img: '/images/krafthaus/haus-drohne.jpg', hoch: false, pille: 'Haus',      titel: 'Rheinauhafen',       alt: 'Luftaufnahme des Krafthauses im Rheinauhafen: Backsteinbau mit Schieferdach, daneben Kopfsteinpflaster und die Nachbargebäude' },
];

// Die Spalte je Stück, nach derselben Regel, nach der der Browser die
// Plätze vergibt: der Reihe nach, und was nicht mehr in die angefangene
// Reihe passt, beginnt die nächste. Ein Textfeld belegt zwei Plätze.
//
// Gerechnet statt eingetragen, weil der Versatz je Spalte daran hängt —
// eine eingetragene Spaltenzahl wäre nach der ersten Umsortierung falsch,
// ohne dass es jemandem auffiele.
//
// Die laufende Nummer zählt nur die Aufnahmen; die beiden Textfelder
// tragen keine.
const KULISSE_SPALTEN = 4;
let kulisseLauf = 0;
let kulisseNr = 0;
const kulisse = kulisseRoh.map((k) => {
  const breite = k.text ? 2 : 1;
  const inReihe = kulisseLauf % KULISSE_SPALTEN;
  if (inReihe + breite > KULISSE_SPALTEN) kulisseLauf += KULISSE_SPALTEN - inReihe;
  const spalte = (kulisseLauf % KULISSE_SPALTEN) + 1;
  kulisseLauf += breite;
  return { ...k, spalte, nr: k.text ? null : String(++kulisseNr).padStart(2, '0') };
});

// Vier Plätze, alle vier echt. Der Zuschnitt steckt in der Datei und
// nicht im CSS, weil die Aufnahmen quer oder hoch sind und die Personen
// klein im Raum zeigen — ein Beschnitt per object-fit hätte sie nur
// verschoben, nicht näher herangeholt.
//
// ZWEI MASSE HALTEN DIE REIHE ZUSAMMEN, und beide sind nachgemessen:
//
//   AUGENLINIE 44 %   Die Augen liegen bei allen vier auf 44 Prozent der
//                     Kachelhöhe. Vorher lagen sie zwischen 22 und 37 —
//                     der Blick sprang beim Wechsel um rund 45px.
//
//   KOPFHÖHE 178 px   Vom Scheitel bis zum Kinn, gerechnet auf die
//                     Anzeigegröße von 304px. Gemessen liegen die vier
//                     bei 177 bis 179, also innerhalb von einem Prozent.
//
// Das zweite Maß ist das jüngere. Eine gemeinsame Augenlinie allein
// reicht nicht: Danach lagen die Augen zwar auf einer Linie, die Köpfe
// waren aber 92 bis 174px hoch — Joschas fast doppelt so groß wie Cems.
// Die Reihe las sich als vier verschiedene Aufnahmen, nicht als ein Satz.
//
// Die Grenzen für die beiden Werte:
//
//   nach unten   Cem für die Augenlinie: Bei ihm liegen zwischen Scheitel
//                und Augen 59 Prozent der Kopfhöhe, tiefer angesetzt
//                stößt er oben an. Bei 44 Prozent bleiben ihm 33px Luft.
//   nach oben    Joscha für die Kopfhöhe: Seine Quelle ist nur 1086px
//                breit, der Ausschnitt schöpft sie fast aus. Kleiner als
//                177 lässt sich sein Kopf nicht mehr schneiden.
//
// Eine dritte Grenze ist entfallen: Von Philipp gab es lange nur die
// 700er Webfassung, sein Ausschnitt konnte weder nach unten wandern noch
// weiter aufgezogen werden, und seine Kachel maß deshalb nur 524px. Seit
// dem 4. August 2026 liegt sein Original vor (2880 x 1920), und alle vier
// Kacheln sind 700px groß — bei 304px Anzeige also 2,3-fach.
//
// Wer ein Porträt tauscht, muss den Schnitt mitliefern: quadratisch,
// Augen auf 44 Prozent, Kopf 58 Prozent der Kachelhöhe.
//
// Die Originale liegen alle vier unter quellbilder/team.
//
// Die Rollen sind Doppelnennungen, getrennt durch einen senkrechten
// Strich. Der Strich steht nur noch in den Daten: Die Vorlage teilt an ihm
// und setzt die beiden Hälften untereinander — Begründung bei .team__zeile
// im Stylesheet. Er bleibt hier, weil er die Trennstelle bezeichnet, und
// eine Zeichenkette mit klarer Trennstelle ist leichter zu pflegen als
// zwei Felder.
//
// Zwei Sonderzeichen sind trotzdem nötig:
//
//   U+2011   steht als Bindestrich in "Post‑Production" und
//            "Self‑Shooting" — ein gewöhnlicher Bindestrich ist eine
//            Trennstelle, und Joschas Zeile brach genau dort: "Head of
//            Post-" über "Production". Der Umbruch gehört zwischen die
//            beiden Nennungen, nicht in einen Begriff.
//   U+2009   steht als schmales Leerzeichen um den Strich. Beim Teilen
//            fällt es mit weg; es trägt nur, solange die Zeichenkette
//            ungeteilt irgendwo auftaucht.
const team = [
  { img: '/images/team/philipp-maxhofer.jpg', name: 'Philipp Maxhofer', role: 'Concept | Creative Director', alt: 'Porträt von Philipp Maxhofer im Rollkragenpullover, Studio im Hintergrund' },
  { img: '/images/team/cem-schuch.jpg', name: 'Cem-Pierre Schuch', role: 'Head of Production | Self‑Shooting Director', alt: 'Porträt von Cem-Pierre Schuch in dunkler Sweatjacke, lachend, im Hintergrund ein Sprossenfenster' },
  { img: '/images/team/joscha-ortmeier.jpg', name: 'Joscha Ortmeier', role: 'Head of Post‑Production | Photographer', alt: 'Porträt von Joscha Ortmeier mit Brille, im Hintergrund ein Bücherregal' },
  { img: '/images/team/tom-beckers.jpg', name: 'Tom Beckers', role: 'Producer | Content Creator', alt: 'Porträt von Tom Beckers mit schulterlangem Haar und Schnurrbart, im Hintergrund ein helles Fenster' },
];

// q darf Markup enthalten (Wortmarke), wird unten mit set:html gerendert.
//
// Von zehn Fragen auf fünf gekürzt. Entfallen sind die zu Werbefilm in
// 16:9, Mediaplanung und SEO, Köln als Arbeitsgebiet, Nutzungsrechten
// und Workshops.
//
// Zwei davon trugen die Abgrenzung "was wir nicht machen" — sie steckt
// jetzt nur noch in Frage 2 zu UGC. Wer die Abgrenzung deutlicher will,
// muss sie dort schärfen oder eine der beiden Fragen zurückholen; sie
// stehen in der Git-Historie.
const faqs = [
  { q: 'Was kostet eine Produktion bei <span class="brand">Le Werk</span>?', a: 'Das hängt an Drehtagen, Team und Formatumfang. Kompakte Social-Produktionen starten im mittleren vierstelligen Bereich, größere Kampagnen liegen fünfstellig. Nach einem 20-minütigen Gespräch bekommt ihr eine belastbare Spanne — kein Zahlenraten.' },
  { q: 'Macht ihr auch UGC- oder Handy-Content?', a: 'Nein. Das ist ein anderer Markt mit anderen Preisen und anderem Anspruch. Bei uns entstehen Visuals auf Kampagnenniveau — auch dann, wenn sie am Ende vertikal im Feed laufen. Wer schnellen, günstigen Durchsatz sucht, ist bei uns falsch.' },
  { q: 'Bekommen wir Foto und Video aus einer Produktion?', a: 'Ja, das ist der Kern unserer Arbeitsweise. Wir planen Sets so, dass bewegte und stehende Bilder parallel entstehen. Das spart einen kompletten Produktionstag und sorgt dafür, dass Foto und Video wie eine Kampagne aussehen — nicht wie zwei.' },
  { q: 'Warum denkt ihr vom vertikalen Format aus?', a: 'Weil dort die Aufmerksamkeit liegt. Ein Bildaufbau, der als 16:9 entsteht und später hochkant beschnitten wird, verliert immer — Blickführung, Text und Rhythmus stimmen dann nicht mehr. Wir planen umgekehrt: vertikal als Kern, Landscape und Stills als Ableitung derselben Produktion.' },
  { q: 'Wie lange dauert es von der Anfrage bis zum fertigen Material?', a: 'Für eine kompakte Produktion rechnet mit drei bis vier Wochen: eine Woche Konzept, ein bis zwei Drehtage, ein bis zwei Wochen Post. Bei laufenden Content-Paketen verkürzt sich das deutlich, weil Setup und Look bereits stehen.' },
];
---

<BaseLayout
  title="Le Werk — Visual Content Studio für Video und Fotografie"
  description="Le Werk ist ein Visual Content Studio in Köln: Video und Fotografie auf Kampagnenniveau, vom vertikalen Format aus gedacht. Handwerk mit redaktioneller Substanz — kein UGC, kein Full-Service-Overhead."
  heroDark={true}
>
  <!-- ═══ 1 · HERO ═══════════════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <!-- muted und playsinline sind Bedingung dafür, dass mobile Browser
           überhaupt selbst starten. Die Datei hat keine Tonspur.
           Bei prefers-reduced-motion hält ein Skript das Video an. -->
      <video
        id="hero-video"
        autoplay muted loop playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={withBase('/videos/lewerk-hero.mp4')} type="video/mp4" />
      </video>
    </div>

    <!-- Text sitzt in der unteren linken Ecke und läuft bewusst nicht über
         die ganze Breite. Randabstand = --edge, damit er mit dem Logo im
         Header auf einer Achse liegt.

         Der feste Umbruch nach "studio" teilt den Satz in seine zwei
         Hälften — Gattung vorn, Behauptung hinten. Unter 820px übernimmt
         der natürliche Umbruch, sonst liefe die erste Zeile aus dem Bild. -->
    <div class="hero__inner">
      <h1 class="hero__statement" id="hero-title" lang="en">
        <span class="brand">Le Werk</span> is a visual content studio<br class="hero__br" />
        crafting brand content <em>worth watching.</em>
      </h1>
    </div>

    <a class="hero__cue" href="#positionierung" aria-label="Weiter zum Inhalt scrollen">
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- ═══ 2 · POSITIONIERUNG ═════════════════════════════════════════════ -->
  <section class="section statement" id="positionierung" aria-labelledby="statement-title">
    <div class="container statement__inner">
      <!-- Bewusst kein deutscher Claim: Laut Positionierung trägt der
           englische Positions-Satz im Hero diese Rolle, ein Manifest-Satz
           auf Deutsch steht noch aus. Dieser Absatz erklärt die Position,
           er behauptet sie nicht als Slogan. -->
      <!-- Der komplette Positionstext, seit dem 6. August 2026 wieder mit
           Gattung und Ort — so war er in Entwurf 04c-XII abgenommen.
           Kursiv (Bodoni) laufen nur noch die drei Disziplinen; Auftakt
           und Schluss stehen aufrecht im Grotesk. Das geschützte
           Leerzeichen nach dem Auftakt hält ihn an "Le Werk" — sonst
           stünde "Gegründet von Filmemachern." allein auf einer Zeile.

           Kein data-reveal an beiden Absätzen: Die Wörter stehen von
           Anfang an, nur gedimmt, und färben sich beim Scrollen der Reihe
           nach auf — das Skript dazu steht am Ende der Datei. Zwei
           Mechaniken auf demselben Absatz überlagerten sich. -->
      <p class="statement__text" id="statement-title">
        <em>Gegründet von Filmemachern.</em>{' '}
        <span class="brand">Le Werk</span> ist ein Visual Content Studio mit
        Sitz im Rheinauhafen in Köln. Spezialisiert auf{' '}
        <i class="statement__kursiv">Storytelling, Film und Foto</i> für{' '}
        <em>Social und Branded Content.</em>
      </p>
      <p class="statement__meta">
        Konzept · Produktion · Postproduktion · Based in Köln, Booked Worldwide
      </p>
    </div>
  </section>

  <!-- ═══ 3 · FEATURED WORK ══════════════════════════════════════════════ -->
  <!-- Aufbau nach dem Culture-Abschnitt von saltandpictures.de: Über dem
       Raster klebt der Abschnittsname als Riesenwort und wandert beim
       Scrollen über die Kacheln hinweg. Er invertiert dabei, was hinter
       ihm liegt — auf dem schwarzen Grund steht er weiß, über einem Bild
       kehrt er dessen Farbe um.

       Voll bis an den Seitenrand statt im Container: Das Wort braucht die
       Breite, und das Raster steht damit auf derselben Kante wie das Logo
       im Header. Deshalb --edge und kein --gutter. -->
  <section class="section work" id="arbeiten" aria-labelledby="work-title">
    <!-- Englisch wie der Positions-Satz im Hero, deshalb lang="en": Ohne
         die Angabe liest eine Sprachausgabe "Featured Work" deutsch vor. -->
    <h2 class="work__wort" id="work-title" lang="en">Featured Work</h2>

    <!-- Zwei Bildformate statt sechs: Die Filmprojekte stehen hochkant,
         die beiden Fotostrecken quer. Das ist keine Vereinheitlichung um
         der Ordnung willen, sondern folgt der Gattung — und es ist die
         Bedingung dafür, dass die versetzten Spalten überhaupt als Muster
         lesbar sind. Das echte Ausgabeformat steht in der Zeile darunter,
         es geht also nichts verloren. -->
    <div class="werke">
      {arbeiten.map((a) => (
        <article class="werk" style={`--r: ${a.art === 'Foto' ? '4 / 3' : '3 / 4'}`}>
          <a class="werk__link" href={withBase(`/arbeiten/${a.slug}`)}>
            <img src={withBase(a.bild)} alt={a.alt} width={a.breite} height={a.hoehe} loading="lazy" decoding="async" />
            <span class="werk__zeile">
              <span class={`werk__pille${a.art === 'Foto' ? ' werk__pille--blau' : ''}`}>{a.art}</span>
              <!-- Die Ansage steht einmal vor der Klammer, nicht an jedem
                   Wert: "Formate 9:16 · 16:9" statt zweimal "Format". Der
                   Plural richtet sich nach der Anzahl. -->
              <span class="werk__formate">
                <span class="visually-hidden">
                  {a.formate.length > 1 ? 'Formate ' : 'Format '}
                </span>
                [{a.formate.join(' · ')}]
              </span>
            </span>
            <h3 class="werk__titel">{a.kunde}</h3>
            <p class="werk__projekt">{a.titel}</p>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- ═══ 4 · TRUSTBAR (Logo-Marquee) ════════════════════════════════════ -->
  <section class="section section--tight trust" id="trust" aria-label="Auswahl unserer Kunden">
    <div class="container container--breit">
      <!-- Vorher "Vertrauen auf Le Werk" — als Imperativ lesbar und
           werblich. Die Zeile benennt jetzt nur noch, was zu sehen ist. -->
      <p class="label trust__label">Ausgewählte Kunden</p>
    </div>

    <div class="marquee">
      <!-- Die Liste steht zweimal im Markup. Die zweite Runde trägt
           aria-hidden und leere Alternativtexte: Sie ist nur da, damit die
           Schleife ohne Lücke umbrechen kann, und würde sonst jeden
           Kundennamen doppelt vorlesen lassen.

           tabindex="-1" gehört zwingend dazu: Ein Element mit aria-hidden
           darf nicht fokussierbar sein, sonst landet die Tabulatortaste in
           etwas, das für Screenreader nicht existiert. Ohne die Angabe
           stünden zehn stumme Links in der Tabreihenfolge. -->
      <ul class="marquee__track">
        {[...kunden, ...kunden].map((k, i) => {
          const kopie = i >= kunden.length;
          return (
            <li class="marquee__logo" aria-hidden={kopie ? 'true' : undefined}>
              <a
                class="marquee__link"
                href={k.url}
                target="_blank"
                rel="noopener"
                tabindex={kopie ? -1 : undefined}
              >
                <!-- eager statt lazy: Die Leiste läuft, sobald sie ins Bild
                     kommt, und ein nachgeladenes Logo hinterlässt bis dahin
                     eine Lücke. Zwölf Dateien sind zusammen 124 KB, die
                     zweite Runde kommt aus dem Zwischenspeicher.
                     fetchpriority low, damit sie sich nicht vor das
                     Bühnenvideo und die ersten Kacheln drängen. -->
                <img
                  src={withBase(`/images/kunden/${k.datei}.png`)}
                  alt={kopie ? '' : k.name}
                  width={k.b} height={k.h}
                  loading="eager" fetchpriority="low" decoding="async"
                  style={`--b: ${logoBreite(k)}`}
                />
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ═══ 5 · LEISTUNGEN ═════════════════════════════════════════════════ -->
  <section class="section section--sand services" aria-labelledby="services-title">
    <div class="container container--breit">
      <!-- Marginalienstil wie bei "Warum Le Werk", nicht die große
           Überschrift der übrigen Abschnitte. Steht als h2 und nicht als
           p — ohne Überschrift auf dieser Ebene bliebe eine Lücke in der
           Gliederung.

           Der Modifier --nur-marke ist Pflicht, nicht Geschmack: Die
           Grundabstände sind auf eine Headline gerechnet, unter einer
           12px-Zeile wirken 72px wie ein Loch.

           "Content, holistisch gedacht" stand hier früher als Headline,
           davor zusätzlich ein Fließtext, der die Disziplinen abstufte
           ("Hauptdisziplin", "klare Zweite"). Beides ist entfallen. -->
      <header class="sec-head sec-head--nur-marke" data-reveal>
        <h2 class="label" id="services-title">Was wir machen</h2>
      </header>

      <!-- Nur die drei Produktionsdisziplinen. Workshops sind bewusst nicht
           auf der Startseite und ausschließlich über das Menü erreichbar.

           Bewusst keine Karten: Gleich große Kästen mit Rahmen und Schatten
           sehen nach Baukasten aus. Hier trägt die Anordnung — Video groß
           über die volle Höhe links, Idee & Konzept und Foto rechts
           gestapelt. -->
      <ol class="disziplinen">
        {disziplinen.map((s, i) => (
          <li class={`disziplin disziplin--${i + 1}`}>
            <!-- Name und Beschreibung stehen zusammen in der Bildunterschrift
                 und sitzen beide im unteren Band der Kachel. Der Text ist
                 immer im Markup und wird vorgelesen; sichtbar wird er beim
                 Überfahren, indem die Zeile aufgeht und den Namen anhebt.

                 Das innere span trägt das overflow: hidden — ohne einen
                 zweiten Kasten lässt sich eine Höhe von 0 nicht auf die
                 tatsächliche Texthöhe aufziehen. -->
            <figure class="disziplin__bild" style={`--ratio:${s.ratio ?? '4 / 3'}`}>
              <img src={withBase(s.img)} alt="" width="1200" height="900" loading="lazy" decoding="async" />
              <figcaption class="disziplin__fuss">
                <span class="disziplin__marke">{s.titel ?? s.label}</span>
                <span class="disziplin__text"><span>{s.text}</span></span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ 6 · UNSER KERNTEAM ═════════════════════════════════════════════ -->
  <section class="section section--dark team" aria-labelledby="team-title">
    <div class="container container--breit">
      <header class="sec-head sec-head--knapp" data-reveal>
        <p class="label">Wer dahintersteht</p>
        <h2 class="headline" id="team-title">
          <span class="editorial editorial--kicker">Unser</span>{' '}
          Kernteam
        </h2>
      </header>

      <!-- Erst die Gesichter … Name und Rolle stehen auf dem Bild, wie bei
           den Disziplinen weiter oben: Der Name ist immer da, die Rolle
           klappt beim Überfahren darunter auf und hebt ihn dabei an. -->
      <ul class="team__grid">
        {team.map((m, i) => (
          <li class="team__member" data-reveal data-reveal-delay={i * 70}>
            <figure class="team__bild">
              <img
                class="team__portrait"
                src={withBase(m.img)} alt={m.alt}
                width="700" height="700" loading="lazy" decoding="async"
              />
              <figcaption class="team__fuss">
                <span class="team__name">{m.name}</span>
                <span class="team__role">
                  <span>
                    {m.role.split('|').map((t) => (
                      <span class="team__zeile">{t.trim()}</span>
                    ))}
                  </span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <!-- … dann die Kulisse: ein versetztes Feld aus Studio- und
           Set-Aufnahmen, in dem die beiden Sätze auf einem Bildplatz
           stehen statt daneben. Aufbau und Begründung im Frontmatter
           bei kulisseRoh.

           Die Aufnahmen sind keine Bildunterschriften zu den Sätzen,
           sondern eine eigene Reihe — deshalb ul mit eigenem Label und
           nicht figure. -->
      <ul class="kulisse" aria-label="Aus dem Studio und von unseren Sets">
        {kulisse.map((k) => (
          k.text ? (
            <li class="kulisse__satz" data-spalte={k.spalte} data-reveal>
              <p>
                <strong class="knapp" style={`--laenge: ${k.laenge}`}>{k.vorspann}</strong>{' '}
                {k.satz}
              </p>
            </li>
          ) : (
            <li class="kulisse__stueck" data-spalte={k.spalte} style={`--r: ${k.hoch ? '3 / 4' : '4 / 3'}`}>
              <img src={withBase(k.img)} alt={k.alt} loading="lazy" decoding="async" />
              <span class="kulisse__zeile">
                <span class="kulisse__pille">{k.pille}</span>
                <span class="kulisse__nr" aria-hidden="true">[{k.nr}]</span>
              </span>
              <p class="kulisse__titel">{k.titel}</p>
            </li>
          )
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ 7 · DREI GRÜNDE ════════════════════════════════════════════════ -->
  <section class="section benefits" aria-labelledby="benefits-title">
    <div class="container container--breit">
      <!-- Ohne große Überschrift: "Drei Gründe, uns anzurufen" ist
           verworfen, der Abschnitt trägt jetzt nur noch die Marginalie.
           Sie steht als h2 und nicht als p — die drei Punkte darunter sind
           h3, ohne h2 dazwischen bliebe eine Lücke in der Gliederung, und
           aria-labelledby des Abschnitts braucht ein Ziel. Aussehen
           unverändert, das trägt die Klasse .label. -->
      <header class="sec-head sec-head--nur-marke" data-reveal>
        <h2 class="label" id="benefits-title">Warum <span class="brand">Le Werk</span></h2>
      </header>

      <ol class="benefits__list">
        <li class="benefit" data-reveal>
          <span class="benefit__num" aria-hidden="true">01</span>
          <h3 class="benefit__title">Content darf gut aussehen</h3>
          <p class="benefit__text">
            Hochwertig produzierte Visuals in Bild und Bewegtbild — mit den
            Maßstäben an Licht, Bildgestaltung und Postproduktion, wie man
            es aus der Filmproduktion kennt.
          </p>
        </li>
        <li class="benefit" data-reveal data-reveal-delay="80">
          <span class="benefit__num" aria-hidden="true">02</span>
          <h3 class="benefit__title">Inhaltliche Substanz</h3>
          <p class="benefit__text">
            Redaktionelle Tiefe, ehrlich erzählte Geschichten, menschliche
            Momente. Interviewbasiert und dokumentarisch, mit Blick für
            Charaktere.
          </p>
        </li>
        <li class="benefit" data-reveal data-reveal-delay="160">
          <span class="benefit__num" aria-hidden="true">03</span>
          <h3 class="benefit__title">Social First</h3>
          <p class="benefit__text">
            Marken müssen dort sichtbar sein, wo die Aufmerksamkeit ihrer
            Kunden liegt. Wir denken social first und produzieren den
            richtigen Content für die richtigen Kanäle.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══ 8 · FAQ ═══════════════════════════════════════════════════════ -->
  <!-- Die offenen Fragen zuerst, der Aufruf danach: Wer bis hierher gelesen
       hat, soll nicht mit einer Frage im Kopf auf den Knopf schauen.

       Beige und nicht Weiß: Die FAQ steht zwischen den hellen Vorteilen und
       dem dunklen Aufruf und braucht einen eigenen Ton — sonst grenzten
       zwei weiße Flächen aneinander. -->
  <section class="section section--sand faq" aria-labelledby="faq-title">
    <div class="container container--breit faq__grid">
      <header class="faq__head" data-reveal>
        <p class="label">Häufige Fragen</p>
        <h2 class="headline" id="faq-title">Kurz beantwortet</h2>
      </header>

      <div class="faq__list" data-reveal data-reveal-delay="80">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span set:html={f.q} />
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq__a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 9 · BOTTOM-CTA ════════════════════════════════════════════════ -->
  <!-- Der Aufruf schließt die Seite ab und geht in die Fußzeile über. Beide
       sind dunkel, aber nicht gleich: Die Fußzeile liegt auf
       --petrol-deeper und setzt sich damit ab. -->
  <section class="section section--dark cta" aria-labelledby="cta-title">
    <div class="container container--breit cta__inner" data-reveal>
      <h2 class="headline headline--xl cta__title" id="cta-title">
        <span class="editorial editorial--kicker">Erzähl uns</span>{' '}
        von deinem Projekt
      </h2>
      <div class="cta__actions">
        <a class="btn btn--on-dark" href={withBase("/kontakt")}>
          Projekt anfragen <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="mailto:contact@lewerk.de">contact@lewerk.de</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Der gemeinsame Sektionskopf .sec-head steht in global.css — er wird
     inzwischen auch von den Projektseiten gebraucht, und Astro-Styles
     gelten nur in der Datei, in der sie stehen. */

  /* ── 1 · Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    /* Der untere Wert setzt den Text über der Unterkante. Er ist zweimal
       gewachsen: 10vh ließen ihn 80px über dem Rand sitzen und damit fast
       auf dem Scroll-Pfeil, 13.5vh gaben 108px. Jetzt 17vh — der Satz
       steht deutlich über der Mitte der unteren Hälfte und lässt mehr
       Video frei. */
    padding-block: clamp(8rem, 18vh, 12rem) clamp(6.5rem, 17vh, 11.5rem);
    background: var(--petrol-deep);
    color: var(--on-dark);
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: 0; z-index: 0; }

  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ohne jeden Filter. Er lag zuletzt bei brightness(0.92), davor bei
       0.82 — beides nahm dem Material Licht, das es nicht hergeben muss.
       Die Lesbarkeit trägt allein der Verlauf darunter, und der sitzt da,
       wo die Schrift steht, statt über dem ganzen Bild. Nebenbei fällt
       damit eine Filterebene über einem formatfüllenden Video weg. */
  }

  .hero__media::after { content: ''; position: absolute; inset: 0; }

  /* Lesbarkeitsverlauf in neutralem Schwarz statt in Petrol: Ein farbiger
     Verlauf legt sich als Stich über das ganze Material und verfälscht die
     Farben der Aufnahme. Schwarz dunkelt ab, ohne einzufärben.
     Die Werte sind über mehrere Videoframes gemessen, nicht geschätzt.

     Zweimal zurückgenommen, damit mehr vom Video zu sehen ist. Der Fuß
     lief 0.90 → 0.82 → 0.72, die obere Kante 0.40 → 0.24 → 0.14, die
     Mitte ist inzwischen ganz offen. Der Verlauf sitzt nur noch dort, wo
     die Schrift steht. */
  .hero__media::after {
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.32) 24%, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.14) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.48) 0%, rgba(0, 0, 0, 0.1) 42%, rgba(0, 0, 0, 0) 64%);
  }

  /* Auf schmalen Schirmen steht der Satz sechszeilig statt zweizeilig und
     reicht damit bis auf 35 % der Höhe hinauf — dort war der Verlauf schon
     fast offen und der Kontrast fiel auf 2.8:1. Der Verlauf greift hier
     deshalb höher. Der seitliche fällt weg: Der Satz nimmt die volle
     Breite ein, eine linke Kante gibt es nicht mehr abzudunkeln. */
  @media (max-width: 1023.98px) {
    .hero__media::after {
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.46) 30%, rgba(0, 0, 0, 0.1) 55%, rgba(0, 0, 0, 0) 72%, rgba(0, 0, 0, 0.12) 100%);
    }
  }

  /* Randabstand wie im Header, damit Text und Logo auf einer Achse sitzen */
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: var(--edge);
  }

  /* Seit dem 6. August 2026 komplett Poppins: Die Wortmarke bleibt
     ExtraBold (.brand, unverändert), der Satz selbst läuft im
     Medium-Schnitt mit — die Bodoni-Fassung ist verworfen. 500 und nicht
     400, weil der Satz auf bewegtem Video steht und Regular dort zu dünn
     auftrat. Maße aus Entwurf 04c-XII übernommen. */
  .hero__statement {
    max-width: 44ch;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: clamp(1.5rem, 3.2vw, 2.875rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--on-dark);
    text-wrap: pretty;
  }

  /* Ohne die Serifenrolle entfällt auch das Kursiv — "worth watching."
     läuft im Satz mit. Das em bleibt im Markup: Die Betonung gilt, sie
     ist nur nicht mehr sichtbar. */
  .hero__statement em { font-style: normal; }

  /* Der feste Umbruch gilt nur, solange beide Hälften in eine Zeile
     passen — darunter bricht der Satz frei. */
  @media (max-width: 819.98px) {
    .hero__br { display: none; }
  }


  .hero__cue {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 6vh, 3.5rem);
    z-index: 1;
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    animation: cue 2.4s var(--ease-out) infinite;
  }

  @keyframes cue {
    0%, 100% { transform: translateY(0); opacity: 0.75; }
    50%      { transform: translateY(6px); opacity: 1; }
  }

  /* ── 2 · Trustbar ─────────────────────────────────────────────────────── */
  .trust__label { margin-bottom: 0; }
  .trust .marquee { margin-top: clamp(1.5rem, 3vw, 2.5rem); }

  .marquee {
    /* Die volle Kastenbreite. Alles andere in der Leiste hängt daran: die
       Logobreite über den Faktor --b je Marke, die Kastenhöhe über das
       Verhältnis 2.35. Beide Werte stehen auch im Frontmatter, dort als
       LOGO_VERHAELTNIS. */
    --logo-breite: clamp(3.7rem, 5.85vw, 5.25rem);
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    /* muss 0 bleiben: Der Track wandert um 50 % seiner Breite. Ein gap läge
       auch zwischen den beiden Kopien und verschöbe die Rechnung um genau
       einen Abstand — die Schleife spränge sichtbar. Der Abstand steckt
       deshalb im Logo, siehe .marquee__logo. */
    gap: 0;
    width: max-content;
    /* Der frühere Streifen lief 1600px in 40s, also 40px in der Sekunde.
       Bei zwölf Logos misst eine Runde 1329px — bei gleicher
       Geschwindigkeit sind das 33s. Wer ein Logo ergänzt, muss den Wert
       nachziehen, sonst läuft die Leiste schneller. */
    animation: marquee 33s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track { animation-play-state: paused; }

  @keyframes marquee {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  /* Die Kachel ist so breit wie ihr Logo plus zweimal Polsterung — keine
     feste Breite. Damit steht zwischen zwei Logos immer derselbe Abstand
     von 37px.

     Mit fester Breite war das nicht so. Ein schmales Logo saß dann mittig
     in einem 94px breiten Kasten und brachte bis zu 55px Leerraum mit, der
     sich zur Lücke addierte — gemessen lagen die sichtbaren Abstände
     zwischen 38px (Siemens neben Street One) und 87px (EA neben Formel D).
     Zwei Wortmarken standen doppelt so eng wie zwei Bildmarken.

     Die Größe selbst kommt aus --logo-breite an .marquee und war zuerst
     deutlich zu groß: Bei einem Kasten von 148 x 54 kamen die Wortmarken
     auf 111px, und vier Bildmarken standen auf voller Höhe, wo der frühere
     Streifen nur eine hatte. Über 142 x 44 und 132 x 40 steht sie jetzt bei
     84 x 36 — Siemens läuft damit 84px breit gegen 80px im alten
     Streifen. */
  .marquee__logo {
    flex: none;
    display: flex;
    padding-inline: clamp(0.75rem, 1.3vw, 1.1875rem);
  }

  /* Der Link ist der Kasten. Seine Höhe ist fest und nicht vom Bild
     abgeleitet — das ist keine Kosmetik, sondern Bedingung dafür, dass die
     Logos überhaupt erscheinen:

     Ein Bild mit loading="lazy" wird geladen, sobald sein Kasten in die
     Nähe des Sichtfelds kommt. Stehen aber Breite und Höhe des Bildes auf
     auto, hat es vor dem Laden keine Größe — und was keine Größe hat,
     kommt nie in die Nähe des Sichtfelds. Das Bild lädt nicht, bleibt
     ohne Größe, und die Leiste ist leer. Genau das ist hier passiert.

     Mit fester Kastenhöhe steht die Fläche von Anfang an, das Laden löst
     aus, und object-fit hält das Seitenverhältnis.

     Dass der Link die Fläche trägt und nicht das Bild, hat noch einen
     Grund: Ein Ziel von 104 x 44px ist knapp, und die Leiste bewegt sich.
     Deshalb hält sie beim Überfahren an, siehe .marquee__track. */
  .marquee__link {
    display: flex;
    align-items: center;
    height: calc(var(--logo-breite) / 2.35);
  }

  /* Die Trustbar liegt auf Weiß, deshalb Petrol und nicht currentColor —
     der Ring soll sich vom schwarzen Logo unterscheiden. */
  .marquee__link:focus-visible {
    outline: 2px solid var(--petrol);
    outline-offset: 6px;
    border-radius: 2px;
  }

  /* Die Breite kommt je Marke aus --b, die Höhe folgt dem
     Seitenverhältnis. Breite Wortmarken bekommen die volle Kastenbreite,
     hohe Bildmarken so viel, wie ihre Höhe zulässt — auf gleiche Höhe
     gebracht wären die Wortmarken dreimal so schwer.

     Die feste Breite ist Bedingung, nicht Kosmetik: Stehen Breite und Höhe
     beide auf auto, hat ein Bild mit loading="lazy" vor dem Laden keine
     Größe, kommt damit nie in die Nähe des Sichtfelds und lädt nie. Die
     Leiste bleibt leer. Mit fester Breite steht die Fläche von Anfang an —
     das Seitenverhältnis liefern die width- und height-Attribute.

     Kein Farbfilter: Die Logos sind schwarz, weil die Dateien schwarz sind.
     Formel D kam türkis und wurde umgefärbt — nachgemessen liegt die
     Deckfarbe jetzt bei allen zehn zwischen 0 und 32 von 255. Details in
     docs/bildmaterial.md. */
  .marquee__logo img {
    width: calc(var(--b, 1) * var(--logo-breite));
    height: auto;
    opacity: 0.72;
    transition: opacity var(--dur) var(--ease-out);
  }

  /* Beim Überfahren der Leiste heben sich alle Logos, das einzelne unter
     dem Zeiger geht auf volle Deckung — sonst wäre nicht zu sehen, worauf
     der Klick geht. */
  .marquee:hover .marquee__logo img { opacity: 0.85; }
  .marquee__link:hover img,
  .marquee__link:focus-visible img { opacity: 1; }

  /* ── 2 · Positionierung ───────────────────────────────────────────────── */
  .statement { padding-block: clamp(4.5rem, 10vw, 8.5rem); }

  /* Linksbündig statt zentriert — der Absatz beginnt auf derselben Kante
     wie Logo und Hero-Satz. Bis 1440px ist das exakt --edge; darüber
     wandert der zentrierte Container mit, die Kante bleibt aber die
     linkeste der Seite. Übernommen aus Entwurf 04c-XII. */
  .statement__inner { text-align: left; }

  /* Poppins Medium in Blau statt Bodoni in Tinte — Satzbild nach
     salt & pictures, Maße aus Entwurf 04c-XII: 60px bei 1440er Fenster,
     Durchschuss 1.1, der Block läuft fast über die volle Seitenbreite.
     Der negative Rand zieht ihn aus dem Container auf die --edge-Kante
     von Logo und Hero-Satz; unter 1440px sind beide Ränder gleich groß
     und der Rand damit null oder kleiner. */
  .statement__text {
    margin-inline: calc(var(--edge) - var(--gutter));
    max-width: none;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: clamp(1.5rem, 4.35vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.022em;
    color: #2451d8;
    /* In dieser Größe ist eine Silbentrennung deutlich sichtbar und wirkt
       wie ein Fehler — der Satz darf lieber eine Zeile länger werden. */
    hyphens: none;
  }

  /* Auftakt und Schluss laufen aufrecht mit — die em bleiben als
     Betonung im Markup, sichtbar kursiv sind nur die drei Disziplinen. */
  .statement__text em { font-style: normal; }

  /* Die drei Disziplinen als kursive Bodoni-Einlage, wie bei
     salt & pictures: eine Spur größer, damit die Serife gegen das
     Grotesk drumherum nicht abfällt. */
  .statement__kursiv {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 500;
    font-size: 1.05em;
    letter-spacing: 0;
  }

  /* Die Wörter erzeugt das Skript am Ende der Datei — deshalb :global,
     Astros Geltungsstempel bekämen sie sonst nie. Sie stehen von Anfang
     an, nur auf ein Fünftel der Deckung gedimmt, und färben sich beim
     Scrollen der Reihe nach auf das volle Blau. */
  .statement__text :global(.wort) {
    color: rgba(36, 81, 216, 0.2);
    transition: color 450ms var(--ease-out);
  }

  .statement__text :global(.wort.is-an) { color: #2451d8; }

  /* Gesperrte Versalzeile als Gegengewicht — auf derselben Kante wie der
     Absatz. Sie blendet erst ein, wenn der Absatz weitgehend aufgefärbt
     ist; die Deckung schreibt das Skript. Der Startwert 0 gilt nur mit
     Skript — ohne bleibt die Zeile sichtbar. */
  .statement__meta {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    margin-inline: calc(var(--edge) - var(--gutter));
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  @media (scripting: enabled) {
    .statement__meta { opacity: 0; }
  }

  /* ── 3 · Schwarzwechsel ───────────────────────────────────────────────── */
  /* Ab "Featured Work" läuft die Startseite auf Schwarz — eine Fläche
     für alles darunter, wie in Entwurf 04c-XII abgenommen. Die Sektionen
     behalten ihre Klassen (--dark, --sand); überschrieben werden nur die
     Token, damit Labels, Linien und Fließtexte überall mitwechseln.
     .section davor, weil .section--sand sonst gleichrangig wäre und die
     Reihenfolge im Bündel entschiede. */
  .section.work,
  .section.trust,
  .section.services,
  .section.team,
  .section.benefits,
  .section.faq,
  .section.cta {
    background: #0d0d0d;
    color: #fff;
    --ink: #fff;
    --ink-muted: rgba(255, 255, 255, 0.65);
    --on-dark: #fff;
    --on-dark-muted: rgba(255, 255, 255, 0.65);
    --line: rgba(255, 255, 255, 0.15);
    --line-strong: rgba(255, 255, 255, 0.3);
    --line-dark: rgba(255, 255, 255, 0.15);
    /* Die Marken-Akzente im Inneren — Ziffern der Gründe, das Plus im FAQ —
       greifen auf --petrol zu. Auf #0d0d0d käme das auf 1.9:1 und wäre
       nicht mehr zu sehen; die helle Schwester steht bei 9.6:1. */
    --petrol: var(--petrol-light);
  }

  /* Petrol als Fokusfarbe ist auf Schwarz nicht mehr zu sehen (1.6:1) —
     im schwarzen Teil zeichnet Weiß den Ring. */
  .section.work :focus-visible,
  .section.trust :focus-visible,
  .section.services :focus-visible,
  .section.team :focus-visible,
  .section.benefits :focus-visible,
  .section.faq :focus-visible,
  .section.cta :focus-visible { outline-color: #fff; }

  /* Die Logodateien sind schwarz — auf Schwarz kehrt der Filter sie auf
     Weiß um; die Deckungsstufen der Leiste bleiben unverändert. */
  .trust .marquee__logo img { filter: invert(1); }

  /* Der weiße Knopf behält seine Fläche, die Schrift wechselt vom tiefen
     Petrol auf das Schwarz des Grundes; der Hover dimmt die Fläche statt
     sie einzufärben — Petrol-Hell gehört nicht mehr in diese Welt. */
  .cta .btn--on-dark { color: #0d0d0d; }
  .cta .btn--on-dark:hover { background: rgba(255, 255, 255, 0.82); color: #0d0d0d; }

  /* Der Footer liegt eine Stufe tiefer als die Abschnitte — dieselbe
     Logik wie vorher Petrol-Deep zu Petrol-Deeper. Er steht im Layout,
     deshalb :global; die Regel lädt nur mit der Startseite. */
  :global(.footer) { background: #070707; }

  /* Alle Bilder eckig: Der Token gilt für Kacheln, Porträts und
     Haufenstücke gleichermaßen — auf body gesetzt, damit auch der
     Streublock ihn erbt. Knöpfe und Pillen behalten ihre Form. */
  :global(body) { --radius-bild: 0px; }

  /* Der feste Header folgt dem Schnitt: Sobald "Featured Work" unter ihm
     ansteht, wird die solide Fläche schwarz statt weiß — die Klasse
     setzt das Skript am Ende der Datei. Dreifach, um die is-solid-Regeln
     aus global.css sicher zu schlagen. */
  :global(.header.is-solid.is-dunkel) {
    background: rgba(13, 13, 13, 0.94);
    color: #fff;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.15);
  }

  :global(.header.is-solid.is-dunkel .logo) { color: #fff; }

  /* ── 4 · Featured Work ────────────────────────────────────────────────── */
  /* Nach dem Culture-Abschnitt von saltandpictures.de. Die frühere
     Fassung — ein Reißverschluss aus drei Paaren im Zwölfspaltigen, jede
     Kachel in ihrem eigenen Format, Kundenname im Bild, Kacheln laufen
     beim Scrollen seitlich auf ihren Platz zu — ist damit vollständig
     abgelöst. Die Maße dieser Anordnung stehen in der Git-Historie.

     Voll bis an den Seitenrand: Das Raster steht auf --edge, derselben
     Kante wie Logo und Hero-Satz, statt im 1440er Container. */
  .work {
    padding-block: clamp(4rem, 12vh, 9rem) clamp(3.5rem, 10vh, 8rem);
    padding-inline: var(--edge);
  }

  /* Das Riesenwort klebt oben und wandert beim Scrollen über die Kacheln.

     mix-blend-mode: difference macht die Umkehrung: Auf dem schwarzen
     Grund (13,13,13) bleibt Weiß praktisch Weiß, über einem Bild kehrt
     es dessen Farbe um. Ein weißes Wort mit Schatten täte das nicht — es
     würde über hellen Bildstellen schlicht verschwinden.

     pointer-events: none ist Bedingung, nicht Kosmetik: Das Wort liegt
     über den Kacheln und würde deren Links sonst abfangen.

     Der negative Fußabstand zieht das Raster unter das Wort. Ohne ihn
     stünde eine Zeilenhöhe Leerraum dazwischen, und der Kleber liefe ins
     Nichts.

     GRÖSSE: 10,7vw und nicht die 15,5vw der Vorlage. Dort steht ein Wort
     mit sieben Zeichen, hier sind es dreizehn. Im Browser nachgemessen
     misst "FEATURED WORK" in Poppins ExtraBold bei −0.035em Laufweite
     8,109 Geviert; die größte Schrift, die zwischen die beiden Ränder
     passt, ist also (100vw − 2 × --edge) / 8,109. Ausgerechnet über die
     Fensterbreiten:

       320px   10,79vw      1440px   11,71vw
       375     11,02        1920     11,82
       768     11,69        2560     11,95

     Das schmalste Fenster setzt die Grenze. 10,7vw liegt darunter und
     füllt oben 91 Prozent der freien Breite — voll genug, dass das Wort
     die Seite trägt, mit Luft genug, dass es nicht klemmt.

     Die Untergrenze steht bei 1,25rem und nicht höher: rem hängt an der
     Grundschrift des Browsers, und bei 20px statt 16 wären aus 1,75rem
     35px geworden — genau der Wert, der bei 320px Fenster gerade noch
     passt. Kein Spielraum.

     KLEBEHÖHE: unter dem Kopf, nicht darunter hindurch. Bei 4vh — dem
     Wert der Vorlage — stand das Wort 36px unter der Fensterkante,
     während der feste Kopf 96px hoch ist: 60 der 123px Worthöhe waren
     verdeckt, also fast die Hälfte. Die Vorlage hat keinen mitlaufenden
     Kopf und kann sich das leisten.

     Jetzt --kopf-hoehe plus ein Abstand. Der Wert hängt an derselben
     Polsterung wie der Kopf selbst — wer den Kopf ändert, zieht das Wort
     mit. */
  .work__wort {
    position: sticky;
    top: calc(var(--kopf-hoehe) + var(--space-2));
    z-index: 2;
    pointer-events: none;
    margin-bottom: -0.35em;
    text-align: center;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: clamp(1.25rem, 10.7vw, 13rem);
    line-height: 0.8;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-wrap: nowrap;
    color: #fff;
    mix-blend-mode: difference;
  }

  /* Drei Spalten für sechs Projekte — zwei volle Reihen. Die Vorlage
     steht auf vier Spalten, hat dort aber acht Kacheln; vier Spalten
     ließen hier die zweite Reihe halb leer stehen. */
  .werke {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  /* Der Versatz je Spalte ist das, was das Raster zum Muster macht. Er
     läuft als Zickzack: links oben, in der Mitte tief hinunter, rechts
     wieder ein Stück herauf. Beide Reihen folgen ihm, dadurch
     überschneiden sie sich, und das Riesenwort läuft nie über eine
     gerade Kante.

       Spalte 1     0        Siemens        Street One
       Spalte 2    18vh      Revitive       Formel D
       Spalte 3     7vh      Allianz        BVB

     margin-top und nicht transform: Die Kachel soll den Platz, den sie
     einnimmt, auch beanspruchen — sonst liefe die Reihe darunter hinein.

     In vh und nicht in vw, wie in der Vorlage: Der Versatz ist ein Weg
     beim Scrollen, kein Maß der Fläche.

     IN DER MITTE STEHT JEWEILS EINE FOTOSTRECKE, und das gehört zum
     Versatz. Die beiden Strecken sind quer aufgenommen und damit die
     kürzesten Kacheln — 324px gegen 576 der Hochformate. Eine Reihe ist
     so hoch wie ihre höchste Kachel; ohne Versatz klaffte unter der
     kurzen der ganze Rest der Reihe. Hängt sie dagegen tief, steht die
     Lücke über ihr und ist der Versatz selbst. Gemessen bei 1440 x 900
     liegen dann 162px über und 153 unter ihr.

     Wer in arbeiten.ts umsortiert, muss das mitdenken — die Regel steht
     dort im Kopf der Datei. */
  .werk {
    align-self: start;
    margin-top: var(--rutsch, 0);
  }

  .werk:nth-child(3n + 2) { --rutsch: 18vh; }
  .werk:nth-child(3n) { --rutsch: 7vh; }

  .werk__link {
    display: grid;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }

  /* Graustufen, Farbe erst beim Überfahren — wie in der Vorlage und wie
     bei Disziplinen und Porträts weiter unten. Der leichte Kontrastzug
     fängt auf, was Graustufen an Trennung kosten.

     Kein Verlauf und keine zweite Ebene mehr über dem Bild: Seit dem
     6. August 2026 steht das Motiv frei, es liegt keine Schrift mehr
     darauf, die einen Lesbarkeitsverlauf bräuchte. */
  .werk__link img {
    width: 100%;
    aspect-ratio: var(--r, 3 / 4);
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter var(--dur-slow) var(--ease-out);
  }

  .werk__link:hover img,
  .werk__link:focus-visible img { filter: none; }

  /* Ohne Zeigegerät gäbe es die Farbe nie zu sehen — dieselbe Regel wie
     bei den Disziplinen und den Porträts. */
  @media (hover: none) {
    .werk__link img { filter: none; }
  }

  /* Gattung links, Ausgabeformate rechts. In 12px und nicht in rem: Die
     Zeile ist die kleinste Schrift der Seite und soll auf jedem Gerät
     dieselbe Größe haben wie in der Vorlage.

     Umbrechen darf sie: Beide Teile stehen auf nowrap, und "Formate
     [9:16 · 16:9]" braucht neben der Pille zusammen 145px. Unterhalb von
     rund 350px Fenster misst die Kachel weniger — gemessen 132px bei
     320 —, und die Zeile lief in den Spaltenabstand hinaus. Mit Umbruch
     rutschen die Formate unter die Pille. Oberhalb greift das nie. */
  .werk__zeile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 0.75rem;
    font-size: 12px;
    line-height: 1.5;
  }

  .werk__pille {
    padding: 2px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* Die beiden Fotostrecken tragen die gefüllte Pille — sie sind die
     Ausnahme unter sechs Projekten, und die Farbe ist dieselbe wie im
     Positionsabsatz oben. Vier gefüllte Pillen für Video wären keine
     Auszeichnung mehr, sondern der Normalfall. */
  .werk__pille--blau {
    background: #2451d8;
    border-color: #2451d8;
    color: #fff;
  }

  .werk__formate {
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--ink-muted);
  }

  /* Der Kunde trägt die Kachel und steht deshalb in der Redaktionsschrift
     — dieselbe Rolle wie der Kampagnentitel in der Vorlage. Versal und
     leicht gesperrt, weil Bodoni in Versalien sonst zu eng läuft. */
  .werk__titel {
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: clamp(1rem, 1.6vw, 1.375rem);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Was für den Kunden entstanden ist. Steht unter dem Namen und im
     selben Ton wie die Zeile über dem Bild, damit die Kachel oben und
     unten von derselben kleinen Schrift eingefasst wird. */
  .werk__projekt {
    font-size: 12px;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Zwei Spalten und ohne Versatz, sobald die Kachel unter etwa 270px
     fällt. Der Versatz braucht Reihen, die breit genug sind, um sich zu
     überschneiden; zu zweit läse er sich als verrutschte Kachel — und
     bei zwei Spalten zählt 3n ohnehin nicht mehr die Spalten ab.

     Beide Wähler noch einmal, nicht nur .werk: :nth-child zählt in der
     Spezifität wie eine zweite Klasse und gewinnt gegen .werk, egal in
     welcher Medienabfrage es steht. Genau das ist hier zuerst passiert —
     der Versatz stand bei 375px Fenster weiter bei 146px. */
  @media (max-width: 859.98px) {
    .werke { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .werk:nth-child(3n + 2),
    .werk:nth-child(3n) { --rutsch: 0; }
  }

  /* ── 5 · Disziplinen ──────────────────────────────────────────────────── */
  /* Kappt waagerecht wie .team: Die drei Kacheln fahren beim Scrollen
     seitlich auf ihren Platz zu und stehen bei --q = 0 außerhalb des
     Rasters. */
  .services { overflow-x: clip; }

  /* Die Kacheln laufen beim Scrollen auf ihren Platz zu — dasselbe
     Bewegungsgesetz wie die Stücke im Streublock, nur auf die andere
     Anordnung gelegt. Der Weg steht je Kachel als --dx darunter, --q
     schreibt das Skript am Ende der Datei.

     Der Maßstab ist bewusst klein: 32px Weg und 2,2 Prozent Größe gegen
     165px und 12 Prozent im Haufen. Die Stücke dort sind Schnipsel, hier
     sind es Kacheln bis 641 x 801px — derselbe Weg sähe an ihnen nicht
     lebendig aus, sondern lose.

     Weg und Größe ziehen gegeneinander: Bei --q = 0 steht die Kachel
     weiter außen, ist aber kleiner — die Außenkante läuft deshalb weniger
     weit als der Mittelpunkt. Das ist gewollt, sonst risse der Rand auf.

     Featured Work lief bis zum 6. August 2026 nach demselben Gesetz und
     teilte sich diese Regel; dort trägt jetzt der Versatz der Spalten. */
  .disziplin.is-aktiv {
    --zug: clamp(0.75rem, 2.2vw, 2.15rem);
    transform:
      translate3d(
        calc(var(--dx, 0) * var(--zug) * (1 - var(--q, 1))),
        calc(var(--dy, 0.55) * var(--zug) * (1 - var(--q, 1))),
        0
      )
      scale(calc(0.978 + 0.022 * var(--q, 1)));
  }

  /* Der Weg jeder Kachel: Mitte der Kachel minus Mitte des Rasters,
     geteilt durch die halbe Rasterbreite. Video sitzt links auf Spalte
     3,5, Konzept und Foto rechts auf 10 und 9,5.

     Zwei von drei laufen also nach rechts. Das ist keine Unsauberkeit,
     sondern die Anordnung: eine große Kachel links, zwei gestapelte
     rechts. Die Bewegung folgt dem Aufbau, nicht einem Muster.

     Die Werte stehen außerhalb der Medienabfrage, weil das Feld auch
     einspaltig eine Reihenfolge hat — dort läuft Video nach links und die
     beiden anderen nach rechts, genau wie im Raster. */
  .disziplin--1 { --dx: -0.50; }
  .disziplin--2 { --dx:  0.58; }
  .disziplin--3 { --dx:  0.50; }

  /* Bewusst dieselbe Sprache wie die Arbeiten darüber: Bild als Hauptfigur,
     der Name groß im Bild, eine schmale Zeile darunter, versetztes Raster.
     Ein Unterschied ist nötig — die Arbeiten liegen auf dunklem Grund und
     ihre Motive sind dunkel, hier stehen helle Motive auf Sand. Weiße
     Schrift braucht deshalb einen Verlauf unter sich. */
  .disziplinen {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Kein a mehr: Die drei Disziplinen führen nirgendwohin. Es gibt zu ihnen
     keine Unterseiten, nur Workshops hat eine, und die steht nicht in
     diesem Abschnitt. Die Adressen bleiben in den Daten — Menü und Fußzeile
     brauchen sie weiter.

     Auch die Hülle um Bild und Text ist entfallen: Seit der Text in der
     Kachel liegt, ist die Kachel das Bild. */

  /* Die Kachel ist ihr eigener Bezug. Name und Textblock müssen in das
     untere Band passen, und wie groß das ist, hängt an der Kachel — nicht
     am Fenster. Bei 1024px Fensterbreite ist die Konzept-Kachel nur
     344 x 229px, während 4.4vw dort noch 45px Schrift ergeben hätten:
     "Idee & Konzept" brach zweizeilig um und der Block reichte bis 73 %
     der Kachelhöhe. */
  /* Ohne Maske und ohne Filter: Die Maske hielt den Rundungssaum fern
     (Rundung ist jetzt null), Graustufen und Lesbarkeitsverläufe sind
     auf Simons Ansage vom 6. August 2026 entfallen — die Motive stehen
     roh und von Anfang an in Farbe. Die Kontrastmessungen zu den
     früheren Verläufen stehen in der Git-Historie; ohne sie trägt die
     Schrift im Bild nur noch ihren Schatten. */
  .disziplin__bild {
    position: relative;
    container-type: inline-size;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-bild);
  }

  .disziplin__bild img {
    border-radius: inherit;
    display: block;
    width: 100%;
    /* Jede Disziplin in ihrem eigenen Format — kommt aus den Daten */
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }

  /* Name und Beschreibung stehen zusammen im unteren Band, am Boden der
     Kachel verankert. Geht die Beschreibung auf, schiebt sie den Namen nach
     oben — die Kachel macht Platz, statt etwas zu überdecken. */
  .disziplin__fuss {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(0.875rem, 2.5vw, 1.75rem);
    z-index: 1;
  }

  /* 9cqi statt 4.4vw: neun Prozent der Kachelbreite. Damit bleibt der Name
     auf jeder Kachel einzeilig — "Idee & Konzept" ist der längste und
     misst bei 9 Prozent rund drei Viertel der verfügbaren Breite. */
  .disziplin__marke {
    display: block;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: clamp(1.5rem, 9cqi, 3.25rem);
    line-height: 1;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
  }

  /* Der Beschreibungstext im unteren Band.

     WARUM UNTEN UND NICHT MITTEN INS BILD. Ein erster Versuch setzte eine
     deckende Karte oben links in die Kachel. Sie verdeckte genau das, was
     der Hover eigentlich zeigen will — auf dem Foto-Motiv lag sie über den
     beiden Personen. Das untere Band ist dagegen ohnehin abgedunkelt, damit
     der Name lesbar ist. Text, der dort steht, kostet keinen Bildbereich,
     der nicht schon getönt wäre.

     WARUM DER NAME MITGEHT. Unter dem Namen ist kein Platz — er sitzt 27px
     über der Unterkante. Also geht die Zeile auf und hebt ihn an. Die
     Kachel macht Platz, statt etwas zu überdecken, und die Lesefolge
     stimmt: erst der Name, dann die Erklärung.

     0fr auf 1fr statt max-height: Damit läuft die Bewegung genau bis zur
     tatsächlichen Texthöhe, ohne dass irgendwo ein Maximalwert gepflegt
     werden muss. Wo ein Browser das nicht weich rechnet, springt es —
     richtig steht es überall.

     34ch, damit die Zeile auf der breiten Video-Kachel nicht quer über das
     Motiv läuft. Der längste Text hat 92 Zeichen und braucht drei Zeilen. */
  .disziplin__text {
    display: grid;
    grid-template-rows: 0fr;
    max-width: 80cqi;
    margin-top: 0;
    font-family: var(--font-ui);
    font-size: clamp(0.875rem, 3cqi, var(--fs-body));
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0;
    text-transform: none;
    color: rgba(255, 255, 255, 0.92);
    opacity: 0;
    transition: grid-template-rows var(--dur-slow) var(--ease-out),
                opacity var(--dur) var(--ease-out),
                margin-top var(--dur-slow) var(--ease-out);
  }

  .disziplin__text > span { overflow: hidden; }

  .disziplin:hover .disziplin__text {
    grid-template-rows: 1fr;
    margin-top: 0.625rem;
    opacity: 1;
  }

  /* Ohne Zeigegerät gibt es kein Überfahren — dort steht der Text immer.
     Dieselbe Entscheidung wie beim Farbwechsel darüber: Was nur der Hover
     zeigt, ist auf dem Telefon sonst nicht vorhanden. */
  /* Einspaltig ist jede Kachel so breit wie der Container, und damit wird
     die Zeile kurz: Bei 375px Fenster passen 33 Zeichen darauf, der
     Konzept-Text braucht dann neun Zeilen. Im Quadrat füllte der Block 81
     Prozent der Kachel. Hochkant sind es 62.

     Nur diese eine Kachel — Video und Foto kommen mit zwei und drei Zeilen
     aus und brauchen die Höhe nicht. Über die Bildhöhe und nicht über
     --ratio, weil das Format als Inline-Stil aus den Daten kommt und eine
     Regel im Stylesheet sonst nicht dagegen ankäme. */
  @media (max-width: 767.98px) {
    .disziplin--2 .disziplin__bild img { aspect-ratio: 2 / 3; }
    .disziplin--3 .disziplin__bild img { aspect-ratio: 1 / 1; }
  }

  @media (hover: none) {
    .disziplin__text {
      grid-template-rows: 1fr;
      margin-top: 0.625rem;
      opacity: 1;
    }
  }


  /* ── 6 · Vorteile ─────────────────────────────────────────────────────── */
  .benefits__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .benefit { border-top: 1px solid var(--line); padding-top: var(--space-3); }

  .benefit__num {
    display: block;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--petrol);
    margin-bottom: var(--space-2);
  }

  .benefit__title {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-1);
    text-wrap: balance;
  }

  /* Gedeckelt wie der Streublock-Text: Unter 992px steht ein Grund über die
     volle Breite und käme bei 900px Fenster auf 813px Zeilenlänge, also
     rund 90 Zeichen. Nebeneinander greift der Deckel nicht — dort sind die
     Spalten 266 bis 399px breit. */
  .benefit__text { max-width: 62ch; color: var(--ink-muted); }

  /* ── 6 · Unser Kernteam ─────────────────────────────────────────────── */
  /* Der Abschnitt kappt waagerecht. Gebraucht wurde das von den
     Streublöcken, die ihren Text um 7rem zur Seite hereinfuhren und die
     Seite dabei auf 1326px Scrollbreite wachsen ließen. Die Kulisse, die
     seit dem 6. August 2026 an ihrer Stelle steht, bewegt sich seitlich
     nicht mehr — die Regel bleibt als Sicherung stehen.

     clip und nicht hidden: hidden macht aus dem Abschnitt einen
     Scrollcontainer, und da overflow-y sichtbar bleiben muss, würde der
     Browser daraus auto rechnen. clip kappt nur. Der Abschnitt läuft über
     die volle Fensterbreite, geschnitten wird also nichts, was man
     ohnehin sähe. */
  .team { overflow-x: clip; }

  /* Kopf ohne Fließtext — der steht jetzt als breiter Absatz unter den
     Porträts, deshalb hier weniger Abstand nach unten. */
  /* Der Team-Kopf steht enger, weil "UNSER TEAM" kurz ist und die
     Porträts direkt darunter die Fläche übernehmen. */
  .sec-head--knapp { margin-bottom: clamp(1.75rem, 4vw, 3rem); }

  /* Vier Porträts: zwei Spalten auf dem Handy, vier ab 992px.

     Name und Rolle standen bis zum 5. August 2026 als zwei Zeilen unter
     dem Bild. Das gab der Reihe ein unruhiges Fußende — die Rollen sind
     Doppelnennungen, zwei von vieren brachen um, und die Reihe stand auf
     vier verschieden hohen Textblöcken. Jetzt sitzen sie im Bild, nach
     demselben Muster wie die Disziplinen weiter oben: Der Name ist immer
     da, die Rolle klappt beim Überfahren auf.

     Damit ändert sich auch das Format. Im Quadrat saß der Name auf Höhe
     von Kinn und Hals — bei Joscha und Tom stand er den Gesichtern
     buchstäblich im Weg. 4:5 gibt unterhalb des Kinns eine Fläche, auf
     die eine Zeile gehört. Der Ausschnitt kostet nichts: Die Vorlagen
     sind 700 × 700 und quadratisch beschnitten, 4:5 nimmt je Seite 70px
     ab. Die Köpfe stehen mittig und rund 300px breit, sie liegen also mit
     Abstand innerhalb. Nachgesehen an allen vier.

     ABSTAND UND GRÖSSE. Zwei Vorgaben stehen weiter fest: Die Reihe liegt
     bündig an beiden Kanten, und die Gesichter bleiben kleiner als die
     Stücke im Haufen darunter, damit sie ihn einleiten statt mit ihm zu
     konkurrieren. Der Spaltenabstand sinkt dafür von 137 auf 94px:

       3 × 94                 = 282px für die Abstände
       (1252 − 282) ÷ 4       = 243px je Bild

     bei 1252px Reihe also 243 × 303px gegen 210 × 300 vorher. Die Reihe
     ist damit genauso hoch wie zuvor mit den Textzeilen — der Abschnitt
     wiegt in der Seite unverändert schwer, nur sein Fußende ist ruhig.
     Und 243px stehen weiter unter den größten Haufenstücken, die bei
     derselben Fensterbreite 300 bis 330px messen.

     Der Versuch, den Überhang stattdessen nach außen zu legen (40px
     Abstand, 123px Einrückung je Seite), fiel schon früher durch: Die
     Reihe stand dann nicht mehr bündig. */
  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team__member { margin: 0; }

  /* container-type, weil die Beschriftung in cqi steht — sie hängt an der
     Kachel, nicht am Fenster. Das ist hier wichtiger als bei den
     Disziplinen: Die Team-Kacheln sind schmal, und eine rem-Größe wäre auf
     ihnen je nach Browser-Grundschrift mal knapp und mal zu breit.

     Ohne Maske und ohne Filter, wie bei Arbeiten und Disziplinen: Die
     Rundung ist null, und die Porträts stehen roh in Farbe. Die
     Graustufen, die die vier Aufnahmen zu einer Reihe banden, sind auf
     Simons Ansage vom 6. August 2026 entfallen. */
  .team__bild {
    position: relative;
    container-type: inline-size;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-bild);
  }

  .team__portrait {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: inherit;
  }

  /* Alles in cqi, also in Prozent der Kachelbreite. Bei 243px Kachel sind
     das 14,6px Rand, 18,5px Name und 13,9px Rolle. Weil Rand und Schrift
     an derselben Größe hängen, bleibt das Verhältnis in jeder Kachelbreite
     gleich: Der längste Name, "Cem-Pierre Schuch", füllt immer 84 % der
     verfügbaren Breite — nie mehr, nie weniger.

     Ausnahme ist das Band zwischen 992 und rund 1180px Fenster. Dort steht
     die Reihe schon vierspaltig, aber die Kachel misst erst 169 bis 200px,
     und in reinem cqi wäre der Name 12,8px klein. Deshalb die Untergrenzen
     in max(): 13,5px für den Namen, 11,5 für die Rolle. Bei 169px Kachel
     füllt der längste Name damit 91 % statt 84 — eng, aber er passt, und
     ab 1180px greift wieder die reine cqi-Rechnung.

     In px und nicht in rem: rem hinge an der Browser-Grundschrift, und die
     hat mit der Kachelbreite nichts zu tun. */
  .team__fuss {
    position: absolute;
    left: 6cqi;
    right: 6cqi;
    bottom: 5.2cqi;
    z-index: 1;
  }

  /* Gemischt und halbfett, nicht versal und extrafett wie die Disziplinen.
     Der Unterschied ist gewollt: "VIDEO" ist eine Marke und darf rufen, ein
     Mensch heißt einfach so. Versal käme "CEM-PIERRE SCHUCH" außerdem auf
     107 % der Kachelbreite und passte gar nicht. */
  .team__name {
    display: block;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: max(13.5px, 7.6cqi);
    line-height: 1.2;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
  }

  /* 0fr auf 1fr statt max-height: Damit läuft die Bewegung genau bis zur
     tatsächlichen Texthöhe. Zwei der vier Rollen brauchen zwei Zeilen,
     zwei kommen mit einer aus — der Name hebt sich also unterschiedlich
     weit an, und genau das soll er. */
  .team__role {
    display: grid;
    grid-template-rows: 0fr;
    margin-top: 0;
    font-size: max(11.5px, 5.7cqi);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    opacity: 0;
    transition: grid-template-rows var(--dur-slow) var(--ease-out),
                opacity var(--dur) var(--ease-out),
                margin-top var(--dur-slow) var(--ease-out);
  }

  .team__role > span { overflow: hidden; }

  /* Die beiden Hälften der Rolle stehen untereinander, der senkrechte
     Strich aus den Daten fällt weg.

     Er stand vorher zwischen ihnen, und bei zwei von vieren brach die
     Zeile genau dort um — "Head of Production |" mit hängendem Strich am
     Zeilenende, darunter "Self‑Shooting Director". Ein Trennzeichen, das
     nichts mehr trennt, weil der Umbruch die Arbeit schon getan hat.

     Gestapelt stehen alle vier gleich: zwei Zeilen, keine Striche, und der
     Name hebt sich auf jeder Kachel gleich weit an. Das ist auch der
     richtige Ton — in einer Produktion steht so der Abspann. */
  .team__zeile { display: block; }

  .team__member:hover .team__role,
  .team__member:focus-within .team__role {
    grid-template-rows: 1fr;
    margin-top: 3.4cqi;
    opacity: 1;
  }

  /* Ohne Zeigegerät gibt es kein Überfahren — dort steht die Rolle immer.
     Dieselbe Entscheidung wie bei den Disziplinen. */
  @media (hover: none) {
    .team__role {
      grid-template-rows: 1fr;
      margin-top: 3.4cqi;
      opacity: 1;
    }
  }

  /* UNTERHALB VON 560px ZURÜCK UNTER DAS BILD.

     Zweispaltig wird die Kachel auf dem Telefon schmal: bei 375px Fenster
     misst sie 155px. In cqi wäre der Name dort 11,8px und die Rolle 8,8 —
     unlesbar. Eine rem-Untergrenze hilft nicht, sie ließe den Namen über
     die Kachel hinauslaufen.

     Also fällt die Beschriftung dort zurück unter das Bild, wo sie umbrechen
     darf. Das kostet nichts: Der Aufklapper ist eine Hover-Geste, und ein
     Telefon hat keinen Zeiger. 560px ist die Stelle, an der die zweispaltige
     Kachel unter 236px fällt — darüber trägt die Schrift auf dem Bild.

     In px und nicht in rem, wie alle Umbruchstellen hier: rem hängt in
     Medienabfragen an der Browser-Grundschrift, nicht an der Seite. */
  @media (max-width: 559.98px) {
    /* Kappen aus: Steht die Beschriftung im Fluss statt darüber, ist sie
       Teil der Figur und würde an deren Unterkante beschnitten. */
    .team__bild { overflow: visible; }

    .team__fuss {
      position: static;
      margin-top: var(--space-2);
    }

    .team__name {
      font-size: var(--fs-small);
      color: var(--on-dark);
      text-shadow: none;
    }

    /* text-wrap: balance, weil die Rollen Doppelnennungen sind. Ohne die
       Angabe füllt die erste Zeile sich bis zum Rand und lässt ein
       einzelnes Wort darunter stehen. */
    .team__role {
      display: block;
      margin-top: 0;
      font-size: var(--fs-small);
      color: var(--on-dark-muted);
      opacity: 1;
      text-wrap: balance;
    }
  }

  /* ── Die Kulisse unter den Porträts ──────────────────────────────────── */
  /* Aufbau nach dem Culture-Abschnitt von saltandpictures.de: vier
     Spalten, versetzte Reihen, Graustufen mit Farbe beim Überfahren,
     unter jedem Stück eine Pille und ein Titel in der Redaktionsschrift.
     Ohne das klebende Riesenwort — die Überschrift des Abschnitts steht
     über den Porträts und bleibt dort.

     Der Abstand nach oben trennt die Kulisse von der Porträtreihe. Er
     stand bei 7/13vw/11rem, als darunter zwei Haufen mit auseinander
     laufenden Stücken kamen und das oberste Stück 98px über seine Fläche
     hinausragte. Das Feld steht jetzt still in seinen Kanten; die Hälfte
     reicht. */
  .kulisse {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
    margin-top: clamp(3.5rem, 7vw, 6rem);
    list-style: none;
    padding: 0;
  }

  /* Der Versatz je Spalte, wie bei Featured Work. Über data-spalte und
     nicht über :nth-child: Ein Textfeld belegt zwei Plätze, damit zählt
     :nth-child ab dort die Spalten falsch. Welches Stück in welcher
     Spalte landet, rechnet das Frontmatter mit — siehe kulisse dort.

     Die beiden Textfelder beginnen in Spalte 1 und 3 und stehen damit
     ohne Versatz; das ist Absicht, sie sollen an der Reihenkante sitzen
     und nicht mitschwimmen. */
  .kulisse > li { align-self: start; margin-top: var(--rutsch, 0); }
  .kulisse > li[data-spalte='2'] { --rutsch: 12vh; }
  .kulisse > li[data-spalte='4'] { --rutsch: 6vh; }

  .kulisse__stueck { display: grid; gap: 10px; }

  .kulisse__stueck img {
    width: 100%;
    aspect-ratio: var(--r, 3 / 4);
    object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: filter var(--dur-slow) var(--ease-out);
  }

  .kulisse__stueck:hover img { filter: none; }

  @media (hover: none) {
    .kulisse__stueck img { filter: none; }
  }

  .kulisse__zeile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 0.75rem;
    font-size: 12px;
    line-height: 1.5;
  }

  .kulisse__pille {
    padding: 2px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .kulisse__nr {
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-muted);
  }

  .kulisse__titel {
    font-family: var(--font-editorial);
    font-weight: 500;
    font-size: clamp(0.9375rem, 1.4vw, 1.25rem);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Das Textfeld steht auf einem Bildplatz, nicht neben dem Feld: zwei
     Spalten breit und in der Höhe seiner Reihe mittig. Mittig und nicht
     oben, weil es sonst unter der höchsten Kachel der Reihe hinge; so
     schwimmt der Satz zwischen den Aufnahmen, die zu ihm gehören.

     container-type, weil der Vorspann in cqi gedeckelt ist: Er muss
     einzeilig bleiben, und der Deckel bezieht sich auf die Breite des
     Feldes — 100cqi geteilt durch --laenge ist genau der Grad, bei dem
     die Zeile die Spalte ausfüllt. Der Deckel greift erst auf dem
     Telefon.

     Der Wähler steht mit .kulisse > davor, nicht als Klasse allein:
     .kulisse > li setzt align-self: start und zählt mit dem Elementnamen
     eine Stufe höher als eine Klasse. Ohne den Vorsatz stünde der Satz
     oben an der Reihenkante, gemessen 18px unter ihr — die 18 kamen vom
     Einblenden, nicht von der Ausrichtung, und genau daran war der
     Fehler zuerst nicht zu sehen. */
  .kulisse > li.kulisse__satz {
    grid-column: span 2;
    align-self: center;
    container-type: inline-size;
    padding-block: var(--space-2);
  }

  /* 46ch, damit die Zeile im doppelt breiten Feld nicht über 60 Zeichen
     läuft. Ohne Deckel wären es bei 612px Feldbreite und 21,6px Schrift
     rund 56 — noch tragbar, aber der Satz ist der einzige Fließtext
     zwischen lauter Bildern und darf ruhig kompakt stehen. */
  .kulisse__satz p {
    max-width: 46ch;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--on-dark);
  }

  .kulisse__satz :global(strong.knapp) {
    font-size: min(1em, calc(100cqi / var(--laenge, 18.3)));
    font-weight: 600;
    white-space: nowrap;
  }

  /* Zwei Spalten, sobald das Feld unter etwa 200px je Stück fällt. Der
     Versatz entfällt dabei — zu zweit läse er sich als verrutschte
     Kachel —, und das Textfeld nimmt beide Spalten, steht also allein in
     seiner Reihe. */
  @media (max-width: 859.98px) {
    .kulisse { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kulisse > li[data-spalte='2'],
    .kulisse > li[data-spalte='4'] { --rutsch: 0; }
  }
  /* ── 10 · FAQ ─────────────────────────────────────────────────────────── */
  .faq__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .faq__head .label { margin-bottom: var(--space-2); }

  .faq__item { border-top: 1px solid var(--line); }
  .faq__item:last-child { border-bottom: 1px solid var(--line); }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 56px;
    padding-block: var(--space-2);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker { display: none; }

  .faq__icon { position: relative; flex-shrink: 0; width: 20px; height: 20px; }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    background: var(--petrol);
    transition: transform var(--dur) var(--ease-out);
  }

  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }

  .faq__a {
    padding-bottom: var(--space-3);
    color: var(--ink-muted);
    max-width: 58ch;
  }

  /* ── 11 · Bottom-CTA ──────────────────────────────────────────────────── */
  /* Linksbündig wie alles ab der Kundenleiste. Zentriert stand der
     Abschluss sonst als einziger Block auf einer Achse, die die Seite
     sonst nirgends mehr hat. */
  .cta__inner { display: grid; justify-items: start; gap: var(--space-3); }
  .cta__title { max-width: 16ch; }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  /* ── Breakpoints ──────────────────────────────────────────────────────── */
  @media (min-width: 768px) {
    .hero__cue { display: inline-flex; }
  }

  @media (min-width: 992px) {
    /* Drei Gründe nebeneinander erst ab 992. Bei 768px war eine Spalte
       204px breit — rund 24 Zeichen je Zeile, und die Überschrift
       "Inhaltliche Substanz" füllte sie schon allein. Ab 992 sind es 266px
       und bei 1440 dann 399. */
    .benefits__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    /* Vier Porträts über die volle Breite, bündig an beiden Kanten. Der
       Spaltenabstand setzt die Bildgröße — bei 1353px Reihe sind es 94px
       Abstand und 268px Bild:

         3 × 94                   = 282px für die Abstände
         (1353 − 282) ÷ 4         = 268px je Bild

       Die Reihe misst 1353 und nicht mehr 1252, seit der Abschnitt am
       6. August 2026 auf die volle Fensterbreite gegangen ist
       (.container--breit). Die Formel für den Abstand ist dieselbe
       geblieben, die Kacheln sind dadurch um 25px gewachsen.

       WARUM DER ABSTAND MITLÄUFT UND NICHT FEST IN PROZENT STEHT. Bei 7,5
       Prozent wäre er unten in der Abfrage 26px und oben 94 — dasselbe
       Verhältnis überall, aber nicht dieselbe Kachel: Bei 992px Fenster
       misst die Reihe nur 873px, und vier Bilder darin kamen auf 166px.
       Für Schrift im Bild ist das zu eng; der Name wäre auf seine
       Untergrenze von 13,5px gefallen und hätte 92 Prozent der Kachel
       gefüllt.

       Deshalb wächst der Abstand mit dem Fenster statt mit der Reihe: 26px
       bei 992, 94 bei 1440 und darüber gedeckelt. Das sind 15,18vw minus
       124,6px, die Gerade durch beide Punkte. Bündig bleibt die Reihe
       dabei — der Abstand ist eine Länge, die von der vollen Breite
       abgeht, kein Rand.

       Gemessen:

         Fenster   Abstand   Reihe   Kachel     Name
          992        26       927    212 x 265  16,1px
         1200        58      1105    233 x 291  17,7
         1440        94      1353    268 x 335  20,3
         1920        94      1825    386 x 482  29,3

       Im Browser nachgemessen, nicht gerechnet: vw zählt die Bildlaufleiste
       mit, die Reihe nicht.

       Die Reihe steht also unten dicht und oben luftig. Das ist gewollt:
       Auf einem schmalen Bildschirm zählt die Größe der Gesichter, auf
       einem breiten die Ruhe zwischen ihnen.

       Der Abstand war bis zum 5. August 2026 10,94 Prozent und die Kachel
       damit 210px. Er ist gesunken, weil Name und Rolle seither im Bild
       stehen: Der Textblock unter der Reihe fällt weg, und die Kachel darf
       die Höhe übernehmen, die er gebraucht hat. Die vollständige Rechnung
       steht oben bei .team__grid.

       Auf sehr breiten Schirmen wächst die Kachel mit: bei 1920px sind
       es 386px, bei 2560 rund 550. Das ist die Folge der vollen Breite
       und gewollt — der Name steht in cqi und wächst mit, das Verhältnis
       in der Kachel bleibt also gleich. Kleiner als die Stücke der
       Kulisse darunter bleiben die Gesichter weiterhin: 386 gegen 435
       bei 1920px.

       Erst ab 992 und nicht schon ab 768: Bei 768px kämen vier Bilder auf
       159px Breite — zweispaltig darunter sind es 344. Die Gesichter
       würden also kleiner, während das Fenster größer wird. Zwei Reihen zu
       zweit tragen diese Breite besser.

       Nur hier und nicht an .team__grid: Zweispaltig wäre derselbe Wert
       eine Lücke, kein Abstand. */
    .team__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: clamp(26px, 15.18vw - 124.6px, 94px);
    }
  }

  /* Das Disziplinenfeld erst ab 1200 nebeneinander.

     Bei 1024 misst die Konzept-Kachel im Zwoelfspaltigen 428px und traegt
     268 Zeichen — der Textblock fuellte dort drei Viertel der Kachel.
     Einspaltig hat sie an derselben Stelle 886px und kommt mit sechs
     Zeilen aus. Zwischen 1024 und 1200 steht das Feld deshalb
     untereinander. */
  @media (min-width: 1200px) {
    /* Video links, Konzept und Foto rechts — aber nichts fluchtet.

       Der Aufbau ist derselbe wie zu Anfang. Ordentlich sah er nicht
       deshalb aus, sondern weil alles bündig abschloss: Konzept und Foto
       exakt gleich breit, exakt übereinander, linke wie rechte Kanten auf
       einer Linie, und Videos Unterkante genau auf der von Foto.

       Jetzt liegt keine Kante auf einer anderen:

         Video    641 × 801   513k   links,  x   0 …  641
         Foto     641 × 427   274k   rechts, x 684 … 1325
         Konzept  527 × 351   185k   rechts, x 798 … 1325

       Drei verschiedene linke Kanten, drei verschiedene Höhen, drei
       verschiedene Unterkanten. Konzept ist schmaler als Foto und rückt
       von links ein, ragt also nicht mit ihm gleich weit.

       Die rechte Kante teilen sich Konzept und Foto. Das ist Absicht: Ein
       einziger durchgehender Strich hält das Feld zusammen, während alles
       andere versetzt liegt — dieselbe Regel wie bei Featured Work. Alle
       drei ohne jede gemeinsame Kante zerfielen in Einzelteile.

       Die Abstände sind bewusst knapp. Eine frühere Fassung setzte Foto
       100px unter die Zeile und Konzept 50px unter Video; zwischen den
       Kacheln stand dadurch mehr Leere als Bild.

       Dazu drei verschiedene Höhen: Konzept setzt tiefer an als Video,
       Foto noch einmal tiefer als die Zeile es verlangt. Die Versätze
       gehen ausschließlich nach unten — ein Zug nach oben hatte in einem
       früheren Anlauf den Text der Kachel darüber verdeckt.

       Video steht über beide Zeilen, füllt sie aber nicht mehr aus: Mit
       align-self: start behält es sein eigenes 4:5 aus den Daten und endet
       deutlich über dem unteren Rand des Abschnitts, statt mit Foto
       abzuschließen. Genau diese Bündigkeit war vorher das Ordentlichste
       am ganzen Feld. */
    .disziplinen {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 2.2vw, 2.25rem);
      row-gap: clamp(2rem, 4vw, 3rem);
    }

    /* Die beiden rechten Plätze sind getauscht: Konzept sitzt jetzt unten
       auf sechs Spalten, Foto oben auf fünf. Nur die Plätze — die Folge im
       Text bleibt Video, Konzept, Foto.

       Grund ist die Textlänge. Konzept trägt 268 Zeichen, Video 79 und
       Foto 92. Auf dem kleinsten Platz brauchte Konzept neun Zeilen und
       der Block reichte bis 115 Prozent der Kachelhöhe — der Text stand
       über den Rand hinaus und das Motiv war vollständig verdeckt. Der
       längste Text gehört auf die größte Fläche.

       Video wächst von 4:5 auf 2:3 mit. Sonst stünde die rechte Spalte
       994px hoch neben 764px links; jetzt sind es 994 zu 917. */
    .disziplin--1 { grid-column: 1 / span 6; grid-row: 1 / span 2; align-self: start; }
    .disziplin--2 { grid-column: 8 / span 5; grid-row: 1; }
    .disziplin--3 { grid-column: 7 / span 6; grid-row: 2; }

    .disziplin--2 { margin-top: clamp(2rem, 5.8vw, 6.25rem); }
    .disziplin--3 { margin-top: clamp(1rem, 2.6vw, 2.75rem); }

    /* Ab hier drei Spalten wie in der Referenz. Darunter zwei, damit die
       Bilder auf dem Handy nicht zu Briefmarken werden. */

  }

  /* FAQ zweispaltig ab 1024: Die Antworten wuerden in einer 768er Breite
     auf 20 Zeichen je Zeile zusammenlaufen. */
  @media (min-width: 1024px) {
    .faq__grid { grid-template-columns: 0.8fr 1.2fr; gap: clamp(3rem, 6vw, 6rem); }
    .faq__head { position: sticky; top: 7rem; }
  }

  /* ── Reduced Motion ───────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    /* Ohne Laufband bliebe ein Großteil der Logos unsichtbar. Statt den
       Streifen zu stauchen, wird er von Hand scrollbar. */
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__track { animation-name: none; }
    .marquee__track [aria-hidden='true'] { display: none; }
    .hero__cue { animation-name: none; }

    /* Der Text erscheint weiterhin beim Überfahren, die Zeile geht nur nicht
       mehr auf, sondern steht sofort. Ihn ganz wegzulassen wäre falsch:
       Reduzierte Bewegung heißt weniger Bewegung, nicht weniger Inhalt. */
    .disziplin__text { transition: opacity var(--dur-fast) linear; }

    /* Dasselbe für die Rollen im Team-Abschnitt — gleicher Aufklapper,
       gleiche Entscheidung. */
    .team__role { transition: opacity var(--dur-fast) linear; }

    /* Der Positionsabsatz steht vollständig aufgefärbt, ohne Scrollverlauf;
       die Meta-Zeile bekommt ihre Deckung zurück. Das Skript prüft
       dieselbe Abfrage und rührt beide dann nicht mehr an. */
    .statement__text :global(.wort) { color: #2451d8; transition: none; }
    .statement__meta { opacity: 1; }
  }
</style>

<script>
  // Die Disziplinen-Kacheln laufen beim Scrollen auf ihren Platz zu.
  //
  // Dieselbe Rechnung wie die Streublöcke weiter unten, aus einem Modul:
  // gleiche Zeitkonstante, gleicher Nachlauf, gleiches Verhalten beim
  // Verlassen des Fensters. Nur der Weg unterscheidet sich, und der steht
  // im CSS bei --dx.
  //
  // Je Kachel und nicht je Abschnitt: Ein gemeinsamer Wert hieße, dass
  // die unteren Kacheln längst stehen, bevor sie jemand sieht. Der Haufen
  // ist ein kompakter Block und kommt deshalb mit einem Wert aus.
  //
  // Featured Work hing bis zum 6. August 2026 mit hier drin; dort trägt
  // jetzt das klebende Riesenwort die Bewegung.
  import { nachlaufBinden } from '../scripts/nachlauf';

  nachlaufBinden(document.querySelectorAll<HTMLElement>('.disziplin'));
</script>

<script>
  // Der Positionsabsatz färbt sich beim Scrollen Wort für Wort auf.
  //
  // Die Wörter stehen von Anfang an — nichts blendet ein, nichts
  // verschiebt sich. Nur die Schriftfarbe läuft von einem Fünftel Deckung
  // auf volles Blau, und zwar der Reihe nach: Wie weit der Absatz durch
  // den Bildschirm gewandert ist, bestimmt, wie viele Wörter schon
  // stehen. Das Aufteilen muss das Skript machen, weil CSS keinen
  // Zugriff auf einzelne Wörter hat.
  //
  // Rekursiv über die Kindknoten und nicht über innerHTML: Der Absatz
  // enthält em, i und die Wortmarke; ein Ersetzen der Zeichenkette
  // zerstörte sie. So bleibt jedes Element erhalten und bekommt seine
  // Wörter einzeln verpackt.
  const absatz = document.querySelector<HTMLElement>('.statement__text');
  const metaZeile = document.querySelector<HTMLElement>('.statement__meta');
  const ruhigerAbsatz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (absatz && !ruhigerAbsatz) {
    const zerlegen = (knoten: Node) => {
      Array.from(knoten.childNodes).forEach((kind) => {
        if (kind.nodeType === Node.TEXT_NODE) {
          const teil = document.createDocumentFragment();
          // Der Trenner steht in der Klammer, damit die Leerzeichen im
          // Ergebnis bleiben — sonst klebten die Wörter aneinander.
          (kind.textContent ?? '').split(/(\s+)/).forEach((stueck) => {
            if (!stueck) return;
            if (/^\s+$/.test(stueck)) {
              teil.appendChild(document.createTextNode(stueck));
            } else {
              const wort = document.createElement('span');
              wort.className = 'wort';
              wort.textContent = stueck;
              teil.appendChild(wort);
            }
          });
          knoten.replaceChild(teil, kind);
        } else if (kind.nodeType === Node.ELEMENT_NODE) {
          zerlegen(kind);
        }
      });
    };

    zerlegen(absatz);
    const woerter = Array.from(absatz.querySelectorAll<HTMLElement>('.wort'));

    // Der Lauf beginnt, wenn der Absatz auf 82 Prozent der Fensterhöhe
    // steht, und ist kurz vor der Mitte fertig. Die Strecke ist seine
    // eigene Höhe plus 42 Prozent Fensterhöhe — dadurch dauert ein langer
    // Absatz länger als ein kurzer, statt beide gleich schnell
    // durchzulaufen.
    let angefordert = 0;

    const rechnen = () => {
      angefordert = 0;
      const kasten = absatz.getBoundingClientRect();
      const strecke = kasten.height + window.innerHeight * 0.42;
      const anteil = Math.min(1, Math.max(0, (window.innerHeight * 0.82 - kasten.top) / strecke));
      const stehen = Math.round(anteil * woerter.length);

      woerter.forEach((wort, i) => wort.classList.toggle('is-an', i < stehen));

      // Die Meta-Zeile kommt zum Schluss: Sie blendet über das letzte
      // Viertel des Laufs ein und steht damit sichtbar nach dem Absatz.
      if (metaZeile) {
        metaZeile.style.opacity = String(Math.min(1, Math.max(0, (anteil - 0.72) / 0.28)));
      }
    };

    const anstossen = () => {
      if (!angefordert) angefordert = requestAnimationFrame(rechnen);
    };

    window.addEventListener('scroll', anstossen, { passive: true });
    window.addEventListener('resize', anstossen, { passive: true });
    rechnen();
  }
</script>

<script>
  // Der Header folgt dem Hell-Dunkel-Schnitt.
  //
  // Ab "Featured Work" läuft die Seite auf Schwarz. Die solide Fläche des
  // Headers ist bis dahin weiß und muss ab dem Schnitt schwarz werden,
  // sonst steht ein weißer Balken über schwarzem Grund.
  //
  // Bezug ist die Oberkante des Abschnitts gegen die Höhe des Headers:
  // Sobald sie darunter liegt, steht schwarzer Grund hinter dem Header.
  const kopf = document.getElementById('site-header');
  const schnitt = document.querySelector('.section.work');

  if (kopf && schnitt) {
    let angefordertKopf = 0;

    const kopfPruefen = () => {
      angefordertKopf = 0;
      kopf.classList.toggle('is-dunkel', schnitt.getBoundingClientRect().top <= kopf.offsetHeight);
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!angefordertKopf) angefordertKopf = requestAnimationFrame(kopfPruefen);
      },
      { passive: true }
    );

    kopfPruefen();
  }
</script>

<script>
  // Ein Video lässt sich per CSS nicht anhalten. Wer reduzierte Bewegung
  // angefordert hat, bekommt deshalb ein Standbild statt der Schleife.
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;

  if (heroVideo) {
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');

    const anwenden = () => {
      if (ruhig.matches) {
        heroVideo.removeAttribute('autoplay');
        heroVideo.loop = false;
        heroVideo.pause();
      } else {
        heroVideo.loop = true;
        // play() kann abgelehnt werden, etwa im Energiesparmodus —
        // dann bleibt schlicht das erste Bild stehen.
        void heroVideo.play().catch(() => {});
      }
    };

    anwenden();
    ruhig.addEventListener('change', anwenden);
  }
</script>
