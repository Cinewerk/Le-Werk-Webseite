---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { withBase } from '../lib/paths';

// Die Kundenlogos liegen als ein durchgehender Streifen vor. Für die
// Endlosschleife läuft er zweimal hintereinander; der Track wandert um
// exakt eine Streifenbreite, dadurch ist der Übergang nahtlos.
const kundenlogos =
  'Henkell Freixenet, ServiceNow, Douglas, Seven.One Entertainment Group, ' +
  'Hugo Boss, Deutsche Welle, Shop Apotheke Europe, Street One, Siemens, ' +
  'Zehnder Group, North Kiteboarding';

// Tags spiegeln die Disziplinen-Rangfolge: Video zuerst, vertikal als Kern.
const works = [
  { img: '/images/work-01.jpg', w: 1600, h: 900,  tag: 'Social Video', title: 'Zwischen den Schichten', client: 'Nordlicht',  format: '16:9', alt: 'Filmklappe wird vor der Kamera bei einem Außendreh geschlossen' },
  { img: '/images/work-02.jpg', w: 1600, h: 900,  tag: 'Kampagne',     title: 'Alles auf Anfang',       client: 'Atlas & Co', format: '16:9', alt: 'Schnittplatz mit Videospur und Timeline auf mehreren Monitoren' },
  { img: '/images/work-03.jpg', w: 900,  h: 1600, tag: 'Vertikal',     title: 'Neun zu Sechzehn',       client: 'Superbloom', format: '9:16', alt: 'Filmset mit Kamera auf Dolly und farbigem Licht, vertikal gedreht' },
  { img: '/images/work-04.jpg', w: 1600, h: 900,  tag: 'Fotografie',   title: 'Haus voller Licht',      client: 'Hafen',      format: '3:2',  alt: 'Abgedunkelter Kinosaal mit rot beleuchteten Sitzreihen' },
];

const steps = [
  { n: '01', title: 'Konzept',            text: 'Vorgeschaltet, bei Bedarf mit Content-Strategie. Ziel, Kanäle und Formate stehen fest, bevor die erste Klappe fällt.' },
  { n: '02', title: 'Produktion',         text: 'Kompaktes Team, klarer Plan, Kampagnenniveau am Set. Interviewbasiert und dokumentarisch, mit Blick für Charaktere und Momente.' },
  { n: '03', title: 'Formate & Delivery', text: 'Vertikal als Kern, Landscape als Ableitung. Cutdowns und Stills entstehen aus derselben Produktion, sauber benannt und sofort einsetzbar.' },
];

const quotes = [
  { text: 'Wir haben aus einem Drehtag mehr Material bekommen als vorher aus drei — und es sah nach mehr aus, nicht nach weniger.', name: 'Marlene Kupfer', role: 'Head of Brand, Nordlicht', img: '/images/quote-01.jpg' },
  { text: 'Endlich ein Team, das versteht, dass ein vertikaler Cut kein Abfallprodukt ist.', name: 'Jonas Reuter', role: 'Marketing Lead, Atlas & Co', img: '/images/quote-02.jpg' },
  { text: 'Unser Content sieht endlich nicht mehr aus, als wäre er nebenbei am Handy entstanden.', name: 'David Okonkwo', role: 'Gründer, Superbloom', img: '/images/quote-03.jpg' },
];

// q darf Markup enthalten (Wortmarke), wird unten mit set:html gerendert
const faqs = [
  { q: 'Was kostet eine Produktion bei <span class="brand">Le Werk</span>?', a: 'Das hängt an Drehtagen, Team und Formatumfang. Kompakte Social-Produktionen starten im mittleren vierstelligen Bereich, größere Kampagnen liegen fünfstellig. Nach einem 20-minütigen Gespräch bekommt ihr eine belastbare Spanne — kein Zahlenraten.' },
  { q: 'Macht ihr auch UGC- oder Handy-Content?', a: 'Nein. Das ist ein anderer Markt mit anderen Preisen und anderem Anspruch. Bei uns entstehen Visuals auf Kampagnenniveau — auch dann, wenn sie am Ende vertikal im Feed laufen. Wer schnellen, günstigen Durchsatz sucht, ist bei uns falsch.' },
  { q: 'Bekommen wir Foto und Video aus einer Produktion?', a: 'Ja, das ist der Kern unserer Arbeitsweise. Wir planen Sets so, dass bewegte und stehende Bilder parallel entstehen. Das spart einen kompletten Produktionstag und sorgt dafür, dass Foto und Video wie eine Kampagne aussehen — nicht wie zwei.' },
  { q: 'Wie lange dauert es von der Anfrage bis zum fertigen Material?', a: 'Für eine kompakte Produktion rechnet mit drei bis vier Wochen: eine Woche Konzept, ein bis zwei Drehtage, ein bis zwei Wochen Post. Bei laufenden Content-Paketen verkürzt sich das deutlich, weil Setup und Look bereits stehen.' },
  { q: 'Wie ist das mit den Nutzungsrechten?', a: 'Ihr erhaltet standardmäßig zeitlich und räumlich unbegrenzte Nutzungsrechte für alle eigenen Kanäle. Für Paid Media, Out-of-Home oder TV klären wir Buyouts vorab transparent im Angebot — keine Nachforderungen.' },
  { q: 'Was bieten eure Workshops?', a: 'Drei Formate: Auftreten und Sprechen vor der Kamera, ein Social-Media-Basistraining zu Formatlogik und Bildsprache sowie Teambuilding und interne Kommunikation über Improtheater-Training. Umfang, Dauer und Teilnehmerzahl stimmen wir auf euer Team ab.' },
];
---

<BaseLayout
  title="Le Werk — Visual Content Studio für Film und Foto"
  description="Content Creation. Film und Foto. Für Marken mit Anspruch. Le Werk produziert Social Content und vertikale Formate auf Kampagnenniveau — mit redaktioneller Tiefe statt schnellem Knall."
  heroDark={true}
>
  <!-- ═══ 1 · HERO ═══════════════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <!-- muted und playsinline sind Bedingung dafür, dass mobile Browser
           überhaupt selbst starten. Die Datei hat keine Tonspur.
           Bei prefers-reduced-motion hält ein Skript das Video an. -->
      <video
        id="hero-video"
        autoplay muted loop playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={withBase('/videos/cinewerk_filmproduktion_koeln_header_klein.mp4')} type="video/mp4" />
      </video>
    </div>

    <!-- Text sitzt in der unteren linken Ecke und läuft bewusst nicht über
         die ganze Breite. Randabstand = --edge, damit er mit dem Logo im
         Header auf einer Achse liegt. -->
    <div class="hero__inner">
      <h1 class="hero__statement" id="hero-title" lang="en">
        <span class="brand">Le Werk</span> is a visual content studio crafting
        brand content worth watching.
      </h1>
    </div>

    <a class="hero__cue" href="#trust" aria-label="Weiter zum Inhalt scrollen">
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- ═══ 2 · TRUSTBAR (Logo-Marquee) ════════════════════════════════════ -->
  <section class="section section--tight trust" id="trust" aria-label="Auswahl unserer Kunden">
    <div class="container">
      <p class="label trust__label">Vertrauen auf <span class="brand">Le Werk</span></p>
    </div>

    <div class="marquee">
      <div class="marquee__track">
        <img
          class="marquee__strip"
          src={withBase('/images/logokarusell.png')}
          alt={`Kundenlogos: ${kundenlogos}`}
          width="5000" height="400" loading="lazy" decoding="async"
        />
        <!-- zweite Kopie nur für die Schleife, für Screenreader unsichtbar -->
        <img
          class="marquee__strip"
          src={withBase('/images/logokarusell.png')}
          alt="" aria-hidden="true"
          width="5000" height="400" loading="lazy" decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ═══ 3 · POSITIONIERUNG (Ein-Zeilen-Sektion) ════════════════════════ -->
  <section class="section statement" aria-labelledby="statement-title">
    <div class="container">
      <p class="statement__text" id="statement-title" data-reveal>
        <span class="brand">Le Werk</span> ist ein <strong>Visual Content Studio</strong> für Marken
        mit Anspruch — <span class="editorial">Handwerk auf Kampagnenniveau, erzählt mit Substanz.</span>
      </p>
    </div>
  </section>

  <!-- ═══ 4 · ARBEITEN ═══════════════════════════════════════════════════ -->
  <section class="section section--dark work" id="arbeiten" aria-labelledby="work-title">
    <div class="container">
      <header class="work__head" data-reveal>
        <h2 class="headline headline--xl" id="work-title">
          <span class="editorial editorial--kicker">Ausgewählte</span>
          Arbeiten
        </h2>
        <p class="lead">
          Ein Auszug aus laufenden und abgeschlossenen Produktionen. Gedacht wird
          vom vertikalen Format aus — Landscape entsteht als Ableitung, nicht
          umgekehrt.
        </p>
      </header>

      <div class="work__grid">
        {works.map((w, i) => (
          <article class={`work__item work__item--${i + 1}`} data-reveal data-reveal-delay={i * 80}>
            <a class="work__link" href={withBase("/services")}>
              <figure class="work__figure" data-format={w.format}>
                <img src={withBase(w.img)} alt={w.alt} width={w.w} height={w.h} loading="lazy" decoding="async" />
                <figcaption class="work__tag">{w.tag}</figcaption>
              </figure>
              <p class="work__caption">
                <span class="work__title">{w.title}</span>
                <span class="work__client">— {w.client}</span>
                <span class="work__format">{w.format}</span>
              </p>
            </a>
          </article>
        ))}
      </div>

      <p class="work__more" data-reveal>
        <a class="link-underline" href={withBase("/services")}>
          Alle Leistungen ansehen <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ═══ 5 · SERVICES-TEASER ════════════════════════════════════════════ -->
  <section class="section section--sand services" aria-labelledby="services-title">
    <div class="container">
      <header class="sec-head" data-reveal>
        <p class="label"><span class="mark" aria-hidden="true">✳</span>Was wir machen</p>
        <h2 class="headline" id="services-title">
          <span class="editorial editorial--kicker">Vier Wege,</span>
          eine Handschrift
        </h2>
        <p class="lead">
          Video ist die Hauptdisziplin, Fotografie die klare Zweite, Konzept
          läuft vorgeschaltet. Dazu geben wir unser Handwerk in Workshops weiter.
        </p>
      </header>

      <ul class="services__grid">
        {services.map((s, i) => (
          <li class="service" data-reveal data-reveal-delay={i * 70}>
            <a class="service__link" href={withBase(s.href)}>
              <span class="service__media">
                <img src={withBase(s.img)} alt="" width="1200" height="900" loading="lazy" decoding="async" />
              </span>
              <span class="service__body">
                <span class="service__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="service__title">{s.label}</span>
                <span class="service__text">{s.text}</span>
                <span class="service__cta" aria-hidden="true">Mehr erfahren →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ 6 · VORTEILE ═══════════════════════════════════════════════════ -->
  <section class="section benefits" aria-labelledby="benefits-title">
    <div class="container">
      <header class="sec-head" data-reveal>
        <p class="label"><span class="mark" aria-hidden="true">✳</span>Warum <span class="brand">Le Werk</span></p>
        <h2 class="headline" id="benefits-title">
          <span class="editorial editorial--kicker">Drei Gründe,</span>
          uns anzurufen
        </h2>
      </header>

      <ol class="benefits__list">
        <li class="benefit" data-reveal>
          <span class="benefit__num" aria-hidden="true">01</span>
          <h3 class="benefit__title">Handwerk auf Kampagnenniveau</h3>
          <p class="benefit__text">
            Hochwertig produzierte Visuals in Bild und Bewegtbild — mit den
            Maßstäben an Licht, Bildgestaltung und Post, die eine Kampagne
            verlangt. Kein Handy-Standard, kein UGC-Look.
          </p>
        </li>
        <li class="benefit" data-reveal data-reveal-delay="80">
          <span class="benefit__num" aria-hidden="true">02</span>
          <h3 class="benefit__title">Substanz statt Strohfeuer</h3>
          <p class="benefit__text">
            Redaktionelle Tiefe, ehrlich erzählte Geschichten, menschliche
            Momente. Kein Content, der schnell knallt und genauso schnell
            wieder weg ist.
          </p>
        </li>
        <li class="benefit" data-reveal data-reveal-delay="160">
          <span class="benefit__num" aria-hidden="true">03</span>
          <h3 class="benefit__title">Format-Vielfalt aus einem Auftrag</h3>
          <p class="benefit__text">
            Vertikal ist bei uns kein Beschnitt am Ende, sondern der
            Ausgangspunkt der Planung. Landscape, Square und Stills entstehen
            als Ableitung derselben Produktion.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══ 7 · SO FUNKTIONIERT ES ═════════════════════════════════════════ -->
  <section class="section section--sand steps" aria-labelledby="steps-title">
    <div class="container">
      <header class="sec-head" data-reveal>
        <p class="label"><span class="mark" aria-hidden="true">✳</span>Ablauf</p>
        <h2 class="headline" id="steps-title">So funktioniert es</h2>
      </header>

      <ol class="steps__list">
        {steps.map((s, i) => (
          <li class="step" data-reveal data-reveal-delay={i * 90}>
            <span class="step__num editorial" aria-hidden="true">{s.n}</span>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__text">{s.text}</p>
          </li>
        ))}
      </ol>

      <div class="steps__cta" data-reveal>
        <p class="steps__cta-text">Klingt nach eurem nächsten Projekt?</p>
        <a class="btn" href={withBase("/kontakt")}>
          Projekt anfragen <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 8 · ÜBER UNS ═══════════════════════════════════════════════════ -->
  <section class="section about" aria-labelledby="about-title">
    <div class="container about__grid">
      <figure class="about__media" data-reveal>
        <img src={withBase("/images/about.jpg")} alt="Das Team von Le Werk bei der gemeinsamen Konzeptarbeit" width="1400" height="1050" loading="lazy" decoding="async" />
      </figure>

      <div class="about__body" data-reveal data-reveal-delay="90">
        <p class="label"><span class="mark" aria-hidden="true">✳</span>Über uns</p>
        <h2 class="headline" id="about-title">
          <span class="editorial editorial--kicker">Handwerk trifft</span>
          Substanz
        </h2>
        <div class="prose about__prose">
          <p>
            <span class="brand">Le Werk</span> produziert Visual Content für Marken, deren Inhalte
            dort stattfinden, wo Menschen wirklich hinschauen: im Feed, auf der
            Landingpage, im Store. Video ist unsere Hauptdisziplin, Fotografie
            die klare Zweite.
          </p>
          <p>
            Erzählt wird interviewbasiert und dokumentarisch — mit Blick für
            Charaktere und Momente statt für den schnellen Effekt. Das kostet
            mehr Zeit als ein Clip vom Handy und hält dafür länger.
          </p>
          <p class="about__origin">Based in Köln, booked worldwide.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 9 · STIMMEN ════════════════════════════════════════════════════ -->
  <section class="section section--dark voices" aria-labelledby="voices-title">
    <div class="container">
      <header class="sec-head" data-reveal>
        <p class="label"><span class="mark" aria-hidden="true">✳</span>Stimmen</p>
        <h2 class="headline" id="voices-title">Was Kunden sagen</h2>
      </header>

      <div class="voices__list">
        {quotes.map((q, i) => (
          <figure class={`voice voice--${i % 2 === 0 ? 'left' : 'right'}`} data-reveal>
            <blockquote class="voice__quote editorial">„{q.text}“</blockquote>
            <figcaption class="voice__cite">
              <img class="voice__portrait" src={withBase(q.img)} alt="" width="240" height="240" loading="lazy" decoding="async" />
              <span>
                <span class="voice__name">{q.name}</span>
                <span class="voice__role">{q.role}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>

      <p class="voices__more" data-reveal>
        <a class="link-underline" href={withBase("/kontakt")}>
          Euer Projekt als nächstes? <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ═══ 10 · FAQ ═══════════════════════════════════════════════════════ -->
  <section class="section faq" aria-labelledby="faq-title">
    <div class="container faq__grid">
      <header class="faq__head" data-reveal>
        <p class="label"><span class="mark" aria-hidden="true">✳</span>Häufige Fragen</p>
        <h2 class="headline" id="faq-title">Kurz beantwortet</h2>
      </header>

      <div class="faq__list" data-reveal data-reveal-delay="80">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span set:html={f.q} />
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq__a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 11 · BOTTOM-CTA ════════════════════════════════════════════════ -->
  <section class="section section--dark cta" aria-labelledby="cta-title">
    <div class="container cta__inner" data-reveal>
      <h2 class="headline headline--xl cta__title" id="cta-title">
        <span class="editorial editorial--kicker">Erzählt uns</span>
        von eurem Projekt
      </h2>
      <p class="lead cta__lead">
        Ein Anruf, zwanzig Minuten, danach wisst ihr, ob wir passen —
        und in welchem Rahmen sich euer Vorhaben bewegt.
      </p>
      <div class="cta__actions">
        <a class="btn btn--on-dark" href={withBase("/kontakt")}>
          Projekt anfragen <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="mailto:contact@lewerk.de">contact@lewerk.de</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Gemeinsamer Sektionskopf ─────────────────────────────────────────── */
  .sec-head {
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .sec-head .label { margin-bottom: var(--space-2); }

  /* ── 1 · Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: clamp(8rem, 18vh, 12rem) clamp(4rem, 10vh, 7rem);
    background: var(--petrol-deep);
    color: var(--on-dark);
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: 0; z-index: 0; }

  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bewusst ohne Graustufen-/Blend-Filter: Auf einem formatfüllenden
       Video kosten die richtig Rechenzeit, und das Material ist von sich
       aus dunkel und petrolstichig. Es bleibt beim Abdunkeln. */
    filter: brightness(0.82) contrast(1.04);
  }

  .hero__media::after { content: ''; position: absolute; inset: 0; }

  /* Lesbarkeitsverlauf. Da der Text jetzt nur unten links sitzt, trägt
     vor allem der Verlauf von unten; die Werte sind über mehrere
     Videoframes gemessen, nicht geschätzt. */
  .hero__media::after {
    background:
      linear-gradient(0deg, rgba(4, 37, 44, 0.94) 0%, rgba(4, 37, 44, 0.55) 28%, rgba(4, 37, 44, 0.1) 55%, rgba(4, 37, 44, 0.45) 100%),
      linear-gradient(90deg, rgba(4, 37, 44, 0.7) 0%, rgba(4, 37, 44, 0.25) 45%, rgba(4, 37, 44, 0) 70%);
  }

  /* Randabstand wie im Header, damit Text und Logo auf einer Achse sitzen */
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: var(--edge);
  }

  /* Die Wortmarke darf laut Markenregel nicht in Versalien stehen —
     deshalb bleibt der Satz gemischt gesetzt statt, wie in der Referenz,
     durchgehend groß. */
  .hero__statement {
    max-width: 32ch;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: clamp(1.375rem, 2.8vw, 2.375rem);
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--on-dark);
    text-wrap: pretty;
  }


  .hero__cue {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 6vh, 3.5rem);
    z-index: 1;
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    animation: cue 2.4s var(--ease-out) infinite;
  }

  @keyframes cue {
    0%, 100% { transform: translateY(0); opacity: 0.75; }
    50%      { transform: translateY(6px); opacity: 1; }
  }

  /* ── 2 · Trustbar ─────────────────────────────────────────────────────── */
  /* Der Logostreifen hat oben und unten eigenen Rand — deshalb hier
     weniger Abstand, sonst reißt die Sektion auseinander. */
  .trust__label { margin-bottom: 0; }
  .trust .marquee { margin-block: calc(var(--space-2) * -1); }

  .marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    align-items: center;
    /* muss 0 bleiben: Der Track wandert um 50 % seiner Breite. Ein Abstand
       zwischen den beiden Kopien würde diese Rechnung verschieben und die
       Schleife sichtbar springen lassen. Der Streifen bringt seinen
       Randabstand selbst mit. */
    gap: 0;
    width: max-content;
    animation: marquee 40s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track { animation-play-state: paused; }

  @keyframes marquee {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  /* Höhe steuert die Größe, die Breite folgt dem Seitenverhältnis 12,5:1.
     Die Logos sitzen mit Luft im Streifen, deshalb ist er höher als die
     Logos selbst wirken. */
  .marquee__strip {
    height: clamp(80px, 9vw, 128px);
    width: auto;
    max-width: none;
    opacity: 0.72;
    transition: opacity var(--dur) var(--ease-out);
  }

  .marquee:hover .marquee__strip { opacity: 1; }

  /* ── 3 · Positionierung ───────────────────────────────────────────────── */
  .statement { padding-block: clamp(4rem, 9vw, 7.5rem); }

  .statement__text {
    max-width: 26ch;
    font-size: var(--fs-statement);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .statement__text strong { font-weight: 600; color: var(--petrol); }
  .statement__text .editorial { font-weight: 400; }

  /* ── 4 · Arbeiten ─────────────────────────────────────────────────────── */
