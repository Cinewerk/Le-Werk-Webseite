---
import BaseLayout from '../layouts/BaseLayout.astro';
import Streublock from '../components/Streublock.astro';
import { services } from '../data/services';
import { arbeiten } from '../data/arbeiten';
import { withBase } from '../lib/paths';

// Der Dateiname des Bühnenvideos ist bewusst neutral gehalten: Er steht im
// Quelltext jeder Seite, und laut Markenarchitektur wird die Schwestermarke
// ausschließlich im Impressum genannt. Details in docs/bildmaterial.md.

// Die Kundenlogos, einzeln statt als ein Streifenbild. Für die
// Endlosschleife läuft die Liste zweimal hintereinander; der Track wandert
// um exakt eine Listenbreite, dadurch ist der Übergang nahtlos. Das setzt
// voraus, dass der Abstand zwischen den Logos im Logo selbst steckt — als
// padding an .marquee__logo und nicht als gap am Track. Ein gap läge auch
// zwischen den beiden Kopien und würde die Rechnung um genau einen Abstand
// verschieben; die Schleife spränge sichtbar.
//
// Die Größe steckt nicht in diesen Daten, sondern in einem Kasten im CSS:
// Jedes Logo bekommt dieselbe Höchstbreite und dieselbe Höchsthöhe und
// wächst darin so weit, wie es sein Seitenverhältnis zulässt. Breite
// Wortmarken stoßen an die Breite, hohe Bildmarken an die Höhe.
//
// Das ist die Ordnung, die der frühere Streifen hatte — nachgemessen an
// dessen Bilddatei: Siemens, Douglas, Street One und Seven.One standen
// dort alle zwischen 80 und 120px breit, Zehnder als einzige hohe Marke
// bei 63 x 54. Auf gleiche Höhe gebracht wären die Wortmarken dreimal so
// schwer wie die Bildmarken.
//
// b und h sind die Maße der freigestellten Dateien und stehen nur wegen
// des width/height-Attributs hier — sie verhindern, dass die Zeile beim
// Laden springt. Freigestellt heißt: auf den Kasten beschnitten, in dem
// überhaupt Farbe steht. Die Lieferung hatte sehr unterschiedlich viel
// durchsichtigen Rand — Siemens stand in einem 2400er Quadrat, in dem die
// Wortmarke nur 364px hoch war.
//
// url führt auf die Seite des Unternehmens. Jede Adresse ist per Abruf
// geprüft; zwei Anmerkungen dazu:
//
//   douglas.de   antwortet einem Abruf ohne Browser mit 400. Das ist ein
//                Bot-Schutz, keine tote Adresse — DNS, TLS und die
//                Umleitung auf www greifen. douglas.com wäre falsch, die
//                Adresse führt zu einer gleichnamigen Firma in Kanada.
//   olympics.com bricht denselben Abruf ab, ist aber belegt: olympic.org
//                leitet mit 301 genau dorthin.
//
// Wo es eine deutsche Fassung gibt, steht sie hier — siemens.de leitet
// sauber auf siemens.com/de-de.
// Bezugskasten für die Leiste. Der Wert steht hier und in .marquee als
// --logo-breite; das Verhältnis 2.35 verbindet beide.
const LOGO_VERHAELTNIS = 94 / 40;

// Wie breit ein Logo im Verhältnis zur vollen Kastenbreite läuft. Breite
// Wortmarken bekommen die ganze Breite, hohe Bildmarken so viel, wie ihre
// Höhe zulässt.
//
// Gerechnet statt eingetragen, damit der Wert beim Austausch einer Datei
// nicht veraltet — er hängt nur an b und h.
//
// Warum überhaupt je Logo: Eine feste Kastenbreite für alle sah aus wie
// unterschiedliche Abstände. Ein schmales Logo saß mittig in einem 94px
// breiten Kasten und brachte bis zu 55px Leerraum mit, der sich zur Lücke
// addierte — gemessen zwischen 38px und 87px. Und der naheliegende Weg
// über max-width geht nicht: Bindet max-width, rechnet der Browser die
// Höhe nicht zurück, die Wortmarken werden auf volle Kastenhöhe gezogen.
//
// weite ist die Ausnahme von der Regel und steht deshalb je Logo in den
// Daten, nicht hier: Sie lässt eine Marke breiter laufen als den Kasten.
// Gebraucht wird das von den beiden längsten Wortmarken, Johnson &
// Johnson und HUGO BOSS — jenseits von etwa 7 : 1 fällt ein Logo im
// Kasten unter 12px Höhe und damit unter die übrigen Wortmarken.
const logoBreite = (k) =>
  (Math.min(1, k.b / k.h / LOGO_VERHAELTNIS) * (k.weite ?? 1)).toFixed(4);

const kunden = [
  { datei: 'siemens',     name: 'Siemens',                      url: 'https://www.siemens.de/',          b: 330, h:  51 },
  { datei: 'street-one',  name: 'Street One',                   url: 'https://www.street-one.de/',       b: 330, h:  48 },
  { datei: 'douglas',     name: 'Douglas',                      url: 'https://www.douglas.de/',          b: 330, h:  61 },
  { datei: 'allianz',     name: 'Allianz',                      url: 'https://www.allianz.de/',          b: 330, h:  86 },
  { datei: 'olympia',     name: 'Olympische Spiele',            url: 'https://www.olympics.com/',        b: 252, h: 118 },
  { datei: 'paralympics', name: 'Paralympisches Komitee',       url: 'https://www.paralympic.org/',      b: 192, h: 141 },
  { datei: 'ea',          name: 'EA',                           url: 'https://www.ea.com/de-de',         b: 159, h: 160 },
  { datei: 'formel-d',    name: 'Formel D',                     url: 'https://www.formeld.com/de/',      b: 189, h: 143 },
  { datei: 'sevenone',    name: 'Seven.One Entertainment Group', url: 'https://www.seven.one/',           b: 330, h:  74 },
  { datei: 'zehnder',     name: 'Zehnder Group',                url: 'https://www.zehndergroup.com/',    b: 171, h: 152 },
  // Zweite Marke mit weite: 8,3 : 1, im Kasten 10px hoch und damit die
  // kleinste Schrift der Leiste — kleiner als Johnson & Johnson nach
  // deren Korrektur, was die Reihenfolge der Ausnahmen auf den Kopf
  // stellen würde. 1.19 hebt sie auf dieselben 12px, sie läuft dafür
  // 100px breit statt 84.
  { datei: 'hugo-boss',   name: 'HUGO BOSS',                    url: 'https://www.hugoboss.com/de/',     b: 200, h:  24, weite: 1.19 },
  // Mit 10,7 : 1 die mit Abstand breiteste Marke; im Kasten käme sie auf
  // 8px Höhe — halb so hoch wie Douglas und kaum noch lesbar. Der Faktor
  // 1.52 hebt sie auf 12px und damit auf dieselbe Höhe wie Street One.
  // Sie läuft dafür 128px breit statt 84; das ist der Preis und bei einer
  // so langen Wortmarke vertretbar.
  { datei: 'johnson-johnson', name: 'Johnson & Johnson',        url: 'https://www.jnj.com/de-de',        b: 330, h:  31, weite: 1.52 },
];

// Die fünf Projekte liegen in src/data/arbeiten.ts, weil die Unterseiten
// unter /arbeiten/<slug> dieselben Angaben brauchen.

// Auf der Startseite erscheinen nur die drei Produktionsdisziplinen.
// Workshops bleiben über Menü, Footer und /services erreichbar.
//
// Eigene Reihenfolge, weil die Kästen hier anders liegen: Video groß links,
// Idee & Konzept rechts oben, Foto rechts unten. Sie steht über die Adresse
// und nicht über den Listenplatz — sonst würde eine Umsortierung in
// services.ts das Layout still verschieben.
const reihenfolge = ['/services/video', '/services/konzept', '/services/foto'];
const disziplinen = services
  .filter((s) => s.disziplin)
  .sort((a, b) => reihenfolge.indexOf(a.href) - reihenfolge.indexOf(b.href));

// Echte Aufnahmen vom Set, ausgewählt aus dem gelieferten Ordner. Neun von
// zwanzig — die Auswahl erzählt eine Produktion von vorn bis hinten: Team,
// Set, Dreh, Detail, Schnitt. Aussortiert wurde alles, was keine
// Produktion zeigt (Reise- und Straßenmotive) sowie doppelte Situationen.
//
// Die Reihenfolge steuert das Raster: Reihe 1 und 3 liegen quer, Reihe 2
// steht hoch. Die Originale liegen unter quellbilder/bts und sind nicht
// Teil des Repos; hier stehen auf Webmaß gerechnete Fassungen.
//
// x und w sind Prozente der Haufenbreite, y ist Prozent der Haufenhöhe.
// Wie weit ein Stück beim Scrollen wandert, steht hier bewusst nicht: Das
// rechnet Streublock.astro aus der Lage aus — der Weg zeigt von der Mitte
// der Fläche weg, ein mittiges Stück wandert kaum, ein äußeres am weitesten.
//
// Die Anordnung ist an der Referenz nachgemessen und nicht geschätzt: Dort
// überlappen sich sechs Bilder kräftig, die Größen reichen von 30 bis 45
// Prozent der Breite, und die Fläche steht hochkant. Genau das macht den
// Haufen aus — meine erste Fassung lag zu weit auseinander und las sich
// als Collage statt als Stapel.
//
// Beim Umsortieren gilt: y (in Höhenprozent) mal Höhe plus die aus w und
// ar folgende Höhe muss unter 100 bleiben, sonst hängt ein Stück heraus.
const bts = [
  // Sechs Aufnahmen, fünf davon aus der Lieferung vom 4. August 2026. Nur
  // das Loft-Bild in der Mitte stammt noch aus dem ersten Satz.
  //
  // Ausgewählt ist nach Situation, nicht nach Motivqualität allein: Keine
  // zwei Bilder zeigen denselben Raum. Werkhalle, Transporter, Loft,
  // Studio, Büro, Schnittplatz — das ist die Bandbreite, die der Absatz
  // daneben behauptet ("Spezialisten aus verschiedenen Feldern"), und die
  // vorige Auswahl löste sie nicht ein: Vier der sechs Bilder standen in
  // einem hellen Studio.
  //
  // Farbe war die zweite Vorgabe. Die Reihe trägt jetzt einen Leitton je
  // Bild — Gelb an der Maschine, Rot am Tankstellendach, Blau und Orange
  // im Studio, Petrol an der Bürowand, Grün am Schnittplatz. Vorher war
  // der Haufen fast durchgehend weiß-grau.
  //
  // Aus den zwölf gelieferten Dateien sind sechs nicht verwendet: vier
  // sind private Aufnahmen (Filmscans, ein Porträt im Trainingsanzug), und
  // zwei zeigen dasselbe Studio wie bts-studio, nur enger.
  //
  // Jedes Stück steht in seinem eigenen Seitenverhältnis, nicht in einem
  // vorgegebenen: 3:2, 2:3, 5:4, 3:4. Die Abweichung zum echten Maß der
  // Datei liegt überall unter 0,1 Prozent — es wird also an keinem Bild
  // etwas abgeschnitten.
  //
  // Die Überlappungen liegen dort, wo die Aufnahme nichts verliert. Jedes
  // Stück deckt nur die Unterkante oder eine untere Ecke des Stücks
  // darunter zu; dort sind bei diesen Motiven Boden, Tisch und Vordergrund,
  // während Gesichter, Kameras und Monitore oben sitzen. Die z-Werte laufen
  // deshalb streng von oben links nach unten rechts durch.
  //
  // WICHTIG BEIM UMSORTIEREN: Die beiden Hochformate stehen diagonal —
  // der Transporter oben rechts, der Schnittplatz unten links, waagerechte
  // Überschneidung null. Zwei Hochformate untereinander lesen sich als
  // Säule und brechen den Haufen; das ist keine Feinheit, sondern fällt
  // sofort auf.
  { img: '/images/bts/bts-halle.jpg',       alt: 'Dreiköpfiges Team in einer Werkhalle: einer beugt sich über die Kamera auf dem Stativ, dahinter ein Monitorplatz und eine Softbox', x: 0,  y: 0,  w: 45, ar: '3 / 2', z: 1 },
  { img: '/images/bts/bts-transporter.jpg', alt: 'Zwei Frauen sitzen mit einem Laptop im Transporter, die Schiebetür steht offen, dahinter eine Tankstelle',                          x: 59, y: 2,  w: 33, ar: '2 / 3', z: 2 },
  { img: '/images/bts/bts-loft.jpg',        alt: 'Zwei Personen an einer Kamera auf dem Körperstativ in einem hellen Studio',                                                         x: 15, y: 21, w: 41, ar: '5 / 4', z: 3 },
  { img: '/images/bts/bts-schnitt.jpg',     alt: 'Zwei Personen am Schnittplatz vor mehreren Monitoren, daneben ein Fenster mit Zimmerpflanzen',                                      x: 0,  y: 47, w: 31, ar: '3 / 4', z: 4 },
  { img: '/images/bts/bts-studio.jpg',      alt: 'Studioaufbau vor blauer Wand: ein weißer Hocker, zwei Kameras auf Stativen, Softboxen und eine Tonangel über orangem Bodenband',    x: 52, y: 41, w: 40, ar: '3 / 2', z: 5 },
  { img: '/images/bts/bts-buero.jpg',       alt: 'Zwei Männer vor einer petrolfarbenen Bürowand, davor ein schwarz abgedecktes Gerät',                                                x: 26, y: 63, w: 44, ar: '3 / 2', z: 6 },
];

// Die sechs vom Kunden gelieferten Aufnahmen, unverändert in der Auswahl.
//
// Zwei Bedingungen bestimmen die Anordnung, beide fallen sofort auf, wenn
// sie verletzt sind:
//
// Die zwei Außenansichten des Hauses — haus-01 im Abendlicht und die
// Drohnenaufnahme — liegen in gegenüberliegenden Ecken, oben links und
// unten rechts. Nebeneinander läsen sie sich als ein Motiv in zwei
// Anläufen.
//
// Die zwei Hochformate — haus-03 oben rechts, haus-06 unten links — stehen
// diagonal, waagerechte Überschneidung null. Untereinander ergäben sie eine
// Säule und brächen den Haufen auf.
//
// Auch hier steht jedes Stück in seinem eigenen Seitenverhältnis, es wird
// also nirgends beschnitten. Einzige Ausnahme ist die Drohnenaufnahme: Sie
// kommt als 16:9 aus der Kamera und ist auf 3:2 zugeschnitten — 450px am
// linken Rand, wo nur Gehweg und Durchgang stehen. Als 16:9 wäre sie in
// der Ecke ein Streifen von 21 statt 30 Prozent Höhe.
//
// Verdeckt wird nur, was nichts trägt: Pflaster, Fahrbahn, Tischkante. Der
// Sessel behält seine Sitzfläche, der Sattelzug seine linke Hälfte, das
// Haus im Abendlicht Himmel und Fassade.
const krafthaus = [
  { img: '/images/krafthaus/haus-01.jpg', alt: 'Das Krafthaus im Abendlicht, dahinter das Kranhaus am Rheinauhafen',               x: 0,  y: 0,  w: 44, ar: '3 / 2', z: 1 },
  { img: '/images/krafthaus/haus-03.jpg', alt: 'Grüner Sessel vor weißer Wand, daneben ein Sideboard mit Lampe und ein Alukoffer', x: 62, y: 2,  w: 30, ar: '2 / 3', z: 2 },
  { img: '/images/krafthaus/haus-02.jpg', alt: 'Schwarzweiß: leere Autobahn mit Leitplanke und Waldrand',                          x: 22, y: 26, w: 40, ar: '3 / 2', z: 3 },
  { img: '/images/krafthaus/haus-05.jpg', alt: 'Sattelzug an einer Raststätte unter blauem Himmel',                                x: 28, y: 50, w: 38, ar: '3 / 2', z: 5 },
  { img: '/images/krafthaus/haus-06.jpg', alt: 'Mehrere Personen an Biertischen vor einem Lokal, eine Person lacht in die Kamera', x: 0,  y: 44, w: 30, ar: '2 / 3', z: 4 },
  // Das Drohnenbild statt der Fassadenaufnahme von unten: Es zeigt denselben
  // Bau, aber im Hafen stehend statt als Ausschnitt, und schließt den Haufen
  // dort, wo der Absatz daneben vom Ort spricht. Quer statt quadratisch,
  // deshalb 37 statt 30 Prozent breit — die Fläche bleibt ungefähr gleich.
  { img: '/images/krafthaus/haus-drohne.jpg', alt: 'Luftaufnahme des Krafthauses im Rheinauhafen: Backsteinbau mit Schieferdach, daneben Kopfsteinpflaster und die Nachbargebäude', x: 55, y: 58, w: 37, ar: '3 / 2', z: 6 },
];

// Vier Plätze, alle vier echt. Der Zuschnitt steckt in der Datei und
// nicht im CSS, weil die Aufnahmen quer oder hoch sind und die Personen
// klein im Raum zeigen — ein Beschnitt per object-fit hätte sie nur
// verschoben, nicht näher herangeholt.
//
// ZWEI MASSE HALTEN DIE REIHE ZUSAMMEN, und beide sind nachgemessen:
//
//   AUGENLINIE 44 %   Die Augen liegen bei allen vier auf 44 Prozent der
//                     Kachelhöhe. Vorher lagen sie zwischen 22 und 37 —
//                     der Blick sprang beim Wechsel um rund 45px.
//
//   KOPFHÖHE 178 px   Vom Scheitel bis zum Kinn, gerechnet auf die
//                     Anzeigegröße von 304px. Gemessen liegen die vier
//                     bei 177 bis 179, also innerhalb von einem Prozent.
//
// Das zweite Maß ist das jüngere. Eine gemeinsame Augenlinie allein
// reicht nicht: Danach lagen die Augen zwar auf einer Linie, die Köpfe
// waren aber 92 bis 174px hoch — Joschas fast doppelt so groß wie Cems.
// Die Reihe las sich als vier verschiedene Aufnahmen, nicht als ein Satz.
//
// Die Grenzen für die beiden Werte:
//
//   nach unten   Cem für die Augenlinie: Bei ihm liegen zwischen Scheitel
//                und Augen 59 Prozent der Kopfhöhe, tiefer angesetzt
//                stößt er oben an. Bei 44 Prozent bleiben ihm 33px Luft.
//   nach oben    Joscha für die Kopfhöhe: Seine Quelle ist nur 1086px
//                breit, der Ausschnitt schöpft sie fast aus. Kleiner als
//                177 lässt sich sein Kopf nicht mehr schneiden.
//
// Eine dritte Grenze ist entfallen: Von Philipp gab es lange nur die
// 700er Webfassung, sein Ausschnitt konnte weder nach unten wandern noch
// weiter aufgezogen werden, und seine Kachel maß deshalb nur 524px. Seit
// dem 4. August 2026 liegt sein Original vor (2880 x 1920), und alle vier
// Kacheln sind 700px groß — bei 304px Anzeige also 2,3-fach.
//
// Wer ein Porträt tauscht, muss den Schnitt mitliefern: quadratisch,
// Augen auf 44 Prozent, Kopf 58 Prozent der Kachelhöhe.
//
// Die Originale liegen alle vier unter quellbilder/team.
//
// Die Rollen sind Doppelnennungen mit Schrägstrich und laufen bei zwei
// von vieren über die Kachelbreite hinaus. Am Umbruch hängen drei Dinge:
//
//   text-wrap: balance   an .team__role verteilt die Zeilen gleichmäßig.
//                        Ohne die Angabe füllt die erste Zeile sich bis
//                        zum Rand und lässt ein einzelnes Wort darunter.
//   U+2011               steht als Bindestrich in "Post‑Production" und
//                        "Self‑Shooting" — ein gewöhnlicher Bindestrich
//                        ist eine Trennstelle, und Joschas Zeile brach
//                        genau dort: "Head of Post-" über "Production /
//                        Photographer". Der Umbruch gehört an den
//                        Schrägstrich, nicht in den Begriff.
//   U+2009               steht als schmales Leerzeichen um die
//                        Schrägstriche. Nur Optik, keine Umbruchregel —
//                        es ist ein trennbares Leerzeichen wie jedes
//                        andere.
const team = [
  { img: '/images/team/philipp-maxhofer.jpg', name: 'Philipp Maxhofer', role: 'Concept | Creative Director', alt: 'Porträt von Philipp Maxhofer im Rollkragenpullover, Studio im Hintergrund' },
  { img: '/images/team/cem-schuch.jpg', name: 'Cem-Pierre Schuch', role: 'Head of Production | Self‑Shooting Director', alt: 'Porträt von Cem-Pierre Schuch in dunkler Sweatjacke, lachend, im Hintergrund ein Sprossenfenster' },
  { img: '/images/team/joscha-ortmeier.jpg', name: 'Joscha Ortmeier', role: 'Head of Post‑Production | Photographer', alt: 'Porträt von Joscha Ortmeier mit Brille, im Hintergrund ein Bücherregal' },
  { img: '/images/team/tom-beckers.jpg', name: 'Tom Beckers', role: 'Producer | Content Creator', alt: 'Porträt von Tom Beckers mit schulterlangem Haar und Schnurrbart, im Hintergrund ein helles Fenster' },
];

// q darf Markup enthalten (Wortmarke), wird unten mit set:html gerendert.
//
// Von zehn Fragen auf fünf gekürzt. Entfallen sind die zu Werbefilm in
// 16:9, Mediaplanung und SEO, Köln als Arbeitsgebiet, Nutzungsrechten
// und Workshops.
//
// Zwei davon trugen die Abgrenzung "was wir nicht machen" — sie steckt
// jetzt nur noch in Frage 2 zu UGC. Wer die Abgrenzung deutlicher will,
// muss sie dort schärfen oder eine der beiden Fragen zurückholen; sie
// stehen in der Git-Historie.
const faqs = [
  { q: 'Was kostet eine Produktion bei <span class="brand">Le Werk</span>?', a: 'Das hängt an Drehtagen, Team und Formatumfang. Kompakte Social-Produktionen starten im mittleren vierstelligen Bereich, größere Kampagnen liegen fünfstellig. Nach einem 20-minütigen Gespräch bekommt ihr eine belastbare Spanne — kein Zahlenraten.' },
  { q: 'Macht ihr auch UGC- oder Handy-Content?', a: 'Nein. Das ist ein anderer Markt mit anderen Preisen und anderem Anspruch. Bei uns entstehen Visuals auf Kampagnenniveau — auch dann, wenn sie am Ende vertikal im Feed laufen. Wer schnellen, günstigen Durchsatz sucht, ist bei uns falsch.' },
  { q: 'Bekommen wir Foto und Video aus einer Produktion?', a: 'Ja, das ist der Kern unserer Arbeitsweise. Wir planen Sets so, dass bewegte und stehende Bilder parallel entstehen. Das spart einen kompletten Produktionstag und sorgt dafür, dass Foto und Video wie eine Kampagne aussehen — nicht wie zwei.' },
  { q: 'Warum denkt ihr vom vertikalen Format aus?', a: 'Weil dort die Aufmerksamkeit liegt. Ein Bildaufbau, der als 16:9 entsteht und später hochkant beschnitten wird, verliert immer — Blickführung, Text und Rhythmus stimmen dann nicht mehr. Wir planen umgekehrt: vertikal als Kern, Landscape und Stills als Ableitung derselben Produktion.' },
  { q: 'Wie lange dauert es von der Anfrage bis zum fertigen Material?', a: 'Für eine kompakte Produktion rechnet mit drei bis vier Wochen: eine Woche Konzept, ein bis zwei Drehtage, ein bis zwei Wochen Post. Bei laufenden Content-Paketen verkürzt sich das deutlich, weil Setup und Look bereits stehen.' },
];
---

<BaseLayout
  title="Le Werk — Visual Content Studio für Video und Fotografie"
  description="Le Werk ist ein Visual Content Studio in Köln: Video und Fotografie auf Kampagnenniveau, vom vertikalen Format aus gedacht. Handwerk mit redaktioneller Substanz — kein UGC, kein Full-Service-Overhead."
  heroDark={true}
>
  <!-- ═══ 1 · HERO ═══════════════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <!-- muted und playsinline sind Bedingung dafür, dass mobile Browser
           überhaupt selbst starten. Die Datei hat keine Tonspur.
           Bei prefers-reduced-motion hält ein Skript das Video an. -->
      <video
        id="hero-video"
        autoplay muted loop playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={withBase('/videos/lewerk-hero.mp4')} type="video/mp4" />
      </video>
    </div>

    <!-- Text sitzt in der unteren linken Ecke und läuft bewusst nicht über
         die ganze Breite. Randabstand = --edge, damit er mit dem Logo im
         Header auf einer Achse liegt. -->
    <div class="hero__inner">
      <h1 class="hero__statement" id="hero-title" lang="en">
        <span class="brand">Le Werk</span> is a visual content studio crafting
        brand content <em>worth watching.</em>
      </h1>
    </div>

    <a class="hero__cue" href="#positionierung" aria-label="Weiter zum Inhalt scrollen">
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- ═══ 2 · POSITIONIERUNG ═════════════════════════════════════════════ -->
  <section class="section statement" id="positionierung" aria-labelledby="statement-title">
    <div class="container statement__inner">
      <!-- Bewusst kein deutscher Claim: Laut Positionierung trägt der
           englische Positions-Satz im Hero diese Rolle, ein Manifest-Satz
           auf Deutsch steht noch aus. Dieser Absatz erklärt die Position,
           er behauptet sie nicht als Slogan. -->
      <!-- Ein durchlaufender Absatz aus drei Stimmen: kursiver Einstieg,
           Roman als Körper, kursiver Schluss. Das geschützte Leerzeichen
           nach dem Auftakt hält ihn an "Le Werk" — sonst stünde
           "Gegründet von Filmemachern." allein auf einer Zeile.

           Gekürzt: "ist ein Visual Content Studio im Kölner Rheinauhafen"
           ist entfallen. Beides stand ohnehin woanders — die Gattung im
           Hero direkt darüber, der Ort in Streublock 02 und im Impressum.
           Übrig bleibt, was nur hier steht. -->
      <p class="statement__text" id="statement-title" data-reveal>
        <em>Gegründet von Filmemachern.</em>{' '}
        <span class="brand">Le Werk</span> ist spezialisiert auf
        Storytelling, Film und Foto für <em>Social und Branded Content.</em>
      </p>
      <p class="statement__meta" data-reveal data-reveal-delay="80">
        Konzept · Produktion · Postproduktion · Based in Köln, Booked Worldwide
      </p>
    </div>
  </section>

  <!-- ═══ 3 · ARBEITEN ═══════════════════════════════════════════════════ -->
  <section class="section section--dark work" id="arbeiten" aria-labelledby="work-title">
    <div class="container">
      <!-- Englisch wie der Positions-Satz im Hero, deshalb lang="en": Ohne
           die Angabe liest eine Sprachausgabe "Featured Work" deutsch vor. -->
      <header class="work__head" data-reveal>
        <h2 class="headline headline--xl" id="work-title" lang="en">
          <span class="editorial editorial--kicker">Featured</span>{' '}
          Work
        </h2>
        <!-- Der frühere Einleitungstext ist entfallen. Er erklärte die
             Formatlogik ("vom vertikalen Format aus") — die steht jetzt in
             den Format-Zeilen der Kacheln und im FAQ. -->
      </header>

      <!-- Der Kundenname steht groß im Bild, das Projekt in der Zeile
           darunter. Vorher trug das Bild eine Gattung ("Social Video") —
           bei echten Arbeiten ist der Kunde die stärkere Angabe. -->
      <!-- Kein data-reveal an den Kacheln: Sie hängen an --q und laufen
           damit nach demselben Gesetz wie die Stücke im Streublock weiter
           unten. Beides auf einer Eigenschaft ginge nicht — data-reveal
           setzt transform über eine Übergangszeit, --q schreibt es je Bild
           neu. Der Abschnittskopf blendet weiterhin ein, genau wie der Text
           neben den Streublöcken. -->
      <div class="work__grid">
        {arbeiten.map((a, i) => (
          <article class={`work__item work__item--${i + 1}`}>
            <a class="work__link" href={withBase(`/arbeiten/${a.slug}`)}>
              <figure class="work__figure" data-format={a.ratio}>
                <img src={withBase(a.bild)} alt={a.alt} width={a.breite} height={a.hoehe} loading="lazy" decoding="async" />
                <figcaption class="work__tag">{a.kunde}</figcaption>
              </figure>
              <p class="work__caption">
                <span class="work__titel">{a.titel}</span>
                <!-- Die Ansage steht einmal vor der ersten Pille, nicht an
                     jeder: "Formate 9:16 16:9" statt "Format 9:16 Format
                     16:9". Der Plural richtet sich nach der Anzahl. -->
                <span class="work__formate">
                  <span class="visually-hidden">
                    {a.formate.length > 1 ? 'Formate ' : 'Format '}
                  </span>
                  {a.formate.map((f) => <span class="work__format">{f}</span>)}
                </span>
              </p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 4 · TRUSTBAR (Logo-Marquee) ════════════════════════════════════ -->
  <section class="section section--tight trust" id="trust" aria-label="Auswahl unserer Kunden">
    <div class="container">
      <!-- Vorher "Vertrauen auf Le Werk" — als Imperativ lesbar und
           werblich. Die Zeile benennt jetzt nur noch, was zu sehen ist. -->
      <p class="label trust__label">Ausgewählte Kunden</p>
    </div>

    <div class="marquee">
      <!-- Die Liste steht zweimal im Markup. Die zweite Runde trägt
           aria-hidden und leere Alternativtexte: Sie ist nur da, damit die
           Schleife ohne Lücke umbrechen kann, und würde sonst jeden
           Kundennamen doppelt vorlesen lassen.

           tabindex="-1" gehört zwingend dazu: Ein Element mit aria-hidden
           darf nicht fokussierbar sein, sonst landet die Tabulatortaste in
           etwas, das für Screenreader nicht existiert. Ohne die Angabe
           stünden zehn stumme Links in der Tabreihenfolge. -->
      <ul class="marquee__track">
        {[...kunden, ...kunden].map((k, i) => {
          const kopie = i >= kunden.length;
          return (
            <li class="marquee__logo" aria-hidden={kopie ? 'true' : undefined}>
              <a
                class="marquee__link"
                href={k.url}
                target="_blank"
                rel="noopener"
                tabindex={kopie ? -1 : undefined}
              >
                <!-- eager statt lazy: Die Leiste läuft, sobald sie ins Bild
                     kommt, und ein nachgeladenes Logo hinterlässt bis dahin
                     eine Lücke. Zwölf Dateien sind zusammen 124 KB, die
                     zweite Runde kommt aus dem Zwischenspeicher.
                     fetchpriority low, damit sie sich nicht vor das
                     Bühnenvideo und die ersten Kacheln drängen. -->
                <img
                  src={withBase(`/images/kunden/${k.datei}.png`)}
                  alt={kopie ? '' : k.name}
                  width={k.b} height={k.h}
                  loading="eager" fetchpriority="low" decoding="async"
                  style={`--b: ${logoBreite(k)}`}
                />
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ═══ 5 · LEISTUNGEN ═════════════════════════════════════════════════ -->
  <section class="section section--sand services" aria-labelledby="services-title">
    <div class="container">
      <!-- Marginalienstil wie bei "Warum Le Werk", nicht die große
           Überschrift der übrigen Abschnitte. Steht als h2 und nicht als
           p — ohne Überschrift auf dieser Ebene bliebe eine Lücke in der
           Gliederung.

           Der Modifier --nur-marke ist Pflicht, nicht Geschmack: Die
           Grundabstände sind auf eine Headline gerechnet, unter einer
           12px-Zeile wirken 72px wie ein Loch.

           "Content, holistisch gedacht" stand hier früher als Headline,
           davor zusätzlich ein Fließtext, der die Disziplinen abstufte
           ("Hauptdisziplin", "klare Zweite"). Beides ist entfallen. -->
      <header class="sec-head sec-head--nur-marke" data-reveal>
        <h2 class="label" id="services-title">Was wir machen</h2>
      </header>

      <!-- Nur die drei Produktionsdisziplinen. Workshops sind bewusst nicht
           auf der Startseite und ausschließlich über das Menü erreichbar.

           Bewusst keine Karten: Gleich große Kästen mit Rahmen und Schatten
           sehen nach Baukasten aus. Hier trägt die Anordnung — Video groß
           über die volle Höhe links, Idee & Konzept und Foto rechts
           gestapelt. -->
      <ol class="disziplinen">
        {disziplinen.map((s, i) => (
          <li class={`disziplin disziplin--${i + 1}`} data-reveal data-reveal-delay={i * 90}>
            <a class="disziplin__link" href={withBase(s.href)}>
              <figure class="disziplin__bild" style={`--ratio:${s.ratio ?? '4 / 3'}`}>
                <img src={withBase(s.img)} alt="" width="1200" height="900" loading="lazy" decoding="async" />
                <figcaption class="disziplin__marke">{s.titel ?? s.label}</figcaption>
              </figure>

              <p class="disziplin__zeile">{s.text}</p>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══ 6 · UNSER KERNTEAM ═════════════════════════════════════════════ -->
  <section class="section section--dark team" aria-labelledby="team-title">
    <div class="container">
      <header class="sec-head sec-head--knapp" data-reveal>
        <p class="label">Wer dahintersteht</p>
        <h2 class="headline" id="team-title">
          <span class="editorial editorial--kicker">Unser</span>{' '}
          Kernteam
        </h2>
      </header>

      <!-- Erst die Gesichter … -->
      <ul class="team__grid">
        {team.map((m, i) => (
          <li class="team__member" data-reveal data-reveal-delay={i * 70}>
            <img
              class="team__portrait"
              src={withBase(m.img)} alt={m.alt}
              width="700" height="700" loading="lazy" decoding="async"
            />
            <p class="team__name">{m.name}</p>
            <p class="team__role">{m.role}</p>
          </li>
        ))}
      </ul>

      <!-- … dann zwei Blöcke, in denen der Text von seiner Seite
           hereinkommt und die Bilder beim Scrollen mitwandern. Der Text
           von 01 stand vorher als breiter Absatz über die volle Breite;
           in der schmalen Spalte neben dem Haufen trägt er besser. -->
      <div class="team__bloecke">
        <Streublock nr="01" seite="rechts" bilder={bts} label="Blick hinter die Kulissen">
          <p>
            <strong>Erfahrung aus hunderten Produktionen:</strong> Wir
            kombinieren ein schlagkräftiges Kernteam mit kreativen
            Spezialisten aus verschiedenen Feldern.
          </p>
        </Streublock>

        <Streublock nr="02" seite="links" bilder={krafthaus} label="Unsere Räume im Krafthaus" hoehe={0.95}>
          <p>
            <strong class="knapp">Based in Köln, booked worldwide:</strong> Unsere
            Räumlichkeiten liegen im Krafthaus, im Rheinauhafen. Gedreht wird
            in Köln, bundesweit oder auch international.
          </p>
        </Streublock>
      </div>
    </div>
  </section>

  <!-- ═══ 7 · DREI GRÜNDE ════════════════════════════════════════════════ -->
  <section class="section benefits" aria-labelledby="benefits-title">
    <div class="container">
      <!-- Ohne große Überschrift: "Drei Gründe, uns anzurufen" ist
           verworfen, der Abschnitt trägt jetzt nur noch die Marginalie.
           Sie steht als h2 und nicht als p — die drei Punkte darunter sind
           h3, ohne h2 dazwischen bliebe eine Lücke in der Gliederung, und
           aria-labelledby des Abschnitts braucht ein Ziel. Aussehen
           unverändert, das trägt die Klasse .label. -->
      <header class="sec-head sec-head--nur-marke" data-reveal>
        <h2 class="label" id="benefits-title">Warum <span class="brand">Le Werk</span></h2>
      </header>

      <ol class="benefits__list">
        <li class="benefit" data-reveal>
          <span class="benefit__num" aria-hidden="true">01</span>
          <h3 class="benefit__title">Content darf gut aussehen</h3>
          <p class="benefit__text">
            Hochwertig produzierte Visuals in Bild und Bewegtbild — mit den
            Maßstäben an Licht, Bildgestaltung und Postproduktion, wie man
            es aus der Filmproduktion kennt.
          </p>
        </li>
        <li class="benefit" data-reveal data-reveal-delay="80">
          <span class="benefit__num" aria-hidden="true">02</span>
          <h3 class="benefit__title">Inhaltliche Substanz</h3>
          <p class="benefit__text">
            Redaktionelle Tiefe, ehrlich erzählte Geschichten, menschliche
            Momente. Interviewbasiert und dokumentarisch, mit Blick für
            Charaktere.
          </p>
        </li>
        <li class="benefit" data-reveal data-reveal-delay="160">
          <span class="benefit__num" aria-hidden="true">03</span>
          <h3 class="benefit__title">Social First</h3>
          <p class="benefit__text">
            Marken müssen dort sichtbar sein, wo die Aufmerksamkeit ihrer
            Kunden liegt. Wir denken social first und produzieren den
            richtigen Content für die richtigen Kanäle.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══ 8 · FAQ ═══════════════════════════════════════════════════════ -->
  <!-- Die offenen Fragen zuerst, der Aufruf danach: Wer bis hierher gelesen
       hat, soll nicht mit einer Frage im Kopf auf den Knopf schauen.

       Beige und nicht Weiß: Die FAQ steht zwischen den hellen Vorteilen und
       dem dunklen Aufruf und braucht einen eigenen Ton — sonst grenzten
       zwei weiße Flächen aneinander. -->
  <section class="section section--sand faq" aria-labelledby="faq-title">
    <div class="container faq__grid">
      <header class="faq__head" data-reveal>
        <p class="label">Häufige Fragen</p>
        <h2 class="headline" id="faq-title">Kurz beantwortet</h2>
      </header>

      <div class="faq__list" data-reveal data-reveal-delay="80">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span set:html={f.q} />
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq__a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 9 · BOTTOM-CTA ════════════════════════════════════════════════ -->
  <!-- Der Aufruf schließt die Seite ab und geht in die Fußzeile über. Beide
       sind dunkel, aber nicht gleich: Die Fußzeile liegt auf
       --petrol-deeper und setzt sich damit ab. -->
  <section class="section section--dark cta" aria-labelledby="cta-title">
    <div class="container cta__inner" data-reveal>
      <h2 class="headline headline--xl cta__title" id="cta-title">
        <span class="editorial editorial--kicker">Erzähl uns</span>{' '}
        von deinem Projekt
      </h2>
      <div class="cta__actions">
        <a class="btn btn--on-dark" href={withBase("/kontakt")}>
          Projekt anfragen <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="mailto:contact@lewerk.de">contact@lewerk.de</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Der gemeinsame Sektionskopf .sec-head steht in global.css — er wird
     inzwischen auch von den Projektseiten gebraucht, und Astro-Styles
     gelten nur in der Datei, in der sie stehen. */

  /* ── 1 · Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    /* Der untere Wert setzt den Text über der Unterkante. Er ist zweimal
       gewachsen: 10vh ließen ihn 80px über dem Rand sitzen und damit fast
       auf dem Scroll-Pfeil, 13.5vh gaben 108px. Jetzt 17vh — der Satz
       steht deutlich über der Mitte der unteren Hälfte und lässt mehr
       Video frei. */
    padding-block: clamp(8rem, 18vh, 12rem) clamp(6.5rem, 17vh, 11.5rem);
    background: var(--petrol-deep);
    color: var(--on-dark);
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: 0; z-index: 0; }

  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Ohne jeden Filter. Er lag zuletzt bei brightness(0.92), davor bei
       0.82 — beides nahm dem Material Licht, das es nicht hergeben muss.
       Die Lesbarkeit trägt allein der Verlauf darunter, und der sitzt da,
       wo die Schrift steht, statt über dem ganzen Bild. Nebenbei fällt
       damit eine Filterebene über einem formatfüllenden Video weg. */
  }

  .hero__media::after { content: ''; position: absolute; inset: 0; }

  /* Lesbarkeitsverlauf in neutralem Schwarz statt in Petrol: Ein farbiger
     Verlauf legt sich als Stich über das ganze Material und verfälscht die
     Farben der Aufnahme. Schwarz dunkelt ab, ohne einzufärben.
     Die Werte sind über mehrere Videoframes gemessen, nicht geschätzt.

     Zweimal zurückgenommen, damit mehr vom Video zu sehen ist. Der Fuß
     lief 0.90 → 0.82 → 0.72, die obere Kante 0.40 → 0.24 → 0.14, die
     Mitte ist inzwischen ganz offen. Der Verlauf sitzt nur noch dort, wo
     die Schrift steht. */
  .hero__media::after {
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.32) 24%, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.14) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.48) 0%, rgba(0, 0, 0, 0.1) 42%, rgba(0, 0, 0, 0) 64%);
  }

  /* Auf schmalen Schirmen steht der Satz sechszeilig statt zweizeilig und
     reicht damit bis auf 35 % der Höhe hinauf — dort war der Verlauf schon
     fast offen und der Kontrast fiel auf 2.8:1. Der Verlauf greift hier
     deshalb höher. Der seitliche fällt weg: Der Satz nimmt die volle
     Breite ein, eine linke Kante gibt es nicht mehr abzudunkeln. */
  @media (max-width: 63.999rem) {
    .hero__media::after {
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.46) 30%, rgba(0, 0, 0, 0.1) 55%, rgba(0, 0, 0, 0) 72%, rgba(0, 0, 0, 0.12) 100%);
    }
  }

  /* Randabstand wie im Header, damit Text und Logo auf einer Achse sitzen */
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: var(--edge);
  }

  /* Rollentrennung wie im Rest der Seite: Die Wortmarke bleibt Poppins
     ExtraBold (Klasse .brand, unverändert), der Satz selbst ist Redaktion
     und damit Bodoni. Der kursive Schluss trägt die Behauptung. */
  .hero__statement {
    max-width: 30ch;
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: clamp(1.625rem, 3.4vw, 3.125rem);
    line-height: 1.14;
    letter-spacing: -0.005em;
    color: var(--on-dark);
    text-wrap: pretty;
  }

  .hero__statement em { font-style: italic; }


  .hero__cue {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 6vh, 3.5rem);
    z-index: 1;
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    animation: cue 2.4s var(--ease-out) infinite;
  }

  @keyframes cue {
    0%, 100% { transform: translateY(0); opacity: 0.75; }
    50%      { transform: translateY(6px); opacity: 1; }
  }

  /* ── 2 · Trustbar ─────────────────────────────────────────────────────── */
  .trust__label { margin-bottom: 0; }
  .trust .marquee { margin-top: clamp(1.5rem, 3vw, 2.5rem); }

  .marquee {
    /* Die volle Kastenbreite. Alles andere in der Leiste hängt daran: die
       Logobreite über den Faktor --b je Marke, die Kastenhöhe über das
       Verhältnis 2.35. Beide Werte stehen auch im Frontmatter, dort als
       LOGO_VERHAELTNIS. */
    --logo-breite: clamp(3.7rem, 5.85vw, 5.25rem);
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    /* muss 0 bleiben: Der Track wandert um 50 % seiner Breite. Ein gap läge
       auch zwischen den beiden Kopien und verschöbe die Rechnung um genau
       einen Abstand — die Schleife spränge sichtbar. Der Abstand steckt
       deshalb im Logo, siehe .marquee__logo. */
    gap: 0;
    width: max-content;
    /* Der frühere Streifen lief 1600px in 40s, also 40px in der Sekunde.
       Bei zwölf Logos misst eine Runde 1329px — bei gleicher
       Geschwindigkeit sind das 33s. Wer ein Logo ergänzt, muss den Wert
       nachziehen, sonst läuft die Leiste schneller. */
    animation: marquee 33s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track { animation-play-state: paused; }

  @keyframes marquee {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  /* Die Kachel ist so breit wie ihr Logo plus zweimal Polsterung — keine
     feste Breite. Damit steht zwischen zwei Logos immer derselbe Abstand
     von 37px.

     Mit fester Breite war das nicht so. Ein schmales Logo saß dann mittig
     in einem 94px breiten Kasten und brachte bis zu 55px Leerraum mit, der
     sich zur Lücke addierte — gemessen lagen die sichtbaren Abstände
     zwischen 38px (Siemens neben Street One) und 87px (EA neben Formel D).
     Zwei Wortmarken standen doppelt so eng wie zwei Bildmarken.

     Die Größe selbst kommt aus --logo-breite an .marquee und war zuerst
     deutlich zu groß: Bei einem Kasten von 148 x 54 kamen die Wortmarken
     auf 111px, und vier Bildmarken standen auf voller Höhe, wo der frühere
     Streifen nur eine hatte. Über 142 x 44 und 132 x 40 steht sie jetzt bei
     84 x 36 — Siemens läuft damit 84px breit gegen 80px im alten
     Streifen. */
  .marquee__logo {
    flex: none;
    display: flex;
    padding-inline: clamp(0.75rem, 1.3vw, 1.1875rem);
  }

  /* Der Link ist der Kasten. Seine Höhe ist fest und nicht vom Bild
     abgeleitet — das ist keine Kosmetik, sondern Bedingung dafür, dass die
     Logos überhaupt erscheinen:

     Ein Bild mit loading="lazy" wird geladen, sobald sein Kasten in die
     Nähe des Sichtfelds kommt. Stehen aber Breite und Höhe des Bildes auf
     auto, hat es vor dem Laden keine Größe — und was keine Größe hat,
     kommt nie in die Nähe des Sichtfelds. Das Bild lädt nicht, bleibt
     ohne Größe, und die Leiste ist leer. Genau das ist hier passiert.

     Mit fester Kastenhöhe steht die Fläche von Anfang an, das Laden löst
     aus, und object-fit hält das Seitenverhältnis.

     Dass der Link die Fläche trägt und nicht das Bild, hat noch einen
     Grund: Ein Ziel von 104 x 44px ist knapp, und die Leiste bewegt sich.
     Deshalb hält sie beim Überfahren an, siehe .marquee__track. */
  .marquee__link {
    display: flex;
    align-items: center;
    height: calc(var(--logo-breite) / 2.35);
  }

  /* Die Trustbar liegt auf Weiß, deshalb Petrol und nicht currentColor —
     der Ring soll sich vom schwarzen Logo unterscheiden. */
  .marquee__link:focus-visible {
    outline: 2px solid var(--petrol);
    outline-offset: 6px;
    border-radius: 2px;
  }

  /* Die Breite kommt je Marke aus --b, die Höhe folgt dem
     Seitenverhältnis. Breite Wortmarken bekommen die volle Kastenbreite,
     hohe Bildmarken so viel, wie ihre Höhe zulässt — auf gleiche Höhe
     gebracht wären die Wortmarken dreimal so schwer.

     Die feste Breite ist Bedingung, nicht Kosmetik: Stehen Breite und Höhe
     beide auf auto, hat ein Bild mit loading="lazy" vor dem Laden keine
     Größe, kommt damit nie in die Nähe des Sichtfelds und lädt nie. Die
     Leiste bleibt leer. Mit fester Breite steht die Fläche von Anfang an —
     das Seitenverhältnis liefern die width- und height-Attribute.

     Kein Farbfilter: Die Logos sind schwarz, weil die Dateien schwarz sind.
     Formel D kam türkis und wurde umgefärbt — nachgemessen liegt die
     Deckfarbe jetzt bei allen zehn zwischen 0 und 32 von 255. Details in
     docs/bildmaterial.md. */
  .marquee__logo img {
    width: calc(var(--b, 1) * var(--logo-breite));
    height: auto;
    opacity: 0.72;
    transition: opacity var(--dur) var(--ease-out);
  }

  /* Beim Überfahren der Leiste heben sich alle Logos, das einzelne unter
     dem Zeiger geht auf volle Deckung — sonst wäre nicht zu sehen, worauf
     der Klick geht. */
  .marquee:hover .marquee__logo img { opacity: 0.85; }
  .marquee__link:hover img,
  .marquee__link:focus-visible img { opacity: 1; }

  /* ── 2 · Positionierung ───────────────────────────────────────────────── */
  .statement { padding-block: clamp(4.5rem, 10vw, 8.5rem); }

  .statement__inner { text-align: center; }

  /* Rollentrennung wie im Hero: Wortmarke Poppins ExtraBold (.brand),
     der Satz selbst Bodoni, der kursive Schluss trägt die Behauptung.
     Der Text ist länger als der Satz davor, deshalb etwas kleiner und
     breiter gesetzt — die Wirkung kommt hier aus der Staffelung. */
  .statement__text {
    margin-inline: auto;
    max-width: 34ch;
    font-family: var(--font-editorial);
    font-weight: 400;
    /* Die Untergrenze ist auf 1.5rem gesetzt, damit "Filmemachern. Le Werk"
       als unteilbarer Block auf schmalen Schirmen Luft in der Spalte hat.
       Bei 1.625rem waren es gemessen 2px — ein Gerät mit etwas breiterer
       Schriftwiedergabe hätte den Block aus der Spalte laufen lassen. */
    font-size: clamp(1.5rem, 4.2vw, 3.25rem);
    /* 1.1 war der Display-Durchschuss des alten Kurzsatzes. Auf dem Handy
       stehen hier mehr Zeilen — das braucht etwas mehr Luft. */
    line-height: 1.16;
    letter-spacing: -0.005em;
    /* Auf schmalen Schirmen sind es acht Zeilen. Dort greift balance nicht
       mehr — Chrome wendet es nur bis etwa sechs Zeilen an, gemessen blieb
       "Content." als Schusterjunge mit 28% Zeilenbreite allein stehen.
       pretty kennt diese Grenze nicht und füllt die Schlusszeile auf 58%.
       Ab 48rem übernimmt balance, weil es die vier Zeilen gleichmäßig
       ausgleicht. */
    text-wrap: pretty;
    /* In dieser Größe ist eine Silbentrennung deutlich sichtbar und wirkt
       wie ein Fehler — der Satz darf lieber eine Zeile länger werden. */
    hyphens: none;
  }

  .statement__text em { font-style: italic; }

  /* AUSNAHME von der Wortmarken-Regel, ausdrücklich so gewünscht: In
     diesem einen Absatz läuft "Le Werk" komplett in der Schrift des
     Absatzes mit — Bodoni Moda, aufrecht, im selben Schnitt und derselben
     Laufweite wie der Text drumherum. Der Hero direkt darüber trägt die
     Marke bereits in Poppins ExtraBold; hier soll der Satz ohne Bruch
     durchlaufen. Der Weg war Poppins 800 → 600 → 400 → Absatzschrift.
     Gilt nur in diesem Absatz — überall sonst bleibt .brand die Wortmarke
     in Poppins ExtraBold, siehe die Regel in global.css.
     Was aus .brand bleibt: white-space: nowrap, damit "Le" und "Werk"
     nie auf zwei Zeilen fallen. */
  .statement__text .brand {
    font-family: inherit;
    font-weight: inherit;
    font-style: inherit;
    letter-spacing: inherit;
  }

  /* Gesperrte Versalzeile als Gegengewicht zur großen Serifenschrift */
  .statement__meta {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--track-label);
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* ── 4 · Arbeiten ─────────────────────────────────────────────────────── */
  /* Kappt waagerecht, aus demselben Grund wie .team: Die Kacheln fahren
     seitlich auf ihren Platz zu und stehen bei --q = 0 bis zu 48px außerhalb
     des Rasters. Ungekappt wüchse die Seite und ließe sich seitwärts
     scrollen. */
  .work { overflow-x: clip; }

  /* Nur noch die Überschrift im Kopf: Der Kasten war zweispaltig angelegt
     (Überschrift links, Einleitung rechts). Ohne die Einleitung hätte die
     Überschrift in einer 1,35fr-Spalte gesessen und rechts wäre eine leere
     Spalte offen geblieben. */
  .work__head { margin-bottom: clamp(2.5rem, 6vw, 4.5rem); }

  /* Eine Spalte. Zwischenzeitlich standen die beiden Hochformate hier zu
     zweit nebeneinander, weil sie über die volle Breite je 690px hoch
     sind und direkt hintereinander lagen. Seit Video und Foto abwechseln,
     liegt zwischen ihnen ein Querformat — der Scrollweg ist damit
     gebrochen und jedes Reel darf voll stehen. */
  .work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  /* Die Kacheln laufen beim Scrollen auf ihren Platz zu — dasselbe
     Bewegungsgesetz wie die Stücke im Streublock, nur auf die andere
     Anordnung gelegt.

     Im Haufen laufen die Stücke radial auf die Mitte der Fläche zu. Hier
     ist die Anordnung ein Reißverschluss aus drei Paaren, und seine Achse
     ist die senkrechte Mittellinie des Rasters: Die linken Kacheln kommen
     von links, die rechten von rechts, und der Verschluss schließt sich
     beim Scrollen. Radial wäre hier falsch — der Abschnitt ist 2400px hoch,
     die senkrechte Komponente würde alles überlagern.

     --dx ist der Weg in Einheiten von --zug, ausgerechnet aus der Lage im
     Raster: Mitte der Kachel minus Mitte des Rasters, geteilt durch die
     halbe Rasterbreite. Die Werte stehen weiter unten bei den Spalten, weil
     sie von ihnen abhängen. Was weiter außen sitzt, läuft weiter — genau
     wie im Haufen.

     --dy zieht alle Kacheln zusätzlich ein Stück von unten herauf. Ohne
     das stünde einspaltig, wo es kein Links und Rechts gibt, fast alles
     still.

     Der Maßstab ist kleiner als im Haufen: 63px Weg und 4,5 Prozent Größe
     gegen 165px und 12 Prozent. Die Stücke dort sind Schnipsel, hier sind
     es Kacheln bis 633 x 792px — derselbe Weg sähe an ihnen nicht lebendig
     aus, sondern lose. Nachgemessen wandert eine Kachel damit rund 45px
     aus ihrer Ruhelage, waagerecht und senkrecht zusammengenommen.

     Weg und Größe ziehen gegeneinander: Bei --q = 0 steht die Kachel
     weiter außen, ist aber kleiner — die Außenkante läuft deshalb nur
     34px, nicht 42px. Das ist gewollt, sonst risse der Rand auf. */
  .work__item.is-aktiv {
    --zug: clamp(1.5rem, 4.4vw, 4.25rem);
    transform:
      translate3d(
        calc(var(--dx, 0) * var(--zug) * (1 - var(--q, 1))),
        calc(var(--dy, 0.55) * var(--zug) * (1 - var(--q, 1))),
        0
      )
      scale(calc(0.955 + 0.045 * var(--q, 1)));
  }

  /* Einspaltig gibt es keine linke und keine rechte Spalte. Damit der
     Reißverschluss-Gedanke trotzdem trägt, wechseln die Kacheln sich ab —
     dieselbe Bewegung, nur aus der Reihenfolge statt aus dem Raster.

     Ausdrücklich nur unterhalb von 64rem, wo das Raster eine Spalte hat.
     Ohne die Begrenzung schlüge diese Regel die Rasterwerte weiter unten:
     :nth-child zählt in der Spezifität wie eine zweite Klasse und gewinnt
     damit gegen .work__item--1, egal in welcher Reihenfolge beide stehen. */
  @media (max-width: 63.999rem) {
    .work__item:nth-child(odd) { --dx: -0.5; }
    .work__item:nth-child(even) { --dx: 0.5; }
  }

  .work__link { display: block; text-decoration: none; color: inherit; }

  /* Kein Hintergrund. Er stand hier als Platzhalter fürs Laden, mit 6 %
     Weiß — und war damit heller als der Abschnitt darunter. In den
     abgerundeten Ecken schneidet overflow: hidden das Bild nicht auf den
     letzten Pixel genau ab, und genau dort blitzte dieser helle
     Hintergrund als Bogen durch. Nachgestellt und im Vergleich bestätigt.

     Ein Platzhalter wird auch nicht gebraucht: Die Bilder tragen width und
     height, die Fläche steht also von Anfang an. */
  .work__figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    /* Die Maske ist der Grund, warum die Rundung beim Überfahren sauber
       bleibt.

       Das Bild wächst bei Hover um 3,5 Prozent. Für diese Bewegung legt
       der Browser es auf eine eigene Ebene, und der abgerundete Beschnitt
       des Kastens wird dann getrennt davon angewendet. In den Ecken passt
       beides nicht auf den Pixel zusammen — dort blitzte ein heller Saum
       auf, solange die Bewegung lief.

       Eine Maske zwingt den Kasten selbst auf eine Ebene, und der
       Beschnitt wird mit ihm zusammen gerastert. Beide Schreibweisen,
       weil die alte WebKit-Form dort greift, wo die neue noch nicht
       gilt. Der Inhalt der Maske ist gleichgültig — sie ist überall
       deckend; gebraucht wird nur der Weg, den sie erzwingt.

       Durchprobiert und am Bildschirm verglichen: isolation, overflow:
       clip und eine eigene Ebene am Kasten helfen alle nicht, die Maske
       schon. */
    -webkit-mask-image: -webkit-radial-gradient(#fff, #000);
    mask-image: linear-gradient(#000, #000);
  }

    /* border-radius: inherit an Bild und Verlauf.

       Ohne das beschneidet nur der Kasten, und zwar jede Ebene für sich.
       In der Rundung bleibt dabei ein Bruchteil eines Pixels frei, in dem
       der abdunkelnde Verlauf das Bild nicht mehr erwischt — dort kam es
       ungedimmt durch. Bei den drei Reels fiel das auf, weil ihre linke
       untere Ecke im Bild hell ist: Allianz 213, BVB 205, Street One 178
       von 255, während die Fotostrecken dort bei 8 bis 82 liegen.

       Mit eigener Rundung an beiden Ebenen fällt die Fuge weg. Am
       Bildschirm gegengeprüft, vorher und nachher. */
  .work__figure img {
    border-radius: inherit;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 16 / 9;
    transition: transform 600ms var(--ease-out);
  }

  .work__figure[data-format='4:3'] img { aspect-ratio: 4 / 3; }
  .work__figure[data-format='4:5'] img { aspect-ratio: 4 / 5; }
  .work__figure[data-format='9:16'] img { aspect-ratio: 9 / 16; }
  .work__figure[data-format='3:2'] img { aspect-ratio: 3 / 2; }

  .work__link:hover .work__figure img { transform: scale(1.035); }

  /* Lesbarkeitsverlauf unter den Kundennamen. Vorher trug der Schatten
     allein, und der zählt für den Kontrast nicht — er ist weich, keine
     deckende Fläche. Ohne Verlauf lagen drei von vier Namen unter der
     Grenze von 3.0 für große fette Schrift.

     ABGESCHWÄCHT IN ZWEI SCHRITTEN: 0.95/0.66 → 0.82/0.58 → 0.66/0.46
     Der Verlauf deckte unten praktisch in der Farbe des Abschnitts. Die
     Kachel ging dort ohne sichtbare Kante in den Hintergrund über, und
     die Bildzeile darunter wirkte dadurch verrutscht: Man sah nicht,
     worauf sie sich ausrichtet.

     Er beginnt weiterhin an der Unterkante und läuft von dort nach oben
     aus — ein ausgenommener Streifen ganz unten war der erste Versuch
     und sah wie ein Leuchtstreifen aus. Auch die Stufen bleiben, nur
     ihre Deckung sinkt; das hält die Kurve monoton.

     Nachgemessen an den untersten zwei Bildzeilen, Abschnitt ist
     rgb(4, 37, 44):

       Siemens   Bild ( 48,  50,  41)   0.82 → ( 12, 39, 43)   0.66 → (19, 41, 43)
       BVB       Bild (175, 164, 106)   0.82 → ( 35, 60, 55)   0.66 → (62, 80, 65)
       Allianz   Bild (185,  97, 107)   0.82 → ( 37, 48, 55)   0.66 → (66, 57, 65)

     Weiter herunter geht es, kostet aber an den drei Reels: Deren linke
     untere Bildecke ist hell — gemessen 213 (Allianz), 205 (BVB) und 178
     (Street One) von 255, während die Fotostrecken dort bei 8 bis 82
     liegen. Je schwächer der Verlauf, desto deutlicher kommt diese Ecke
     durch. Das ist das Bild und keine Fuge in der Rundung: Mit einer
     dunklen Fläche statt des Bildes bleibt die Ecke sauber,
     gegengeprüft am Bildschirm.

     Der Name bleibt weit über der Grenze. Nachgerechnet über alle sechs
     Kacheln auf dem Zeilenkasten der Schrift, 32px über der Unterkante:
     schlechtester Wert 7.94 (BVB) gegen 10.77 bei 0.82 und 13.45 zu
     Anfang. Schwelle ist 4.5. Selbst 0.49/0.35 läge mit 5.80 noch
     darüber — der Verlauf hält die Schrift, nicht umgekehrt. */
  .work__figure::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      0deg,
      rgba(4, 37, 44, 0.66) 0%,
      rgba(4, 37, 44, 0.46) 32%,
      rgba(4, 37, 44, 0) 60%
    );
  }

  .work__tag { z-index: 1; }

  .work__tag {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: clamp(1.25rem, 3vw, 2.25rem);
    line-height: 1;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.5);
  }

  /* Projektname links, Formate rechts. Der Kunde steht groß im Bild
     darüber. baseline statt center: Die Pillen sind kleiner gesetzt als
     der Titel, an der Mittelachse ausgerichtet stünden sie sichtbar zu
     hoch.

     Die Zeile schließt links und rechts mit dem Bild ab, ohne Einzug.
     Sie war zwischenzeitlich auf den Einzug von .work__tag gesetzt,
     damit Kundenname und Projektname auf einer Linie beginnen — das war
     nicht gewollt. Die Kachelkante ist der Bezug, nicht der Kundenname. */
  .work__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: var(--space-2);
    font-size: var(--fs-small);
  }

  .work__titel { font-weight: 600; }

  /* margin-left: auto drückt die Pillen an die rechte Kante der Kachel —
     dadurch stehen sie über alle sechs Kacheln hinweg bündig, obwohl die
     Titel unterschiedlich lang sind.

     Die Gruppe trägt das auto und nicht die einzelne Pille: Bei zwei
     Formaten säße sonst nur die erste rechts und die zweite hinge daran.
     Der Zeilenumbruch innerhalb der Gruppe ist erlaubt — bei schmalen
     Kacheln rutscht das zweite Format unter das erste, statt den Titel
     zu quetschen. */
  .work__formate {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.3rem;
    margin-left: auto;
  }

  .work__format {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    line-height: 1.6;
    white-space: nowrap;
    color: var(--on-dark-muted);
  }

  /* ── 5 · Disziplinen ──────────────────────────────────────────────────── */
  /* Bewusst dieselbe Sprache wie die Arbeiten darüber: Bild als Hauptfigur,
     der Name groß im Bild, eine schmale Zeile darunter, versetztes Raster.
     Ein Unterschied ist nötig — die Arbeiten liegen auf dunklem Grund und
     ihre Motive sind dunkel, hier stehen helle Motive auf Sand. Weiße
     Schrift braucht deshalb einen Verlauf unter sich. */
  .disziplinen {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .disziplin__link { display: block; text-decoration: none; color: inherit; }

  /* Kein Hintergrund — siehe .work__figure. Hier war der Platzhalter
     dunkel und der Abschnitt hell, der Bogen in der Rundung entsprechend
     dunkel statt hell. Dieselbe Ursache. */
  .disziplin__bild {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    /* Maske gegen den hellen Saum in der Rundung, sobald das Bild bei
       Hover wächst — ausführlich bei .work__figure in index.astro. */
    -webkit-mask-image: -webkit-radial-gradient(#fff, #000);
    mask-image: linear-gradient(#000, #000);
  }

  .disziplin__bild img {
    border-radius: inherit;
    display: block;
    width: 100%;
    /* Jede Disziplin in ihrem eigenen Format — kommt aus den Daten */
    aspect-ratio: var(--ratio);
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: transform 600ms var(--ease-out), filter var(--dur-slow) var(--ease-out);
  }

  .disziplin__link:hover .disziplin__bild img,
  .disziplin__link:focus-visible .disziplin__bild img {
    transform: scale(1.035);
    filter: grayscale(0) contrast(1);
  }

  /* Lesbarkeitsverlauf, auf den echten Motiven gemessen statt geschätzt:
     Bild im Cover-Zuschnitt samt Graustufenfilter im Canvas nachgebaut,
     Verlauf darüber, dann der schlechteste Wert auf den Zeilenkästen der
     Schrift. Nach dem Umbau auf zwei Spalten sind die rechten Kästen
     kleiner, die Schrift liegt über anderen Bildstellen und der Fuß von
     0.88 reichte nur noch für 4.36:1 bei Foto. Mit 0.92 sind es
     Foto 5.54, Idee & Konzept 7.87, Video 11.20 — wieder über der
     strengeren Schwelle von 4.5 und mit Reserve für andere Motive. */
  .disziplin__bild::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      0deg,
      rgba(4, 37, 44, 0.92) 0%,
      rgba(4, 37, 44, 0.58) 30%,
      rgba(4, 37, 44, 0) 55%
    );
  }

  .disziplin__marke {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    bottom: clamp(0.875rem, 2.5vw, 1.75rem);
    z-index: 1;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: clamp(1.75rem, 4.4vw, 3.25rem);
    line-height: 1;
    letter-spacing: var(--track-display);
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
  }

  /* Nur noch der Beschreibungstext. Rechts stand hier ein "Mehr erfahren"
     mit Pfeil — entfallen, weil es zu den Disziplinen keine Unterseiten
     mehr geben soll. Damit fällt auch die Flex-Zeile weg: Ein einzelner
     Absatz braucht keine zwei Enden. */
  .disziplin__zeile {
    margin-top: var(--space-2);
    max-width: 46ch;
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }


  /* ── 6 · Vorteile ─────────────────────────────────────────────────────── */
  .benefits__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .benefit { border-top: 1px solid var(--line); padding-top: var(--space-3); }

  .benefit__num {
    display: block;
    font-family: var(--font-editorial);
    font-style: italic;
    font-size: 1.25rem;
    color: var(--petrol);
    margin-bottom: var(--space-2);
  }

  .benefit__title {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-1);
    text-wrap: balance;
  }

  .benefit__text { color: var(--ink-muted); }

  /* ── 6 · Unser Kernteam ─────────────────────────────────────────────── */
  /* Der Abschnitt kappt waagerecht. Die Streublöcke darin fahren ihren Text
     beim Scrollen um 7rem zur Seite herein, und der rechte Block schiebt
     ihn dabei aus dem Container heraus. Ungekappt wuchs die Seite dadurch
     bei 1280px Fenster auf 1326px Scrollbreite — 46px waagerechtes Scrollen
     auf jeder Unterseite mit diesem Abschnitt.

     clip und nicht hidden: hidden macht aus dem Abschnitt einen
     Scrollcontainer, und da overflow-y sichtbar bleiben muss, würde der
     Browser daraus auto rechnen. clip kappt nur. Der Abschnitt läuft über
     die volle Fensterbreite, geschnitten wird also nichts, was man
     ohnehin sähe. */
  .team { overflow-x: clip; }

  /* Kopf ohne Fließtext — der steht jetzt als breiter Absatz unter den
     Porträts, deshalb hier weniger Abstand nach unten. */
  /* Der Team-Kopf steht enger, weil "UNSER TEAM" kurz ist und die
     Porträts direkt darunter die Fläche übernehmen. */
  .sec-head--knapp { margin-bottom: clamp(1.75rem, 4vw, 3rem); }

  /* Vier Porträts: zwei Spalten auf dem Handy, vier ab 48rem.

     Zwei Vorgaben stehen fest: Die Reihe liegt bündig an beiden Kanten,
     und die Gesichter sind gut ein Viertel kleiner als in voller Breite.
     Beides zusammen heißt zwangsläufig große Abstände — vier Bilder und
     drei Abstände teilen sich dieselbe Breite, was das eine verliert,
     gewinnt das andere. Bei 1310px Reihe sind das 220px Bild und 143px
     Abstand gegen 300px und 36px vorher.

     Der Versuch, den Überhang stattdessen nach außen zu legen (40px
     Abstand, 123px Einrückung je Seite), fiel durch: Die Reihe stand dann
     nicht mehr bündig.

     Ohne die großen Abstände ginge es nur über das Seitenverhältnis — bei
     voller Breite und 4:3 statt 1:1 fiele ein Viertel der Fläche weg, ohne
     dass sich ein Abstand ändert. Dafür fehlt Joscha: Seine Vorlage misst
     1086 × 1448, der quadratische Ausschnitt schöpft die Breite fast aus,
     und 4:3 bräuchte 1439px. */
  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .team__member { margin: 0; }

  /* Quadratisch statt 2:3. Vier hohe Porträts über die volle Breite waren
     rund 450px hoch und nahmen dem Abschnitt die Ruhe — die Gesichter
     sollen den Text und das Raster darunter einleiten, nicht mit ihnen
     konkurrieren. Im Quadrat sind es 220px.

     Graustufen, Farbe erst bei Hover. Die vier Aufnahmen stammen aus
     verschiedenen Situationen — Studio, Sofa, Loft — und haben jede einen
     eigenen Farbstich. Grau bindet sie zu einer Reihe; die Farbe kommt
     zurück, sobald jemand hinsieht. */
  .team__portrait {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-2);
    filter: grayscale(1);
    transition: filter var(--dur) var(--ease-out);
  }

  .team__member:hover .team__portrait,
  .team__member:focus-within .team__portrait { filter: grayscale(0); }

  /* Ohne Zeigegerät gäbe es die Farbe nie zu sehen — auf dem Handy stehen
     die Porträts deshalb von vornherein farbig. */
  @media (hover: none) {
    .team__portrait { filter: none; }
  }

  .team__name {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--on-dark);
  }

  /* balance, weil die Rollen Doppelnennungen sind und die längeren
     zwei Zeilen brauchen. Ohne die Angabe füllt die erste Zeile sich bis
     zum Rand und lässt ein einzelnes Wort darunter stehen — bei Cem
     stand "Director" allein auf 59px unter einer 258px langen Zeile.

     Die Schriftgröße hing zwischenzeitlich an der Kachelbreite (4.6cqi),
     damit die Rollen auf breiten Bildschirmen in eine Zeile passen. Das
     ist zurückgenommen: Sie steht wieder wie Name und Bildzeilen auf
     --fs-small. Wie viele Zeichen damit einzeilig bleiben, hängt an der
     Kachelbreite und steht in docs/bildmaterial.md. */
  .team__role {
    font-size: var(--fs-small);
    color: var(--on-dark-muted);
    text-wrap: balance;
  }

  /* Die beiden Streublöcke stehen mit Abstand untereinander und mit
     Abstand zu den Porträts darüber. Der Rest steckt in
     src/components/Streublock.astro.

     Der obere Abstand ist von 3,5/8vw/6rem auf 5,5/11vw/8rem erhöht. Das
     ist kein Geschmack, sondern Platzbedarf: Am Anfang der Animation
     stehen die Stücke auseinander, das oberste ragt dabei 98px über die
     Haufenfläche hinaus. Mit dem alten Abstand blieben nur 96px bis zur
     Porträtreihe — das obere Stück wäre beim Hereinscrollen kurz in die
     Gesichter gelaufen. Jetzt sind es 128px.

     Der Überstand lag zwischenzeitlich bei 105px und ist gesunken, weil
     die Haufenfläche seither auf die Bilder eingepasst wird: Der Streuweg
     rechnet sich aus der Lage zur Flächenmitte, und die sitzt in einer
     eng anliegenden Fläche näher an den Stücken. */
  .team__bloecke {
    display: grid;
    gap: clamp(4rem, 10vw, 8rem);
    margin-top: clamp(5.5rem, 11vw, 8rem);
  }

  /* ── 10 · FAQ ─────────────────────────────────────────────────────────── */
  .faq__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .faq__head .label { margin-bottom: var(--space-2); }

  .faq__item { border-top: 1px solid var(--line); }
  .faq__item:last-child { border-bottom: 1px solid var(--line); }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 56px;
    padding-block: var(--space-2);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker { display: none; }

  .faq__icon { position: relative; flex-shrink: 0; width: 20px; height: 20px; }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    background: var(--petrol);
    transition: transform var(--dur) var(--ease-out);
  }

  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }

  .faq__a {
    padding-bottom: var(--space-3);
    color: var(--ink-muted);
    max-width: 58ch;
  }

  /* ── 11 · Bottom-CTA ──────────────────────────────────────────────────── */
  .cta { text-align: center; }
  .cta__inner { display: grid; justify-items: center; gap: var(--space-3); }
  .cta__title { max-width: 16ch; }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  /* ── Breakpoints ──────────────────────────────────────────────────────── */
  @media (min-width: 48rem) {
    .statement__text { text-wrap: balance; }
    .benefits__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }

    /* Vier Quadrate über die volle Breite, bündig an beiden Kanten. Der
       Spaltenabstand setzt die Bildgröße:

         3 × 10,94 %              = 32,82 % für die Abstände
         (100 − 32,82) ÷ 4        = 16,80 % je Bild

       bei 1310px Reihe also 220px Bild und 143px Abstand — 27 Prozent
       weniger Kantenlänge als die 300px, die vier Bilder ohne Abstand
       ergäben. In Prozent, damit das Verhältnis bei jeder Fensterbreite
       steht; nur so bleibt die Reihe an beiden Kanten bündig.

       Nur hier und nicht an .team__grid: Auf dem Handy stehen zwei
       nebeneinander, dort wäre derselbe Wert eine Lücke. */
    .team__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 10.94%;
    }
    .hero__cue { display: inline-flex; }
  }

  @media (min-width: 64rem) {
    .work__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: clamp(3rem, 6vw, 5rem);
    }

    /* Drei Paare im Reißverschluss. Links steht immer die breitere
       Kachel, rechts die schmalere, und keine zwei teilen sich eine
       Kante oder eine Höhe. Die Reihenfolge der Projekte steht in
       src/data/arbeiten.ts, dort auch die Begründung der Gattungsfolge.

       Gemessen bei 1440px Fenster, Raster 1310px breit, Spalte 69.6,
       Spaltenabstand 43.2:

         Siemens     633 x 792   links    x    0 …  633    y    0 …  792
         Allianz     408 x 725   rechts   x  789 … 1197    y  140 …  865
         Revitive    746 x 497   links    x    0 …  746    y  894 … 1391
         Street One  408 x 725   rechts   x  902 … 1310    y  967 … 1692
         BVB         408 x 725   links    x    0 …  408    y 1493 … 2218
         Formel D    746 x 497   rechts   x  564 … 1310    y 1793 … 2291

       DIE GEWICHTE
       Siemens zu Allianz stand als Fläche bei 70 zu 30 und war damit zu
       kopflastig. Siemens ist deshalb von sieben auf sechs Spalten
       zurück, das ergibt 63 zu 37.

       Genauer geht es auf zwölf Spalten nicht: Die nächsten möglichen
       Kombinationen liegen bei 70/30 (Siemens sieben Spalten) und 59/41
       (Allianz fünf) — dazwischen gibt es keine Rasterbreite. 65/35
       bräuchte Siemens auf 6,4 Spalten.

       Revitive ist von acht auf sieben Spalten zurück, war als
       breiteste Kachel der Seite zu schwer. Street One von drei auf
       vier: Mit 295px stand es in einem schmalen Streifen am rechten
       Rand, jetzt sind es 408px.

       DIE LINKE UND DIE RECHTE SPALTE BERÜHREN SICH NIE
       Links endet spätestens bei 746, rechts beginnt frühestens bei
       564 — aber nie auf derselben Höhe. Dadurch sind die beiden
       Hälften vertikal frei gegeneinander verschiebbar, und genau das
       machen die negativen Ränder unten.

       ALLE DREI SENKRECHTEN FUGEN SIND GLEICH BREIT
       Zwischen Siemens und Allianz, zwischen Revitive und Street One,
       zwischen BVB und Formel D: je 156px, also genau eine Spalte plus
       ihre beiden Abstände. Das ist die einzige Größe, die sich in der
       Anordnung wiederholt, und sie ist der Grund, warum die drei Paare
       trotz sechs verschiedener Höhen zusammengehören.

       DIE VERSÄTZE
       Der Zeilenabstand von 80px plus die Bildunterschrift von 42px
       stapeln sich sonst zu Löchern zwischen den Paaren. Jede Kachel
       wird deshalb einzeln gesetzt, bezogen auf die Kachel, die sie
       tatsächlich blockiert — nicht auf die ganze Zeile. Zwischen einer
       Bildzeile und der nächsten Kachel darunter stehen dadurch überall
       110px.

       Der Wert lag zwischenzeitlich bei 60px, und das war zu eng. Er
       war nicht gewählt, sondern übrig: Street One ist von drei auf
       vier Spalten gewachsen und damit 200px höher, und die rechte
       Spalte hatte danach keine Luft mehr zu verteilen. Vorher standen
       dort 237px zwischen Allianz und Street One und 164px zwischen
       Street One und Formel D.

       Die 110px kommen jetzt aus dem einzigen freien Maß, das der
       Aufbau noch hat: Formel D darf nach unten wandern. Damit liegt
       der Abschnitt bei 2433px und damit fast genau auf der Höhe von
       vorher (2475px), obwohl alle Kacheln kleiner geworden sind.

       Flächendeckung 66,9 Prozent, nachgemessen auch bei 1024 und
       1920px Fensterbreite. Der engste Abstand liegt dort bei 82px.

       Die Reihen entstehen von selbst — Astro setzt die Kacheln der
       Reihe nach, und wo sich Spalten überschneiden, rutscht die
       nächste eine Reihe tiefer. Kein grid-row, das würde brechen,
       sobald ein Projekt dazukommt. */
    .work__item--1 { grid-column: 1 / span 6; }                   /* Siemens 4:5 */
    .work__item--2 { grid-column: 8 / span 4; }                   /* Allianz 9:16 */

    .work__item--3 { grid-column: 1 / span 7; }                   /* Revitive 3:2 */
    .work__item--4 { grid-column: 9 / span 4; }                   /* Street One 9:16 */

    .work__item--5 { grid-column: 1 / span 4; }                   /* BVB 9:16 */
    .work__item--6 { grid-column: 6 / span 7; }                   /* Formel D 3:2 */

    /* Der Weg jeder Kachel, siehe .work__item.is-aktiv weiter oben:

         Mitte der Kachel − 6,5        Spalten 1…12, Mitte also 6,5
         ─────────────────────         geteilt durch die halbe Breite
                  6

       Siemens sitzt auf 3,5 und läuft damit eine halbe Einheit nach links,
       Street One auf 10,5 und zwei Drittel nach rechts. Die drei Paare
       ergeben −0,50/+0,50, −0,42/+0,67 und −0,67/+0,42: Jedes Paar zieht
       gegeneinander, und die Beträge sind ungleich, weil die Kacheln es
       auch sind. Gleiche Beträge sähen nach Mechanik aus. */
    .work__item--1 { --dx: -0.50; }
    .work__item--2 { --dx:  0.50; }
    .work__item--3 { --dx: -0.42; }
    .work__item--4 { --dx:  0.67; }
    .work__item--5 { --dx: -0.67; }
    .work__item--6 { --dx:  0.42; }

    /* Die Versätze. margin-top und nicht transform — die Kacheln sollen
       den Platz, den sie einnehmen, auch beanspruchen, sonst liefe die
       Kachel darunter in sie hinein.

       Alles in vw gerechnet, damit die Versätze mit den Kachelhöhen
       mitwachsen: die sind über aspect-ratio ebenfalls an die Breite
       gekoppelt. */
    .work__item--2 { margin-top: clamp(3rem, 9.7vw, 8.75rem); }
    .work__item--3 { margin-top: calc(-1 * clamp(1rem, 3vw, 3rem)); }
    .work__item--4 { margin-top: clamp(0.75rem, 2.08vw, 2rem); }
    .work__item--5 { margin-top: calc(-1 * clamp(5rem, 18.8vw, 17rem)); }
    .work__item--6 { margin-top: clamp(0.75rem, 2.08vw, 2rem); }

    /* Video links, Konzept und Foto rechts — aber nichts fluchtet.

       Der Aufbau ist derselbe wie zu Anfang. Ordentlich sah er nicht
       deshalb aus, sondern weil alles bündig abschloss: Konzept und Foto
       exakt gleich breit, exakt übereinander, linke wie rechte Kanten auf
       einer Linie, und Videos Unterkante genau auf der von Foto.

       Jetzt liegt keine Kante auf einer anderen:

         Video    641 × 801   513k   links,  x   0 …  641
         Foto     641 × 427   274k   rechts, x 684 … 1325
         Konzept  527 × 351   185k   rechts, x 798 … 1325

       Drei verschiedene linke Kanten, drei verschiedene Höhen, drei
       verschiedene Unterkanten. Konzept ist schmaler als Foto und rückt
       von links ein, ragt also nicht mit ihm gleich weit.

       Die rechte Kante teilen sich Konzept und Foto. Das ist Absicht: Ein
       einziger durchgehender Strich hält das Feld zusammen, während alles
       andere versetzt liegt — dieselbe Regel wie bei Featured Work. Alle
       drei ohne jede gemeinsame Kante zerfielen in Einzelteile.

       Die Abstände sind bewusst knapp. Eine frühere Fassung setzte Foto
       100px unter die Zeile und Konzept 50px unter Video; zwischen den
       Kacheln stand dadurch mehr Leere als Bild.

       Dazu drei verschiedene Höhen: Konzept setzt tiefer an als Video,
       Foto noch einmal tiefer als die Zeile es verlangt. Die Versätze
       gehen ausschließlich nach unten — ein Zug nach oben hatte in einem
       früheren Anlauf den Text der Kachel darüber verdeckt.

       Video steht über beide Zeilen, füllt sie aber nicht mehr aus: Mit
       align-self: start behält es sein eigenes 4:5 aus den Daten und endet
       deutlich über dem unteren Rand des Abschnitts, statt mit Foto
       abzuschließen. Genau diese Bündigkeit war vorher das Ordentlichste
       am ganzen Feld. */
    .disziplinen {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: clamp(2rem, 4vw, 3rem);
    }

    .disziplin--1 { grid-column: 1 / span 6; grid-row: 1 / span 2; align-self: start; }
    .disziplin--2 { grid-column: 8 / span 5; grid-row: 1; }
    .disziplin--3 { grid-column: 7 / span 6; grid-row: 2; }

    .disziplin--2 { margin-top: clamp(0.75rem, 1.8vw, 1.75rem); }
    .disziplin--3 { margin-top: clamp(0.5rem, 1.2vw, 1.25rem); }

    /* Ab hier drei Spalten wie in der Referenz. Darunter zwei, damit die
       Bilder auf dem Handy nicht zu Briefmarken werden. */

    .faq__grid { grid-template-columns: 0.8fr 1.2fr; gap: clamp(3rem, 6vw, 6rem); }
    .faq__head { position: sticky; top: 7rem; }
  }

  /* ── Reduced Motion ───────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    /* Ohne Laufband bliebe ein Großteil der Logos unsichtbar. Statt den
       Streifen zu stauchen, wird er von Hand scrollbar. */
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__track { animation-name: none; }
    .marquee__track [aria-hidden='true'] { display: none; }
    .hero__cue { animation-name: none; }
  }
</style>

<script>
  // Die Kacheln in "Featured Work" laufen beim Scrollen auf ihren Platz zu.
  //
  // Dieselbe Rechnung wie die Streublöcke weiter unten, aus einem Modul:
  // gleiche Zeitkonstante, gleicher Nachlauf, gleiches Verhalten beim
  // Verlassen des Fensters. Nur der Weg unterscheidet sich, und der steht
  // im CSS bei --dx.
  //
  // Je Kachel und nicht je Abschnitt: Der Abschnitt ist 2433px hoch. Ein
  // gemeinsamer Wert hieße, dass die unteren Kacheln längst stehen, bevor
  // sie jemand sieht. Der Haufen ist ein kompakter Block und kommt deshalb
  // mit einem Wert aus.
  import { nachlaufBinden } from '../scripts/nachlauf';

  nachlaufBinden(document.querySelectorAll<HTMLElement>('.work__item'));
</script>

<script>
  // Ein Video lässt sich per CSS nicht anhalten. Wer reduzierte Bewegung
  // angefordert hat, bekommt deshalb ein Standbild statt der Schleife.
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;

  if (heroVideo) {
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');

    const anwenden = () => {
      if (ruhig.matches) {
        heroVideo.removeAttribute('autoplay');
        heroVideo.loop = false;
        heroVideo.pause();
      } else {
        heroVideo.loop = true;
        // play() kann abgelehnt werden, etwa im Energiesparmodus —
        // dann bleibt schlicht das erste Bild stehen.
        void heroVideo.play().catch(() => {});
      }
    };

    anwenden();
    ruhig.addEventListener('change', anwenden);
  }
</script>
