---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import { withBase } from '../lib/paths';

// Der Dateiname des Bühnenvideos ist bewusst neutral gehalten: Er steht im
// Quelltext jeder Seite, und laut Markenarchitektur wird die Schwestermarke
// ausschließlich im Impressum genannt. Details in docs/bildmaterial.md.

// Die Kundenlogos liegen als ein durchgehender Streifen vor. Für die
// Endlosschleife läuft er zweimal hintereinander; der Track wandert um
// exakt eine Streifenbreite, dadurch ist der Übergang nahtlos.
const kundenlogos =
  'Henkell Freixenet, ServiceNow, Douglas, Seven.One Entertainment Group, ' +
  'Hugo Boss, Deutsche Welle, Shop Apotheke Europe, Street One, Siemens, ' +
  'Zehnder Group, North Kiteboarding';

// Tags spiegeln die Disziplinen-Rangfolge: Video zuerst, vertikal als Kern.
// ratio steuert den Bildbeschnitt, formats zeigt, welche Formate aus
// derselben Produktion entstanden sind — das ist der Kern der Positionierung
// ("Format-Vielfalt aus einem Auftrag"), deshalb zwei getrennte Felder.
const works = [
  { img: '/images/work-01.jpg', w: 1600, h: 900,  tag: 'Social Video', title: 'Zwischen den Schichten', client: 'Nordlicht',  ratio: '16:9', formats: '9:16 · 16:9', alt: 'Filmklappe wird vor der Kamera bei einem Außendreh geschlossen' },
  { img: '/images/work-02.jpg', w: 1600, h: 900,  tag: 'Kampagne',     title: 'Alles auf Anfang',       client: 'Atlas & Co', ratio: '16:9', formats: '9:16 · 4:5',  alt: 'Schnittplatz mit Videospur und Timeline auf mehreren Monitoren' },
  { img: '/images/work-03.jpg', w: 900,  h: 1600, tag: 'Vertikal',     title: 'Neun zu Sechzehn',       client: 'Superbloom', ratio: '9:16', formats: '9:16',        alt: 'Filmset mit Kamera auf Dolly und farbigem Licht, vertikal gedreht' },
  { img: '/images/work-04.jpg', w: 1600, h: 900,  tag: 'Fotografie',   title: 'Haus voller Licht',      client: 'Hafen',      ratio: '3:2',  formats: '3:2 · 4:5',   alt: 'Abgedunkelter Kinosaal mit rot beleuchteten Sitzreihen' },
];

// Auf der Startseite erscheinen nur die drei Produktionsdisziplinen.
// Workshops bleiben über Menü, Footer und /services erreichbar.
const disziplinen = services.filter((s) => s.disziplin);

// PLATZHALTER — echte Porträts, Namen und Rollen einsetzen. Die Bilder
// stammen von Unsplash und zeigen nicht das Team.
const team = [
  { img: '/images/team-01.jpg', name: 'Name folgt', role: 'Rolle folgt', alt: 'Platzhalter-Porträt' },
  { img: '/images/team-02.jpg', name: 'Name folgt', role: 'Rolle folgt', alt: 'Platzhalter-Porträt' },
  { img: '/images/team-03.jpg', name: 'Name folgt', role: 'Rolle folgt', alt: 'Platzhalter-Porträt' },
  { img: '/images/team-04.jpg', name: 'Name folgt', role: 'Rolle folgt', alt: 'Platzhalter-Porträt' },
];

// q darf Markup enthalten (Wortmarke), wird unten mit set:html gerendert.
// Die Fragen 2, 6 und 7 tragen die drei Punkte aus "Was wir nicht machen" —
// im FAQ statt in einer eigenen Sektion, weil eine Abgrenzung als Antwort
// auf eine echte Frage überzeugt und als Aufzählung nur abweist.
const faqs = [
  { q: 'Was kostet eine Produktion bei <span class="brand">Le Werk</span>?', a: 'Das hängt an Drehtagen, Team und Formatumfang. Kompakte Social-Produktionen starten im mittleren vierstelligen Bereich, größere Kampagnen liegen fünfstellig. Nach einem 20-minütigen Gespräch bekommt ihr eine belastbare Spanne — kein Zahlenraten.' },
  { q: 'Macht ihr auch UGC- oder Handy-Content?', a: 'Nein. Das ist ein anderer Markt mit anderen Preisen und anderem Anspruch. Bei uns entstehen Visuals auf Kampagnenniveau — auch dann, wenn sie am Ende vertikal im Feed laufen. Wer schnellen, günstigen Durchsatz sucht, ist bei uns falsch.' },
  { q: 'Bekommen wir Foto und Video aus einer Produktion?', a: 'Ja, das ist der Kern unserer Arbeitsweise. Wir planen Sets so, dass bewegte und stehende Bilder parallel entstehen. Das spart einen kompletten Produktionstag und sorgt dafür, dass Foto und Video wie eine Kampagne aussehen — nicht wie zwei.' },
  { q: 'Warum denkt ihr vom vertikalen Format aus?', a: 'Weil dort die Aufmerksamkeit liegt. Ein Bildaufbau, der als 16:9 entsteht und später hochkant beschnitten wird, verliert immer — Blickführung, Text und Rhythmus stimmen dann nicht mehr. Wir planen umgekehrt: vertikal als Kern, Landscape und Stills als Ableitung derselben Produktion.' },
  { q: 'Wie lange dauert es von der Anfrage bis zum fertigen Material?', a: 'Für eine kompakte Produktion rechnet mit drei bis vier Wochen: eine Woche Konzept, ein bis zwei Drehtage, ein bis zwei Wochen Post. Bei laufenden Content-Paketen verkürzt sich das deutlich, weil Setup und Look bereits stehen.' },
  { q: 'Produziert ihr auch klassische Werbefilm-Kampagnen in 16:9?', a: 'Als Hauptformat nicht — die cinematische 16:9-Kampagne ist nicht unsere Disziplin, und wir tun nicht so, als wäre sie es. Landscape bekommt ihr bei uns als Ableitung aus einer Content-Produktion. Wenn euer Vorhaben in Wahrheit ein Werbefilm ist, sagen wir das offen und nennen euch die passende Adresse.' },
  { q: 'Übernehmt ihr Mediaplanung, SEO oder SEA?', a: 'Nein, wir sind kein Full-Service-Betrieb. Keine Media-Buchung, kein Suchmaschinen-Marketing, keine Account-Ebene zwischen euch und der Produktion. Wir liefern die Visuals und arbeiten dabei problemlos mit eurer Agentur oder eurem Marketing-Team zusammen.' },
  { q: 'Arbeitet ihr nur in Köln?', a: 'Das Studio liegt im Rheinauhafen, der Verkaufsschwerpunkt ist Köln und NRW — gedreht wird da, wo euer Thema ist. Based in Köln, booked worldwide: bundesweite Produktionen sind Alltag, internationale Drehs gehen ebenfalls.' },
  { q: 'Wie ist das mit den Nutzungsrechten?', a: 'Ihr erhaltet standardmäßig zeitlich und räumlich unbegrenzte Nutzungsrechte für alle eigenen Kanäle. Für Paid Media, Out-of-Home oder TV klären wir Buyouts vorab transparent im Angebot — keine Nachforderungen.' },
  { q: 'Was bieten eure Workshops?', a: 'Drei Formate: Auftreten und Sprechen vor der Kamera, ein Social-Media-Basistraining zu Formatlogik und Bildsprache sowie Teambuilding und interne Kommunikation über Improtheater-Training. Umfang, Dauer und Teilnehmerzahl stimmen wir auf euer Team ab.' },
];
---

<BaseLayout
  title="Le Werk — Visual Content Studio für Video und Fotografie"
  description="Le Werk ist ein Visual Content Studio in Köln: Video und Fotografie auf Kampagnenniveau, vom vertikalen Format aus gedacht. Handwerk mit redaktioneller Substanz — kein UGC, kein Full-Service-Overhead."
  heroDark={true}
>
  <!-- ═══ 1 · HERO ═══════════════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <!-- muted und playsinline sind Bedingung dafür, dass mobile Browser
           überhaupt selbst starten. Die Datei hat keine Tonspur.
           Bei prefers-reduced-motion hält ein Skript das Video an. -->
      <video
        id="hero-video"
        autoplay muted loop playsinline
        preload="auto"
        aria-hidden="true"
        tabindex="-1"
      >
        <source src={withBase('/videos/lewerk-hero.mp4')} type="video/mp4" />
      </video>
    </div>

    <!-- Text sitzt in der unteren linken Ecke und läuft bewusst nicht über
         die ganze Breite. Randabstand = --edge, damit er mit dem Logo im
         Header auf einer Achse liegt. -->
    <div class="hero__inner">
      <h1 class="hero__statement" id="hero-title" lang="en">
        <span class="brand">Le Werk</span> is a visual content studio crafting
        brand content <em>worth watching.</em>
      </h1>
    </div>

    <a class="hero__cue" href="#positionierung" aria-label="Weiter zum Inhalt scrollen">
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- ═══ 2 · POSITIONIERUNG ═════════════════════════════════════════════ -->
  <section class="section statement" id="positionierung" aria-labelledby="statement-title">
    <div class="container statement__inner">
      <!-- Bewusst kein deutscher Claim: Laut Positionierung trägt der
           englische Positions-Satz im Hero diese Rolle, ein Manifest-Satz
           auf Deutsch steht noch aus. Dieser Absatz erklärt die Position,
           er behauptet sie nicht als Slogan. -->
      <p class="statement__text" id="statement-title" data-reveal>
        Gegründet von Filmemachern. <span class="brand">Le Werk</span> ist ein
        Visual Content Studio im Kölner Rheinauhafen, spezialisiert auf
        Storytelling, Film und Foto für Social und Branded Content.
      </p>
      <p class="statement__meta" data-reveal data-reveal-delay="80">
        Konzept · Produktion · Postproduktion · Based in Köln, Booked Worldwide
      </p>
    </div>
  </section>

  <!-- ═══ 3 · ARBEITEN ═══════════════════════════════════════════════════ -->
  <section class="section section--dark work" id="arbeiten" aria-labelledby="work-title">
    <div class="container">
      <header class="work__head" data-reveal>
        <h2 class="headline headline--xl" id="work-title">
          <span class="editorial editorial--kicker">Ausgewählte</span>
          Arbeiten
        </h2>
        <p class="lead">
          Ein Auszug aus laufenden und abgeschlossenen Produktionen. Gedacht wird
          vom vertikalen Format aus — Landscape und Stills entstehen als
          Ableitung, nicht umgekehrt. Ein Dreh, mehrere Formate.
        </p>
      </header>

      <div class="work__grid">
        {works.map((w, i) => (
          <article class={`work__item work__item--${i + 1}`} data-reveal data-reveal-delay={i * 80}>
            <a class="work__link" href={withBase("/services")}>
              <figure class="work__figure" data-format={w.ratio}>
                <img src={withBase(w.img)} alt={w.alt} width={w.w} height={w.h} loading="lazy" decoding="async" />
                <figcaption class="work__tag">{w.tag}</figcaption>
              </figure>
              <p class="work__caption">
                <span class="work__title">{w.title}</span>
                <span class="work__client">— {w.client}</span>
                <span class="work__format">{w.formats}</span>
              </p>
            </a>
          </article>
        ))}
      </div>

      <p class="work__more" data-reveal>
        <a class="link-underline" href={withBase("/services")}>
          Alle Leistungen ansehen <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- ═══ 4 · TRUSTBAR (Logo-Marquee) ════════════════════════════════════ -->
  <section class="section section--tight trust" id="trust" aria-label="Auswahl unserer Kunden">
    <div class="container">
      <p class="label trust__label">Vertrauen auf <span class="brand">Le Werk</span></p>
    </div>

    <div class="marquee">
      <div class="marquee__track">
        <img
          class="marquee__strip"
          src={withBase('/images/logokarusell.png')}
          alt={`Kundenlogos: ${kundenlogos}`}
          width="5000" height="400" loading="lazy" decoding="async"
        />
        <!-- zweite Kopie nur für die Schleife, für Screenreader unsichtbar -->
        <img
          class="marquee__strip"
          src={withBase('/images/logokarusell.png')}
          alt="" aria-hidden="true"
          width="5000" height="400" loading="lazy" decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ═══ 5 · LEISTUNGEN ═════════════════════════════════════════════════ -->
  <section class="section section--sand services" aria-labelledby="services-title">
    <div class="container">
      <header class="sec-head" data-reveal>
        <p class="label">Was wir machen</p>
        <h2 class="headline" id="services-title">
          <span class="editorial editorial--kicker">Drei Disziplinen,</span>
          eine Handschrift
        </h2>
        <p class="lead">
          Video ist die Hauptdisziplin, Fotografie die klare Zweite, Konzept
          läuft vorgeschaltet — bei Bedarf mit Content-Strategie, nie als
          Selbstzweck.
        </p>
      </header>

      <!-- Nur die drei Produktionsdisziplinen. Workshops sind bewusst nicht
           auf der Startseite und ausschließlich über das Menü erreichbar. -->
      <ul class="services__grid">
        {disziplinen.map((s, i) => (
          <li class="service" data-reveal data-reveal-delay={i * 70}>
            <a class="service__link" href={withBase(s.href)}>
              <span class="service__media">
                <img src={withBase(s.img)} alt="" width="1200" height="900" loading="lazy" decoding="async" />
              </span>
              <span class="service__body">
                <span class="service__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="service__title">{s.label}</span>
                <span class="service__text">{s.text}</span>
                <span class="service__cta" aria-hidden="true">Mehr erfahren →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ 6 · UNSER TEAM ═════════════════════════════════════════════════ -->
  <section class="section section--dark team" aria-labelledby="team-title">
    <div class="container">
      <header class="sec-head" data-reveal>
        <p class="label">Wer dahintersteht</p>
        <h2 class="headline" id="team-title">
          <span class="editorial editorial--kicker">Unser</span>
          Team
        </h2>
        <p class="lead">
          Ein Team, das produziert — keine Account-Ebene, keine Weitergabe an
          Dritte. Die Leute, mit denen ihr das Konzept besprecht, stehen später
          auch am Set und sitzen im Schnitt.
        </p>
      </header>

      <ul class="team__grid">
        {team.map((m, i) => (
          <li class="team__member" data-reveal data-reveal-delay={i * 70}>
            <img
              class="team__portrait"
              src={withBase(m.img)} alt={m.alt}
              width="800" height="1200" loading="lazy" decoding="async"
            />
            <p class="team__name">{m.name}</p>
            <p class="team__role">{m.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ 7 · DREI GRÜNDE ════════════════════════════════════════════════ -->
  <section class="section benefits" aria-labelledby="benefits-title">
    <div class="container">
      <header class="sec-head" data-reveal>
        <p class="label">Warum <span class="brand">Le Werk</span></p>
        <h2 class="headline" id="benefits-title">
          <span class="editorial editorial--kicker">Drei Gründe,</span>
          uns anzurufen
        </h2>
      </header>

      <ol class="benefits__list">
        <li class="benefit" data-reveal>
          <span class="benefit__num" aria-hidden="true">01</span>
          <h3 class="benefit__title">Handwerk auf Kampagnenniveau</h3>
          <p class="benefit__text">
            Hochwertig produzierte Visuals in Bild und Bewegtbild — mit den
            Maßstäben an Licht, Bildgestaltung und Post, die eine Kampagne
            verlangt. Kein Handy-Standard, kein UGC-Look.
          </p>
        </li>
        <li class="benefit" data-reveal data-reveal-delay="80">
          <span class="benefit__num" aria-hidden="true">02</span>
          <h3 class="benefit__title">Substanz statt Strohfeuer</h3>
          <p class="benefit__text">
            Redaktionelle Tiefe, ehrlich erzählte Geschichten, menschliche
            Momente — interviewbasiert und dokumentarisch, mit Blick für
            Charaktere. Kein Content, der schnell knallt und genauso schnell
            wieder weg ist.
          </p>
        </li>
        <li class="benefit" data-reveal data-reveal-delay="160">
          <span class="benefit__num" aria-hidden="true">03</span>
          <h3 class="benefit__title">Format-Vielfalt aus einem Auftrag</h3>
          <p class="benefit__text">
            Vertikal ist bei uns kein Beschnitt am Ende, sondern der
            Ausgangspunkt der Planung. Landscape, Square und Stills entstehen
            als Ableitung derselben Produktion — nicht als zweiter Dreh.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═══ 8 · FAQ ═══════════════════════════════════════════════════════ -->
  <!-- Beige statt Weiß: Vorher grenzten zwei weiße Flächen aneinander und
       der Abschnittswechsel war nicht zu erkennen. -->
  <section class="section section--sand faq" aria-labelledby="faq-title">
    <div class="container faq__grid">
      <header class="faq__head" data-reveal>
        <p class="label">Häufige Fragen</p>
        <h2 class="headline" id="faq-title">Kurz beantwortet</h2>
      </header>

      <div class="faq__list" data-reveal data-reveal-delay="80">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span set:html={f.q} />
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq__a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 9 · BOTTOM-CTA ════════════════════════════════════════════════ -->
  <section class="section section--dark cta" aria-labelledby="cta-title">
    <div class="container cta__inner" data-reveal>
      <h2 class="headline headline--xl cta__title" id="cta-title">
        <span class="editorial editorial--kicker">Erzählt uns</span>
        von eurem Projekt
      </h2>
      <div class="cta__actions">
        <a class="btn btn--on-dark" href={withBase("/kontakt")}>
          Projekt anfragen <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="mailto:contact@lewerk.de">contact@lewerk.de</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Gemeinsamer Sektionskopf ─────────────────────────────────────────── */
  .sec-head {
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .sec-head .label { margin-bottom: var(--space-2); }

  /* ── 1 · Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: clamp(8rem, 18vh, 12rem) clamp(4rem, 10vh, 7rem);
    background: var(--petrol-deep);
    color: var(--on-dark);
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: 0; z-index: 0; }

  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Bewusst ohne Graustufen-/Blend-Filter: Auf einem formatfüllenden
       Video kosten die richtig Rechenzeit, und das Material ist von sich
       aus dunkel und petrolstichig. Es bleibt beim Abdunkeln. */
    filter: brightness(0.82) contrast(1.04);
  }

  .hero__media::after { content: ''; position: absolute; inset: 0; }

  /* Lesbarkeitsverlauf in neutralem Schwarz statt in Petrol: Ein farbiger
     Verlauf legt sich als Stich über das ganze Material und verfälscht die
     Farben der Aufnahme. Schwarz dunkelt ab, ohne einzufärben.
     Die Werte sind über mehrere Videoframes gemessen, nicht geschätzt. */
  .hero__media::after {
    background:
      linear-gradient(0deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.5) 28%, rgba(0, 0, 0, 0.08) 55%, rgba(0, 0, 0, 0.4) 100%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0.22) 45%, rgba(0, 0, 0, 0) 70%);
  }

  /* Randabstand wie im Header, damit Text und Logo auf einer Achse sitzen */
  .hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: var(--edge);
  }

  /* Rollentrennung wie im Rest der Seite: Die Wortmarke bleibt Poppins
     ExtraBold (Klasse .brand, unverändert), der Satz selbst ist Redaktion
     und damit Bodoni. Der kursive Schluss trägt die Behauptung. */
  .hero__statement {
    max-width: 30ch;
    font-family: var(--font-editorial);
    font-weight: 400;
    font-size: clamp(1.625rem, 3.4vw, 3.125rem);
    line-height: 1.14;
    letter-spacing: -0.005em;
    color: var(--on-dark);
    text-wrap: pretty;
  }

  .hero__statement em { font-style: italic; }


  .hero__cue {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 6vh, 3.5rem);
    z-index: 1;
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    animation: cue 2.4s var(--ease-out) infinite;
  }

  @keyframes cue {
    0%, 100% { transform: translateY(0); opacity: 0.75; }
    50%      { transform: translateY(6px); opacity: 1; }
  }

  /* ── 2 · Trustbar ─────────────────────────────────────────────────────── */
  /* Der Logostreifen hat oben und unten eigenen Rand — deshalb hier
     weniger Abstand, sonst reißt die Sektion auseinander. */
  .trust__label { margin-bottom: 0; }
  .trust .marquee { margin-block: calc(var(--space-2) * -1); }

  .marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    align-items: center;
    /* muss 0 bleiben: Der Track wandert um 50 % seiner Breite. Ein Abstand
       zwischen den beiden Kopien würde diese Rechnung verschieben und die
       Schleife sichtbar springen lassen. Der Streifen bringt seinen
       Randabstand selbst mit. */
    gap: 0;
    width: max-content;
    animation: marquee 40s linear infinite;
    will-change: transform;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track { animation-play-state: paused; }

  @keyframes marquee {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  /* Höhe steuert die Größe, die Breite folgt dem Seitenverhältnis 12,5:1.
     Die Logos sitzen mit Luft im Streifen, deshalb ist er höher als die
     Logos selbst wirken. */
  .marquee__strip {
    height: clamp(80px, 9vw, 128px);
    width: auto;
    max-width: none;
    opacity: 0.72;
    transition: opacity var(--dur) var(--ease-out);
  }

  .marquee:hover .marquee__strip { opacity: 1; }

  /* ── 2 · Positionierung ───────────────────────────────────────────────── */
  .statement { padding-block: clamp(4.5rem, 10vw, 8.5rem); }

  .statement__inner { text-align: center; }

  /* Rollentrennung wie im Hero: Wortmarke Poppins ExtraBold (.brand),
     der Satz selbst Bodoni, der kursive Schluss trägt die Behauptung. */
  /* Der Text ist ein Vorstellungssatz, keine Schlagzeile — bei 4rem und
     28ch stand er als sechszeilige Wand da. Kleiner und breiter gesetzt
     liest er sich als redaktionelle Einleitung: ab 38ch sind es vier
     Zeilen, darunter fünf. */
  .statement__text {
    margin-inline: auto;
    max-width: 38ch;
    font-family: var(--font-editorial);
