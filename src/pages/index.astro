</style>

<script>
  // Ein Video lässt sich per CSS nicht anhalten. Wer reduzierte Bewegung
  // angefordert hat, bekommt deshalb ein Standbild statt der Schleife.
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;

  if (heroVideo) {
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');

    const anwenden = () => {
      if (ruhig.matches) {
        heroVideo.removeAttribute('autoplay');
        heroVideo.loop = false;
        heroVideo.pause();
      } else {
        heroVideo.loop = true;
        // play() kann abgelehnt werden, etwa im Energiesparmodus —
        // dann bleibt schlicht das erste Bild stehen.
        void heroVideo.play().catch(() => {});
      }
    };

    anwenden();
    ruhig.addEventListener('change', anwenden);
  }
</script>
